fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END = '/checkout'))) OR u0 IS NOT NULL),
