x1 AS (SELECT sid, t, ty, k, CASE WHEN ty = 'view' AND k = '/shop' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'add-to-cart' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'view' AND k = '/checkout' THEN 1 ELSE 0 END AS m3, CASE WHEN ty = 'action' AND k = 'place-order' THEN 1 ELSE 0 END AS m4, CAST(NULL AS VARCHAR) AS uid, ts FROM x0),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1, m4 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, SUM(m4) AS seen4, MIN(CASE WHEN m1 = 1 THEN ts END) AS entry_ts FROM x1 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, CASE WHEN f[4] IS NOT NULL THEN 1 ELSE 0 END AS r4, f[2] AS d2, f[3] AS d3, f[4] AS d4, seen1, seen2, seen3, seen4, entry_ts FROM s)
SELECT CASE WHEN entry_ts < 1791504000000000 THEN 0 WHEN entry_ts < 1791590400000000 THEN 1 ELSE 2 END AS bk, SUM(r1) AS ca, SUM(r4) AS cb FROM ps WHERE r1 = 1 GROUP BY bk ORDER BY bk LIMIT 3"
`;

exports[`funnelTrendSql (P0-9) > Users in the same session enter at their earliest session that reached step a 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, first_value(NULLIF(usr_email, '') ORDER BY CASE WHEN NULLIF(usr_email, '') IS NULL THEN 1 ELSE 0 END, date) AS u0, MIN(CASE WHEN NULLIF(usr_email, '') IS NOT NULL THEN date END) AS ut, MIN(view_name) AS vn, MIN(_timestamp) AS ts FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'add-to-cart') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'place-order') OR NULLIF(usr_email, '') IS NOT NULL) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
