x2 AS (SELECT sid, t, ty, k, m1, m2, m3, m4, uid, ts FROM x1 WHERE m1 = 1 OR m2 = 1 OR m3 = 1 OR m4 = 1),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1, m4 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, SUM(m4) AS seen4, MIN(CASE WHEN m2 = 1 THEN ts END) AS entry_ts FROM x2 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, CASE WHEN f[4] IS NOT NULL THEN 1 ELSE 0 END AS r4, f[2] AS d2, f[3] AS d3, f[4] AS d4, seen1, seen2, seen3, seen4, entry_ts FROM s),
pu AS (SELECT CASE WHEN uid IS NULL THEN 1 ELSE 0 END AS anon, MAX(r1) AS r1, MAX(r2) AS r2, MAX(r3) AS r3, MAX(r4) AS r4, MIN(d2) AS d2, MIN(d3) AS d3, MIN(d4) AS d4, SUM(seen1) AS seen1, SUM(seen2) AS seen2, SUM(seen3) AS seen3, SUM(seen4) AS seen4, SUM(r1) AS s1s, MIN(CASE WHEN r2 = 1 THEN entry_ts END) AS entry_ts FROM ps GROUP BY COALESCE(uid, 's:' || sid), CASE WHEN uid IS NULL THEN 1 ELSE 0 END)
SELECT CASE WHEN entry_ts < 1791504000000000 THEN 0 WHEN entry_ts < 1791590400000000 THEN 1 ELSE 2 END AS bk, SUM(r2) AS ca, SUM(r4) AS cb FROM pu WHERE anon = 0 AND r2 = 1 GROUP BY bk ORDER BY bk LIMIT 3"
`;

exports[`funnelTrendSql (P0-9) > Users within 7 days carry the entry time through x2 into su and pu 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, first_value(NULLIF(usr_email, '') ORDER BY CASE WHEN NULLIF(usr_email, '') IS NULL THEN 1 ELSE 0 END, date) AS u0, MIN(CASE WHEN NULLIF(usr_email, '') IS NOT NULL THEN date END) AS ut, MIN(view_name) AS vn, MIN(_timestamp) AS ts FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'add-to-cart') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'place-order') OR NULLIF(usr_email, '') IS NOT NULL) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%