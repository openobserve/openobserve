SELECT CASE WHEN entry_ts < 1791504000000000 THEN 0 WHEN entry_ts < 1791590400000000 THEN 1 ELSE 2 END AS bk, SUM(r2) AS ca, SUM(r3) AS cb FROM ps WHERE r2 = 1 GROUP BY bk ORDER BY bk LIMIT 3"
`;
