s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1, m4 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, SUM(m4) AS seen4, MIN(CASE WHEN m2 = 1 THEN ts END) AS entry_ts FROM x1 GROUP BY sid),
