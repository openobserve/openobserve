// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`attribute breakdown SQL > carries coverage through a windowed Users run 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, first_value(NULLIF(usr_email, '') ORDER BY CASE WHEN NULLIF(usr_email, '') IS NULL THEN 1 ELSE 0 END, date) AS u0, MIN(CASE WHEN NULLIF(usr_email, '') IS NOT NULL THEN date END) AS ut, MIN(NULLIF(CAST("context_payment_method" AS VARCHAR), '')) AS dim, MIN(view_name) AS vn FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed') OR NULLIF(usr_email, '') IS NOT NULL) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, u0, ut, dim FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE)) OR u0 IS NOT NULL),
x1 AS (SELECT sid, t, ty, k, dim, CASE WHEN ty = 'action' AND k = 'product_viewed' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, FIRST_VALUE(u0) OVER (PARTITION BY sid ORDER BY CASE WHEN u0 IS NULL THEN 1 ELSE 0 END, ut) AS uid FROM x0),
x2 AS (SELECT sid, t, ty, k, dim, m1, m2, m3, uid FROM x1 WHERE m1 = 1 OR m2 = 1 OR m3 = 1),
su AS (SELECT CASE WHEN uid IS NULL THEN 1 ELSE 0 END AS anon, sequence_step_times(86400000, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, COUNT(DISTINCT CASE WHEN m1 = 1 THEN sid END) AS s1s, first_value(CASE WHEN m2 = 1 THEN dim END ORDER BY CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 0 ELSE 1 END, t) AS dim, MAX(CASE WHEN m1 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h1, MAX(CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h2, MAX(CASE WHEN m3 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h3 FROM x2 GROUP BY COALESCE(uid, 's:' || sid), CASE WHEN uid IS NULL THEN 1 ELSE 0 END),
pu AS (SELECT anon, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3, s1s, dim, h1, h2, h3 FROM su)
SELECT dim, SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(CASE WHEN r1 = 1 THEN h1 ELSE 0 END) AS dc1, SUM(CASE WHEN r2 = 1 THEN h2 ELSE 0 END) AS dc2, SUM(CASE WHEN r3 = 1 THEN h3 ELSE 0 END) AS dc3, approx_percentile_cont(d3 - d2, 0.5) AS mt2 FROM pu WHERE anon = 0 GROUP BY dim ORDER BY c1 DESC, dim LIMIT 1000"
`;

exports[`attribute breakdown SQL > reads a pinned step's own rows only, with that step's median 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, MIN(NULLIF(CAST("context_payment_method" AS VARCHAR), '')) AS dim, MIN(view_name) AS vn FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed')) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, dim FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE))),
x1 AS (SELECT sid, t, ty, k, dim, CASE WHEN ty = 'action' AND k = 'product_viewed' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, CAST(NULL AS VARCHAR) AS uid FROM x0),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, first_value(CASE WHEN m2 = 1 THEN dim END ORDER BY CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 0 ELSE 1 END, t) AS dim, MIN(CASE WHEN m1 = 1 THEN t END) AS t1, MAX(CASE WHEN m1 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h1, MAX(CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h2, MAX(CASE WHEN m3 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h3 FROM x1 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3, dim, t1, h1, h2, h3 FROM s)
SELECT dim, SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(CASE WHEN r1 = 1 THEN h1 ELSE 0 END) AS dc1, SUM(CASE WHEN r2 = 1 THEN h2 ELSE 0 END) AS dc2, SUM(CASE WHEN r3 = 1 THEN h3 ELSE 0 END) AS dc3, approx_percentile_cont(d3 - d2, 0.5) AS mt2 FROM ps GROUP BY dim ORDER BY c1 DESC, dim LIMIT 1000"
`;

exports[`attribute breakdown SQL > reads the first value on any step's row, with coverage and median columns 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, MIN(NULLIF(CAST("context_payment_method" AS VARCHAR), '')) AS dim, MIN(view_name) AS vn FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed')) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, dim FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE))),
x1 AS (SELECT sid, t, ty, k, dim, CASE WHEN ty = 'action' AND k = 'product_viewed' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, CAST(NULL AS VARCHAR) AS uid FROM x0),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, first_value(dim ORDER BY CASE WHEN dim IS NOT NULL AND (m1 = 1 OR m2 = 1 OR m3 = 1) THEN 0 ELSE 1 END, t) AS dim, MIN(CASE WHEN m1 = 1 THEN t END) AS t1, MAX(CASE WHEN m1 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h1, MAX(CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h2, MAX(CASE WHEN m3 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h3 FROM x1 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3, dim, t1, h1, h2, h3 FROM s)
SELECT dim, SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(CASE WHEN r1 = 1 THEN h1 ELSE 0 END) AS dc1, SUM(CASE WHEN r2 = 1 THEN h2 ELSE 0 END) AS dc2, SUM(CASE WHEN r3 = 1 THEN h3 ELSE 0 END) AS dc3, approx_percentile_cont(d3, 0.5) AS mt1, approx_percentile_cont(d3 - d2, 0.5) AS mt2 FROM ps GROUP BY dim ORDER BY c1 DESC, dim LIMIT 1000"
`;

exports[`attribute breakdown SQL > takes a user's first non-empty value and any session's coverage in Users mode 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, first_value(NULLIF(usr_email, '') ORDER BY CASE WHEN NULLIF(usr_email, '') IS NULL THEN 1 ELSE 0 END, date) AS u0, MIN(CASE WHEN NULLIF(usr_email, '') IS NOT NULL THEN date END) AS ut, MIN(NULLIF(CAST("context_payment_method" AS VARCHAR), '')) AS dim, MIN(view_name) AS vn FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed') OR NULLIF(usr_email, '') IS NOT NULL) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, u0, ut, dim FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE)) OR u0 IS NOT NULL),
x1 AS (SELECT sid, t, ty, k, dim, CASE WHEN ty = 'action' AND k = 'product_viewed' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, FIRST_VALUE(u0) OVER (PARTITION BY sid ORDER BY CASE WHEN u0 IS NULL THEN 1 ELSE 0 END, ut) AS uid FROM x0),
x2 AS (SELECT sid, t, ty, k, dim, m1, m2, m3, uid FROM x1 WHERE m1 = 1 OR m2 = 1 OR m3 = 1),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3, first_value(dim ORDER BY CASE WHEN dim IS NOT NULL AND (m1 = 1 OR m2 = 1 OR m3 = 1) THEN 0 ELSE 1 END, t) AS dim, MIN(CASE WHEN m1 = 1 THEN t END) AS t1, MAX(CASE WHEN m1 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h1, MAX(CASE WHEN m2 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h2, MAX(CASE WHEN m3 = 1 AND dim IS NOT NULL THEN 1 ELSE 0 END) AS h3 FROM x2 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3, dim, t1, h1, h2, h3 FROM s),
pu AS (SELECT CASE WHEN uid IS NULL THEN 1 ELSE 0 END AS anon, MAX(r1) AS r1, MAX(r2) AS r2, MAX(r3) AS r3, MIN(d2) AS d2, MIN(d3) AS d3, SUM(seen1) AS seen1, SUM(seen2) AS seen2, SUM(seen3) AS seen3, SUM(r1) AS s1s, first_value(dim ORDER BY CASE WHEN dim IS NULL THEN 1 ELSE 0 END, t1) AS dim, MAX(h1) AS h1, MAX(h2) AS h2, MAX(h3) AS h3 FROM ps GROUP BY COALESCE(uid, 's:' || sid), CASE WHEN uid IS NULL THEN 1 ELSE 0 END)
SELECT dim, SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(CASE WHEN r1 = 1 THEN h1 ELSE 0 END) AS dc1, SUM(CASE WHEN r2 = 1 THEN h2 ELSE 0 END) AS dc2, SUM(CASE WHEN r3 = 1 THEN h3 ELSE 0 END) AS dc3, approx_percentile_cont(d3, 0.5) AS mt1, approx_percentile_cont(d3 - d2, 0.5) AS mt2 FROM pu WHERE anon = 0 GROUP BY dim ORDER BY c1 DESC, dim LIMIT 1000"
`;

exports[`step property conditions (pc) SQL > flags a later step's own rows and tests the flag inside that step 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, MIN(view_name) AS vn, MAX(CASE WHEN ("context_payment_method" IS NOT NULL AND CAST("context_payment_method" AS VARCHAR) IN ('upi')) THEN 1 ELSE 0 END) AS pc2_1 FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed')) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, pc2_1 FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE))),
x1 AS (SELECT sid, t, ty, k, CASE WHEN ty = 'action' AND k = 'product_viewed' THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' AND pc2_1 = 1 THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, CAST(NULL AS VARCHAR) AS uid FROM x0),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3 FROM x1 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3 FROM s)
SELECT SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(seen1) AS seen1, SUM(seen2) AS seen2, SUM(seen3) AS seen3, approx_percentile_cont(d2, 0.5) AS med2, approx_percentile_cont(d2, 0.9) AS p90_2, approx_percentile_cont(d3, 0.5) AS med3, approx_percentile_cont(d3, 0.9) AS p90_3 FROM ps LIMIT 1"
`;

exports[`step property conditions (pc) SQL > flows into the alert, the drill-ins and Why N 1`] = `
"WITH g AS (SELECT session_id AS sid, MAX(CASE WHEN ((type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') AND ("context_payment_method" IS NOT NULL AND CAST("context_payment_method" AS VARCHAR) IN ('upi'))) THEN 1 ELSE 0 END) AS o1, MAX(CASE WHEN ((type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') AND ("context_payment_method" IS NOT NULL AND CAST("context_payment_method" AS VARCHAR) IN ('upi'))) THEN 1 ELSE 0 END) AS k1 FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (((type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') AND ("context_payment_method" IS NOT NULL AND CAST("context_payment_method" AS VARCHAR) IN ('upi')))) GROUP BY session_id)
SELECT SUM(o1) AS opened, SUM(CASE WHEN k1 = 1 THEN 1 ELSE 0 END) AS kept FROM g LIMIT 1"
`;

exports[`step property conditions (pc) SQL > keeps step 1 to rows without the value when negated, and checks each rule 1`] = `
"WITH x00 AS (SELECT session_id AS sid, type AS ty, MIN(date) AS t, MIN(view_url) AS url, MIN(action_target_name) AS atn, MIN(view_name) AS vn, MAX(CASE WHEN ("context_payment_method" IS NOT NULL AND CAST("context_payment_method" AS VARCHAR) IN ('upi')) THEN 1 ELSE 0 END) AS pc1_1, MAX(CASE WHEN ("context_plan" IS NOT NULL AND strpos(CAST("context_plan" AS VARCHAR), 'pro') > 0) THEN 1 ELSE 0 END) AS pc1_2 FROM "_rumdata" WHERE application_id = 'web' AND session_id IS NOT NULL AND (type = 'view' OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'product_viewed') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'payment_info_submitted') OR (type = 'action' AND action_target_name <> '' AND regexp_replace(regexp_replace(regexp_replace(regexp_replace(action_target_name, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') = 'order_completed')) GROUP BY session_id, type, CASE WHEN type = 'view' THEN view_id WHEN type = 'action' THEN CAST(date AS VARCHAR) ELSE type END),
x0 AS (SELECT sid, t, ty, CASE WHEN ty = 'view' THEN CASE WHEN url IS NULL OR url = '' THEN NULLIF(vn, '') ELSE COALESCE(NULLIF(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(regexp_replace(url, '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*', ''), '^([^?#]*)(?:\\?[^#]*)?(?:#!?(/[^?#]*))?.*$', '\\1#\\2'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '/(?:[0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|([a-z0-9]+(?:-[a-z0-9]+){2,})|[^/#]*(?:@|%40)[^/#]*|[A-Za-z_.=%-]{0}[0-9][A-Za-z0-9_.=%-]{19,}|[A-Za-z_.=%-]{1}[0-9][A-Za-z0-9_.=%-]{18,}|[A-Za-z_.=%-]{2}[0-9][A-Za-z0-9_.=%-]{17,}|[A-Za-z_.=%-]{3}[0-9][A-Za-z0-9_.=%-]{16,}|[A-Za-z_.=%-]{4}[0-9][A-Za-z0-9_.=%-]{15,}|[A-Za-z_.=%-]{5}[0-9][A-Za-z0-9_.=%-]{14,}|[A-Za-z_.=%-]{6}[0-9][A-Za-z0-9_.=%-]{13,}|[A-Za-z_.=%-]{7}[0-9][A-Za-z0-9_.=%-]{12,}|[A-Za-z_.=%-]{8}[0-9][A-Za-z0-9_.=%-]{11,}|[A-Za-z_.=%-]{9}[0-9][A-Za-z0-9_.=%-]{10,}|[A-Za-z_.=%-]{10}[0-9][A-Za-z0-9_.=%-]{9,}|[A-Za-z_.=%-]{11}[0-9][A-Za-z0-9_.=%-]{8,}|[A-Za-z_.=%-]{12}[0-9][A-Za-z0-9_.=%-]{7,}|[A-Za-z_.=%-]{13}[0-9][A-Za-z0-9_.=%-]{6,}|[A-Za-z_.=%-]{14}[0-9][A-Za-z0-9_.=%-]{5,}|[A-Za-z_.=%-]{15}[0-9][A-Za-z0-9_.=%-]{4,}|[A-Za-z_.=%-]{16}[0-9][A-Za-z0-9_.=%-]{3,}|[A-Za-z_.=%-]{17}[0-9][A-Za-z0-9_.=%-]{2,}|[A-Za-z_.=%-]{18}[0-9][A-Za-z0-9_.=%-]{1,}|[A-Za-z_.=%-]{19}[0-9][A-Za-z0-9_.=%-]{0,})(/|#|$)', '/\\1 \\2', 'g'), '/ ', '/:id', 'g'), ' ', '', 'g'), '#/?$', ''), '(.)/+$', '\\1'), ''), '/') END WHEN ty = 'action' THEN regexp_replace(regexp_replace(regexp_replace(regexp_replace(atn, '[^\\s]*(?:@|%40)[^\\s]*', ':email', 'g'), 'eyJ[A-Za-z0-9_=-]+(?:\\.[A-Za-z0-9_=-]+)*', ':token', 'g'), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}', ':id', 'g'), '[0-9]{6,}', ':num', 'g') END AS k, pc1_1, pc1_2 FROM x00 WHERE ty = 'action' OR (ty = 'view' AND (FALSE))),
x1 AS (SELECT sid, t, ty, k, CASE WHEN ty = 'action' AND k = 'product_viewed' AND pc1_1 = 1 AND pc1_2 = 0 THEN 1 ELSE 0 END AS m1, CASE WHEN ty = 'action' AND k = 'payment_info_submitted' THEN 1 ELSE 0 END AS m2, CASE WHEN ty = 'action' AND k = 'order_completed' THEN 1 ELSE 0 END AS m3, CAST(NULL AS VARCHAR) AS uid FROM x0),
s AS (SELECT sid, MAX(uid) AS uid, sequence_step_times(0, t, m1 = 1, m2 = 1, m3 = 1) AS f, SUM(m1) AS seen1, SUM(m2) AS seen2, SUM(m3) AS seen3 FROM x1 GROUP BY sid),
ps AS (SELECT sid, uid, CASE WHEN f[1] IS NOT NULL THEN 1 ELSE 0 END AS r1, CASE WHEN f[2] IS NOT NULL THEN 1 ELSE 0 END AS r2, CASE WHEN f[3] IS NOT NULL THEN 1 ELSE 0 END AS r3, f[2] AS d2, f[3] AS d3, seen1, seen2, seen3 FROM s)
SELECT SUM(r1) AS c1, SUM(r2) AS c2, SUM(r3) AS c3, SUM(seen1) AS seen1, SUM(seen2) AS seen2, SUM(seen3) AS seen3, approx_percentile_cont(d2, 0.5) AS med2, approx_percentile_cont(d2, 0.9) AS p90_2, approx_percentile_cont(d3, 0.5) AS med3, approx_percentile_cont(d3, 0.9) AS p90_3 FROM ps LIMIT 1"
`;
