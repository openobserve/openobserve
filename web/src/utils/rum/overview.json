      },
      "queryType": "sql",
      "queries": [
        {
          "query": "SELECT 100 - (100.0 * CAST(count(distinct CASE WHEN error_is_crash = true THEN session_id END) AS DOUBLE) / NULLIF(CAST(count(distinct session_id) AS DOUBLE), 0)) as \"y_axis_1\"  FROM \"_rumdata\" where source in ('android', 'ios', 'react-native', 'flutter') and service in ($service) and env in ($env) and version in ($version)",
          "customQuery": true,
          "fields": {
            "stream": "_rumdata",
            "stream_type": "logs",
            "x": [],
            "y": [
              {
                "label": "Crash-free Sessions",
                "alias": "y_axis_1",
                "column": "y_axis_1",
                "color": null,
                "aggregationFunction": "count"
              }
            ],
            "z": [],
            "filter": []
          },
          "config": {
            "promql_legend": "",
            "layer_type": "scatter",
            "weight_fixed": 1
          }
