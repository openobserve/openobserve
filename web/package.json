    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.35",
    "@types/js-yaml": "^4.0.9",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
