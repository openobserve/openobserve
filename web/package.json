    "flag-icons": "^7.5.0",
    "gridstack": "^12.4.2",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "js-cookie": "^3.0.8",
    "js-yaml": "^4.3.1",
    "json-2-csv": "^5.5.11",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^0.562.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
