[
  {"name": "private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
  {"name": "AWS access key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"},
  {"name": "GitHub token", "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})"},
  {"name": "Slack token", "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"},
  {"name": "Google API key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}"},
  {"name": "Stripe key", "pattern": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{16,}"},
  {"name": "sk- API key", "pattern": "\\bsk-[A-Za-z0-9_-]{20,}"},
  {"name": "Dynatrace token", "pattern": "\\bdt0[a-z][0-9]{2}\\.[A-Za-z0-9]{8,24}\\.[A-Za-z0-9]{64}"},
  {"name": "Datadog application key", "pattern": "\\bddapp_[A-Za-z0-9_]{34}"},
  {"name": "Datadog access token", "pattern": "\\bdd(?:pat|sat)_[A-Za-z0-9_-]{20,}"},
  {"name": "Datadog key", "pattern": "(?i)\\b(?:datadog|dd)[\\w .-]{0,30}?[\\s'\"]{0,3}(?:=>|=|:|,)\\s*['\"]?[a-f0-9]{32}(?:[a-f0-9]{8})?\\b"},
  {"name": "Grafana service account token", "pattern": "\\bglsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8}\\b"},
  {"name": "Grafana Cloud token", "pattern": "\\bglc_[A-Za-z0-9+/]{32,}"},
  {"name": "Grafana API key", "pattern": "\\beyJrIjoi[A-Za-z0-9+/]{70,}"},
  {"name": "JWT", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"},
  {"name": "credentials in a URL", "pattern": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s/:@]+:[^\\s/@]+@"},
  {"name": "bearer or Api-Token credential", "pattern": "(?i)\\b(?:bearer|api-token)\\s+[A-Za-z0-9+/_.~=-]{16,}"},
  {"name": "key, token or password value", "pattern": "(?i)(?:\\b|_)(?:api[_-]?key|apikey|app(?:lication)?[_-]?key|secret|token|password|passwd|authorization)\\b[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/_.~=-]{16,}"}
]
