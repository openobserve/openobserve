+    await flushPromises();
+    await (w.vm as any).runNow();
+    await flushPromises();
+    expect(w.emitted("ran")?.[0]).toEqual([RUN]);
+    expect(
+      pendingManualRuns(store.state.selectedOrganization.identifier, "r-dialog", []),
