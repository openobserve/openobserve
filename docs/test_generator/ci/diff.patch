+            LockoutBackoff::Linear => start.saturating_mul(u64::from(level)),
+            LockoutBackoff::Exponential => match level - 1 {
+                shift if shift < 63 => start.saturating_mul(1u64 << shift),
+                _ => u64::MAX,
+            },
+        };
+        secs.min(u64::from(self.max_secs)) as i64
