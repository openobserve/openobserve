+    /// A converging backfit has no parity; the P0 here vanished at an even pass count.
+    #[test]
+    fn test_the_baseline_fit_does_not_depend_on_the_parity_of_its_pass_count() {
+        let points = trending_daily_points(14 * 24);
+        let fitted = SeasonalBaseline::fit(&points, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a full fortnight must fit");
+
+        let spread = points
+            .iter()
+            .map(|p| p.value)
+            .fold(f64::NEG_INFINITY, f64::max)
+            - points.iter().map(|p| p.value).fold(f64::INFINITY, f64::min);
+
+        for point in &points {
+            let residual = fitted.residual(point.timestamp_us, point.value);
+            assert!(
+                residual.is_finite(),
+                "a converged fit must not produce a non-finite residual"
+            );
+            assert!(
+                (residual - fitted.global as f64).abs() < spread,
+                "the residual must stay inside the series' own range, got {residual}"
+            );
+        }
+
+        // The level term is what an even pass count used to destroy.
+        let (_, _, _, trailing) = fitted.params();
+        let first = fitted.level_at(points[0].timestamp_us);
+        assert!(
+            (trailing - first).abs() > 1.0,
+            "a 0.05/bucket trend over a fortnight must leave a moving level, got {first} -> \
+             {trailing}"
+        );
+    }
