+pub fn obsolete_set_ids(old: &ServiceIdentityConfig, new: &ServiceIdentityConfig) -> Vec<String> {
+    old.sets
+        .iter()
+        .filter(
+            |old_set| match new.sets.iter().find(|s| s.id == old_set.id) {
+                None => true,
+                Some(new_set) => new_set.distinguish_by != old_set.distinguish_by,
+            },
+        )
+        .map(|s| s.id.clone())
+        .collect()
