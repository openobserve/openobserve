+  it("is absent in a normal editing session (no run loaded)", async () => {
+    stageNode("function", { isEdit: true, id: "fn-1" });
+    wrapper = mountDrawer();
+    await nextTick();
+    expect(wrapper.find(RETRY).exists()).toBe(false);
