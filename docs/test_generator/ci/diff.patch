+    const SQL_AGG: &str = "approx_percentile_cont(duration_ms, 0.95)";
+
+    // ── scope is meaningless under PromQL ───────────────────────────────────
+
+    #[test]
+    fn a_promql_time_slice_with_a_scope_is_rejected() {
+        let cfg = ts(
+            QueryLanguage::PromQl,
+            PROMQL_AGG,
