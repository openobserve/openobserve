+        // ---- the picker's rows (PR 3) --------------------------------------
+
+        fn with_id(mut alert: Alert) -> Alert {
+            use svix_ksuid::KsuidLike as _;
+            alert.id = Some(svix_ksuid::Ksuid::new(None, None));
+            alert.name = "checkout latency".into();
