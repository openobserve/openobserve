+/// `Url::join` would replace the last segment, silently dropping a configured `/v1`.
+fn append_path_segments(url: &mut Url, suffix: &[&str]) -> Result<()> {
+    let mut segments = url
+        .path_segments_mut()
+        .map_err(|_| anyhow::anyhow!("URL cannot have a path"))?;
+    segments.pop_if_empty();
+    segments.extend(suffix);
+    Ok(())
