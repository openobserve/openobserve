+    /// What this pins is that the level is held, so its error never grows with horizon.
+    #[test]
+    fn test_the_carried_level_holds_the_trailing_knot_on_a_sustained_shift() {
+        let shifted = seasonal_points(14 * 24, |i, _| {
+            let phase = (i % 24) as f64 / 24.0 * std::f64::consts::TAU;
+            let dip = if i >= 12 * 24 { -60.0 } else { 0.0 };
+            100.0 + 20.0 * phase.sin() + dip
+        });
+        let fitted = SeasonalBaseline::fit(&shifted, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a full fortnight must fit");
+        let (_, _, _, trailing) = fitted.params();
+        let last = shifted.last().unwrap().timestamp_us;
+
+        // The step is real and the fit saw it, so the hold has a post-step level to carry.
+        assert!(
+            trailing < -40.0,
+            "the fit must already carry most of the -60 step, got {trailing}"
+        );
+
+        let boundary = fitted.level_at(last + 1);
+        let far = fitted.level_at(last + 336 * 3_600_000_000);
+        assert_eq!(
+            boundary, trailing,
+            "the first unseen bucket must read the trailing knot exactly, got {boundary}"
+        );
+        assert_eq!(
+            far, boundary,
+            "two weeks out the level must be unchanged from the boundary: {far} against \
+             {boundary}. A release toward zero lands near 0 here and a relaxation onto \
+             the trailing day's median lands near the pre-step level; both are rejected"
+        );
+
+        // The error is the centred median's truncation and is the SAME at every horizon.
+        let error = (far - -60.0).abs();
+        assert!(
+            error < 10.0,
+            "the held level must stay within the trailing knot's own truncation of the \
+             settled -60, got {error}"
+        );
+
+        // A series whose level never moved must carry ~no level, or this passes on a constant.
+        let reverting = seasonal_points(14 * 24, |i, _| {
+            let phase = (i % 24) as f64 / 24.0 * std::f64::consts::TAU;
+            100.0 + 20.0 * phase.sin()
+        });
+        let steady = SeasonalBaseline::fit(&reverting, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a full fortnight must fit");
+        let last = reverting.last().unwrap().timestamp_us;
+        let spread = reverting
+            .iter()
+            .map(|p| p.value)
+            .fold(f64::NEG_INFINITY, f64::max)
+            - reverting
+                .iter()
+                .map(|p| p.value)
+                .fold(f64::INFINITY, f64::min);
+        for hours in [1_i64, 24, 168, 336] {
+            let carried = steady.level_at(last + hours * 3_600_000_000).abs() as f64;
+            assert!(
+                carried < spread * 0.05,
+                "a series that never left its centre must carry ~no level, got {carried} \
+                 at +{hours}h against a spread of {spread}"
+            );
+        }
+    }
