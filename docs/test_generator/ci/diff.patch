+// Live o2o smoke test. Run inside the matching worktree container.
+// Uses synthetic datasets and a loopback OpenAI-compatible stub; no real model calls.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
+import { setTimeout as sleep } from 'node:timers/promises';
+
+const settings = Object.fromEntries(readFileSync('/workspace/openobserve/.env.docker', 'utf8')
+  .split('\n').filter(line => /^[A-Z][A-Z0-9_]*=/.test(line))
+  .map(line => { const at = line.indexOf('='); return [line.slice(0, at), line.slice(at + 1).trim().replace(/^(['"])(.*)\1$/, '$2')]; }));
+const pid = readdirSync('/proc').filter(name => /^\d+$/.test(name)).find(name => {
+  try { return readFileSync(`/proc/${name}/comm`, 'utf8').trim() === 'openobserve'; } catch { return false; }
+});
+assert(pid, 'OpenObserve must be running');
+const processSettings = Object.fromEntries(readFileSync(`/proc/${pid}/environ`, 'utf8').split('\0')
+  .filter(line => line.includes('=')).map(line => { const at = line.indexOf('='); return [line.slice(0, at), line.slice(at + 1)]; }));
+const config = { ...settings, ...processSettings };
+const auth = `Basic ${Buffer.from(`${config.ZO_ROOT_USER_EMAIL}:${config.ZO_ROOT_USER_PASSWORD}`).toString('base64')}`;
+const api = 'http://127.0.0.1:5080';
+const port = Number(process.env.FAIRNESS_STUB_PORT || 18091);
+const prefix = `codex_fairness_${Date.now()}`;
+const reportPath = `/tmp/${prefix}.json`;
+const resources = { organizations: [], experiments: [] };
+const events = [];
+let active = 0;
+let peak = 0;
+const activeByOrg = {};
+let barrierArrived = false;
+let releaseBarrier;
+const barrier = new Promise(resolve => { releaseBarrier = resolve; });
+let scorerCalls = 0;
+
+async function request(path, method = 'GET', body) {
+  const response = await fetch(api + path, {
+    method, headers: { authorization: auth, 'content-type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(30000),
+  });
+  const raw = await response.text();
+  let data; try { data = JSON.parse(raw); } catch { data = null; }
+  if (!response.ok) throw new Error(`${method} ${path}: HTTP ${response.status}; ${data?.message || data?.error || 'request rejected'}`);
+  return data;
+}
+
+async function until(check, timeoutMs = 120000) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    const result = await check();
+    if (result) return result;
+    await sleep(200);
+  }
+  throw new Error('Timed out waiting for test progress');
+}
+
+function record(type, tag) {
+  events.push({ type, at: Date.now(), org: tag.org, experiment: tag.experiment, active, activeByOrg: { ...activeByOrg } });
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    let raw = ''; for await (const chunk of req) raw += chunk;
+    if (req.url === '/score') {
+      scorerCalls++;
+      res.writeHead(200, { 'content-type': 'application/json' });
+      res.end(JSON.stringify({ code: 'OK', value: 1, reason: 'synthetic local test' }));
+      return;
+    }
+    const body = JSON.parse(raw);
+    const tag = JSON.parse(body.messages[0].content);
+    if (tag.experiment === 'barrier') {
+      barrierArrived = true;
+      await barrier;
+    } else {
+      active++;
+      activeByOrg[tag.org] = (activeByOrg[tag.org] || 0) + 1;
+      peak = Math.max(peak, active);
+      record('start', tag);
+      await sleep(tag.org === 'A' ? 1000 : tag.org === 'B' ? 100 : 300);
+      active--;
+      activeByOrg[tag.org]--;
+      record('end', tag);
+    }
+    res.writeHead(200, { 'content-type': 'application/json' });
+    res.end(JSON.stringify({
+      id: 'local-fairness-test', object: 'chat.completion', model: 'fairness-stub',
+      choices: [{ index: 0, message: { role: 'assistant', content: 'ok' }, finish_reason: 'stop' }],
+      usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },
+    }));
+  } catch {
+    res.writeHead(500); res.end('local stub failure');
+  }
+});
+
+async function createOrg(label) {
+  const org = await request('/api/organizations', 'POST', { name: `${prefix}_${label}` });
+  const id = org.identifier;
+  assert(id, 'Organization creation must return an identifier');
+  const resource = { label, id };
+  resources.organizations.push(resource);
+  const provider = await request(`/api/${id}/providers`, 'POST', {
+    name: `${prefix}_provider`, providerType: 'openai_compatible',
+    endpoint: `http://127.0.0.1:${port}/v1/chat/completions`,
+    defaultModel: 'fairness-stub', availableModels: ['fairness-stub'],
+    authConfig: { api_key: 'local-test-only' }, isDefault: false,
+  });
+  resource.provider = provider.id;
+  const scorer = await request(`/api/${id}/scorers`, 'POST', {
+    name: `${prefix}_scorer`, scorer: {
+      type: 'remote', template: '{}', params: {
+        endpoint: `http://127.0.0.1:${port}/score`, http_method: 'POST',
+        timeout_ms: 10000, max_retries: 0, auth: { type: 'none' },
+      },
+    },
+  });
+  resource.scorer = scorer.entityId;
+  const dataset = await request(`/api/${id}/datasets`, 'POST', { name: `${prefix}_dataset`, description: 'Synthetic organization fairness smoke test' });
+  resource.dataset = dataset.id;
+  const rows = await request(`/api/${id}/datasets/${dataset.id}/items`, 'PUT', {
+    idempotencyKey: `${prefix}_${label}_rows`,
+    items: Array.from({ length: 12 }, (_, row) => ({ input: { row }, expectedOutput: 'ok' })),
+  });
+  resource.version = rows.datasetVersion;
+  resource.logicalIds = rows.items.map(row => row.logicalId);
+  console.log(JSON.stringify({ setup: label, organization: id, rows: rows.items.length }));
+  return resource;
+}
+
+async function createExperiment(org, name, count) {
+  const result = await request(`/api/${org.id}/experiments`, 'POST', {
+    name: `${prefix}_${name}`, datasetId: org.dataset, datasetVersion: org.version,
+    datasetFilter: { logicalIds: org.logicalIds.slice(0, count) },
+    task: { type: 'inline_prompt', providerId: org.provider, model: 'fairness-stub',
+      messages: [{ role: 'user', content: JSON.stringify({ org: org.label, experiment: name }) }] },
+    scorers: [{ id: org.scorer, version: 1 }], trialCount: 1,
+    idempotencyKey: `${prefix}_${name}`, metadata: { test: prefix },
+  });
+  const experiment = { id: result.experiment.id, org: org.id, label: org.label, name, slots: count };
+  resources.experiments.push(experiment);
+  // This normal UI read initializes _llm_scores for a newly created org. The
+  // background runner currently assumes the score stream already exists.
+  await request(`/api/${org.id}/experiments/${experiment.id}`);
+  console.log(JSON.stringify({ created: name, id: experiment.id, slots: count }));
+  return experiment;
+}
+
+async function statuses(includeSummary = false) {
+  const output = [];
+  for (const org of resources.organizations) {
+    const list = await request(`/api/${org.id}/experiments?includeSummary=${includeSummary}`);
+    for (const experiment of list.list || []) {
+      const owned = resources.experiments.find(item => item.id === experiment.id);
+      if (owned) output.push({ ...owned, status: experiment.executionStatus,
+        taskOutcomes: experiment.taskOutcomes, scoreOutcomes: experiment.scoreOutcomes });
+    }
+  }
+  return output;
+}
+
+try {
+  assert.equal((await fetch(`${api}/healthz`)).status, 200, 'o2o health check');
+  console.log(JSON.stringify({ preflight: 'healthy', pid: Number(pid), workerOverride: Number(config.O2_EVAL_WORKER_THREAD_NUM || 0), existingSsrfOverride: config.ZO_SKIP_SSRF_CHECKS === 'true' }));
+  if (process.argv.includes('--preflight')) {
+    const orgs = await request('/api/organizations');
+    console.log(JSON.stringify({ auth: 'ok', organizationCount: orgs.data.length }));
+  } else {
+    await new Promise((resolve, reject) => { server.once('error', reject); server.listen(port, '127.0.0.1', resolve); });
+    const orgs = process.env.FAIRNESS_REUSE_REPORT
+      ? JSON.parse(readFileSync(process.env.FAIRNESS_REUSE_REPORT, 'utf8')).resources.organizations
+      : [];
+    if (orgs.length) resources.organizations.push(...orgs);
+    else for (const label of ['A', 'B', 'C']) orgs.push(await createOrg(label));
+    await createExperiment(orgs[0], 'barrier', 1);
+    await until(() => barrierArrived);
+    // The current runner lock keeps the next snapshot from starting until all
+    // test experiments exist. This tests fairness within one real DB snapshot.
+    for (const [org, name, count] of [[orgs[0], 'A1', 12], [orgs[0], 'A2', 12], [orgs[1], 'B1', 4], [orgs[2], 'C1', 8]]) {
+      await createExperiment(org, name, count);
+    }
+    releaseBarrier();
+    console.log(JSON.stringify({ phase: 'running', expectedCalls: 36 }));
+    await until(() => events.filter(event => event.type === 'end').length === 36);
+    const terminal = await until(async () => {
+      const current = await statuses();
+      return current.length === 5 && current.every(item => ['completed', 'failed', 'cancelled'].includes(item.status)) ? current : false;
+    });
+    // Scoring is asynchronous. Keep the stub alive until all score writes are
+    // visible, including the last slot and the snapshot barrier experiment.
+    const scored = await until(async () => {
+      const current = await statuses(true);
+      assert(current.every(item => !(item.scoreOutcomes?.failed > 0)), 'Synthetic scores must succeed');
+      return current.length === 5 && current.every(item => item.scoreOutcomes?.scored === item.slots)
+        ? current : false;
+    });
+    const starts = events.filter(event => event.type === 'start');
+    const expectedCapacity = Number(process.env.FAIRNESS_EXPECTED_CAPACITY || 4);
+    assert.equal(peak, expectedCapacity, 'Shared slot budget must be saturated and never exceeded');
+    assert.equal(new Set(starts.slice(0, expectedCapacity).map(event => event.org)).size, 3, 'All three orgs must enter the initial allocation');
+    // Provider setup has asynchronous DB reads, so HTTP arrival order across
+    // orgs need not match admission order. Check A's own first two starts.
+    assert.deepEqual(new Set(starts.filter(event => event.org === 'A').slice(0, 2).map(event => event.experiment)), new Set(['A1', 'A2']), 'Org A experiments must rotate within their share');
+    const bEnd = Math.max(...events.filter(event => event.type === 'end' && event.org === 'B').map(event => event.at));
+    const cEnd = Math.max(...events.filter(event => event.type === 'end' && event.org === 'C').map(event => event.at));
+    const earlyPeakA = Math.max(...events.filter(event => event.at < Math.min(bEnd, cEnd)).map(event => event.activeByOrg.A || 0));
+    assert(earlyPeakA <= Math.ceil(expectedCapacity / 3), 'Slow org A must not accumulate every slot while other orgs have work');
+    assert(starts.some(event => event.at > Math.max(bEnd, cEnd) && event.activeByOrg.A === expectedCapacity), 'Org A must reuse full capacity after other orgs finish');
+    assert(terminal.every(item => item.status === 'completed'), 'All synthetic experiments must complete');
+    for (const [name, count] of [['A1', 12], ['A2', 12], ['B1', 4], ['C1', 8]]) {
+      assert.equal(starts.filter(event => event.experiment === name).length, count, 'Every slot executes once');
+    }
+    const summary = { result: 'passed', prefix, peak, expectedCapacity, earlyPeakA,
+      firstStarts: starts.slice(0, expectedCapacity).map(({ org, experiment }) => ({ org, experiment })),
+      calls: starts.length, scorerCalls, terminal: scored, resources, events };
+    writeFileSync(reportPath, JSON.stringify(summary, null, 2));
+    console.log(JSON.stringify({ ...summary, resources: undefined, events: undefined, reportPath }));
+  }
+} catch (error) {
+  writeFileSync(reportPath, JSON.stringify({ result: 'failed', error: error.message, prefix, resources, events }, null, 2));
+  console.error(JSON.stringify({ result: 'failed', error: error.message, reportPath }));
+  process.exitCode = 1;
+} finally {
+  releaseBarrier();
+  // Retain the tagged resources for inspection. The stub only lives for this run.
+  if (server.listening) await new Promise(resolve => server.close(resolve));
+}
