+) -> anyhow::Result<Vec<(i64, Vec<f32>)>> {
+    build_window_vectors_with_baseline(points, seasonality, shingle_size, interval_us, None)
+}
+
+/// `None` scores raw values, which is what a model fitted without a baseline expects.
+pub fn build_window_vectors_with_baseline(
+    points: &[QueryDataPoint],
+    seasonality: &Seasonality,
+    shingle_size: usize,
+    interval_us: i64,
