+use std::collections::{HashMap, VecDeque};
+
+/// Shares a pass's capacity by organization, then rotates experiments within
+/// each organization. Prefer the organization with the fewest running slots:
+/// round-robin starts alone let slow slots accumulate until one org owns every
+/// worker. Ties rotate, including when there are more orgs than workers.
+pub(super) struct FairQueue<T> {
+    organizations: Vec<Organization<T>>,
+    indices: HashMap<String, usize>,
+    cursor: usize,
+    in_flight: usize,
+    capacity: usize,
+}
+
+struct Organization<T> {
+    experiments: VecDeque<VecDeque<T>>,
+    in_flight: usize,
+}
+
+impl<T> FairQueue<T> {
+    pub(super) fn new(capacity: usize) -> Self {
+        Self {
+            organizations: Vec::new(),
+            indices: HashMap::new(),
+            cursor: 0,
+            in_flight: 0,
+            capacity: capacity.max(1),
+        }
+    }
+
+    /// Register every prepared experiment before taking the first slot.
+    pub(super) fn push(&mut self, org_id: &str, slots: impl IntoIterator<Item = T>) {
+        let slots = slots.into_iter().collect::<VecDeque<_>>();
+        if slots.is_empty() {
+            return;
+        }
+        let index = *self.indices.entry(org_id.to_owned()).or_insert_with(|| {
+            self.organizations.push(Organization {
+                experiments: VecDeque::new(),
+                in_flight: 0,
+            });
+            self.organizations.len() - 1
+        });
+        self.organizations[index].experiments.push_back(slots);
+    }
+
+    pub(super) fn next(&mut self) -> Option<(usize, T)> {
+        if self.in_flight == self.capacity {
+            return None;
+        }
+        let count = self.organizations.len();
+        let index = (0..count)
+            .map(|offset| (self.cursor + offset) % count)
+            .filter(|&index| !self.organizations[index].experiments.is_empty())
+            .min_by_key(|&index| self.organizations[index].in_flight)?;
+        let org = &mut self.organizations[index];
+        let mut experiment = org.experiments.pop_front().unwrap();
+        let slot = experiment.pop_front().unwrap();
+        if !experiment.is_empty() {
+            org.experiments.push_back(experiment);
+        }
+        org.in_flight += 1;
