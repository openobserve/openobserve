+  it("returns null when nothing recognisable is present", () => {
+    expect(getToolCallDisplayData({ unrelated: 1 })).toBeNull();
+  });
+
+  it("pulls the nested search query fields", () => {
+    expect(
+      getToolCallDisplayData({
+        request_body: {
+          query: {
+            sql: "SELECT 1",
+            start_time: 1,
+            end_time: 2,
+            from: 0,
+            size: 10,
+            query_type: "sql",
