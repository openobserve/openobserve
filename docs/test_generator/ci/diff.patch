+pub fn apply_pool_adjustment(
+    org_id: &str,
+    feature: TrialQuotaFeature,
+    adjustment: PoolAdjustment,
+    idempotency_key: &str,
+) -> bool {
+    if !ADJUSTMENTS.claim(idempotency_key) {
