+        let (config_id, version) = ("unreadable_disk_config", 987_656);
+        clear_cache_entry(config_id, version).await;
+        let path = get_disk_cache_path(config_id, version).unwrap();
+        if let Some(dir) = path.parent() {
+            tokio::fs::create_dir_all(dir).await.unwrap();
+        }
+        // A directory at the path makes read() fail while exists() still passes.
+        tokio::fs::create_dir_all(&path).await.unwrap();
+        assert!(path.exists());
+
+        let got = get_model(config_id, version).await;
+        assert!(
+            got.is_ok(),
+            "an unreadable path must not surface as an error"
+        );
+        assert!(got.unwrap().is_none());
+        assert!(
+            path.exists(),
+            "a transient read failure must not delete the blob"
+        );
+
+        if let Some(dir) = path.parent() {
+            let _ = tokio::fs::remove_dir_all(dir).await;
+        }
+    }
 }

diff --git a/o2_enterprise/src/enterprise/anomaly_detection/coverage.rs b/o2_enterprise/src/enterprise/anomaly_detection/coverage.rs
--- a/o2_enterprise/src/enterprise/anomaly_detection/coverage.rs
+++ b/o2_enterprise/src/enterprise/anomaly_detection/coverage.rs
@@ -0,0 +1,447 @@
