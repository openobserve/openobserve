+        // Below the surviving knot spacing the operator is handed a coarser level than asked.
+        let half_hour_us = 1_800_000_000_i64;
+        let one_hour_us = 3_600_000_000_i64;
+        let a_year = 365_u32;
+        let knot_spacing_us = i64::from(a_year) * 86_400_000_000 / MAX_LEVEL_KNOTS as i64;
+        assert!(
+            knot_spacing_us > one_hour_us,
+            "the premise: at a year the retained knots must be coarser than an hour, got {knot_spacing_us}"
+        );
+        assert_eq!(
+            level_half_width_us(Some(one_hour_us), half_hour_us, a_year),
+            knot_spacing_us,
+            "an hour-wide level over a year must be raised to the knot spacing"
+        );
+        // And it must stay inert where the knots are finer, which is nearly every window.
+        assert_eq!(
+            level_half_width_us(Some(one_hour_us), half_hour_us, 30),
+            one_hour_us,
+            "at 30 days the knots are far finer than an hour, so nothing should move"
+        );
+    }
