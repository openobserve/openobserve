+pub async fn delete_by_org_id_and_provider(
+    org_id: &str,
+    provider: &str,
+) -> Result<(), errors::Error> {
+    let client = get_orm_client_rw().await;
+    Entity::delete_many()
+        .filter(Column::OrgId.eq(org_id))
+        .filter(Column::Provider.eq(provider))
+        .exec(client)
+        .await?;
+
+    {
+        let mut cache = CACHE.write().await;
+        cache.remove(org_id);
+    }
+    // Broadcast to coordinator for the org
+    let key = format!("{BILLINGS_KEY_PREFIX}{}", org_id);
+    if let Err(e) = put_into_db_coordinator(&key, Default::default(), true, None).await {
+        log::error!(
+            "[customer_billings] Failed to broadcast cache invalidation for org {}: {}",
+            org_id,
+            e
+        );
+    }
+
+    Ok(())
+}
+
+/// Update-only, so a run racing an unlink cannot re-insert the deleted row the way `put` would.
+pub async fn set_metering_offset(org_id: &str, id: &str, offset: i64) -> Result<(), errors::Error> {
+    let client = get_orm_client_rw().await;
+    Entity::update_many()
+        .col_expr(Column::MeteringOffset, Expr::value(offset))
+        .filter(Column::OrgId.eq(org_id))
+        .filter(Column::Id.eq(id))
+        .exec(client)
+        .await?;
+
+    {
+        let mut cache = CACHE.write().await;
+        cache.remove(org_id);
+    }
+    // Broadcast to coordinator for the org
+    let key = format!("{BILLINGS_KEY_PREFIX}{}", org_id);
+    if let Err(e) = put_into_db_coordinator(&key, Default::default(), true, None).await {
+        log::error!(
+            "[customer_billings] Failed to broadcast cache invalidation for org {}: {}",
+            org_id,
+            e
+        );
+    }
+
+    Ok(())
+}
