+                PresetSpec::BusinessHoursPlusNights {
+                    business_hours: g(None, &["ana@o2.ai"]),
+                    after_hours: g(None, &["bo@o2.ai"]),
+                    days: vec![],
+                    start_minute: 540,
+                    end_minute: 1080,
+                },
+                DEFAULT_HANDOVER_MICROS,
+                "`days` is empty",
+            ),
+            (
+                "a split at the very start of the week",
+                PresetSpec::SplitTheWeek {
+                    first: g(None, &["ana@o2.ai"]),
