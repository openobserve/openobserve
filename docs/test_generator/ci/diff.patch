+/// Remove `member_org` from the billing group of `payer_org` and make it a free org.
+/// Only the member's billing row and the membership row change.
+pub async fn remove_billing_member(payer_org: &str, member_org: &str) -> Result<(), anyhow::Error> {
+    let Some(m) = list_billing_membership_of(member_org).await? else {
+        return Err(anyhow::anyhow!(
+            "org {member_org} is not part of a billing group"
+        ));
+    };
+    if m.payer_org_id != payer_org {
+        return Err(anyhow::anyhow!(
+            "org {member_org} is not part of the billing group of {payer_org}"
+        ));
+    }
+
+    // Billing row first: a leftover membership row is harmless, a leftover SuperOrg row is not.
+    if let Some(b) = super::billings::get_billing_by_org_id(member_org).await?
+        && b.provider == MeteringProvider::SuperOrg
+    {
+        super::customer_billings::delete_by_org_id_and_provider(
+            member_org,
+            &MeteringProvider::SuperOrg.to_string(),
+        )
+        .await?;
+    }
+
+    super::table::billing_group_members::remove(payer_org, member_org).await?;
+    Ok(())
+}
