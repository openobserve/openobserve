+
+  it("clears the special set when the requirement is off", () => {
+    const payload = buildPolicyPayload(CONFIGURED_POLICY, {
+      ...policyDefaults(CONFIGURED_POLICY),
+      require_special: false,
+      special_char_set: "!@#",
