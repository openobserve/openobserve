+        let billing_read = ["get_billing_by", "_org_id("].concat();
+        let org_read = ["infra::table::organizations", "::get("].concat();
+
+        let src = source_above_the_tests();
+        let (open, end) = guarded_block(&src, &guard);
+
+        for read in [&billing_read, &org_read] {
