+    /// Trailing counterpart of `rolling_median_level`, test-local so the two can be compared.
+    fn trailing_median_level(
+        ordered: &[(i64, f64)],
+        residual: &[f64],
+        half_width_us: i64,
+    ) -> Vec<f32> {
+        let timestamps: Vec<i64> = ordered.iter().map(|(ts, _)| *ts).collect();
+        timestamps
+            .iter()
+            .enumerate()
+            .map(|(i, ts)| {
+                let lo = timestamps
+                    .partition_point(|t| *t < ts.saturating_sub(half_width_us.saturating_mul(2)));
+                let mut window: Vec<f64> = residual[lo..=i].to_vec();
+                median_of(&mut window).unwrap_or(0.0) as f32
+            })
+            .collect()
+    }
