+      ]),
+    );
+  });
+
+  it("flags when the other save also edited my panel", async () => {
+    service.get_Dashboard.mockResolvedValueOnce(response(BASE, "h1"));
+    await getDashboard(store, DASH, FOLDER);
+    service.get_Dashboard.mockResolvedValueOnce(
