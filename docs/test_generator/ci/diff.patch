+            s.decide(&point(12 * HOUR, 2.0), &p).suppressed_by,
+            Suppression::Budget
+        );
+        assert!(s.decide(&point(DAY + 1, 2.0), &p).fires);
+    }
+
+    /// Same rule as the cooldown's future anchor: skew must suppress, never storm.
+    #[test]
+    fn a_future_spend_entry_suppresses_until_data_time_catches_up() {
+        let p = AlertPolicy {
+            cooldown_secs: 0,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        let mut s = AlertState {
+            last_fired_us: None,
+            recent_delivered_us: vec![10 * DAY],
+        };
+        assert_eq!(
+            s.decide(&point(DAY, 2.0), &p).suppressed_by,
+            Suppression::Budget
+        );
+        assert!(s.decide(&point(11 * DAY + 1, 2.0), &p).fires);
+    }
+
+    #[test]
+    fn cooldown_is_judged_before_budget() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        assert!(s.decide(&point(0, 2.0), &p).fires);
+        // In both windows at once: the label must be the earlier stage's.
+        assert_eq!(
+            s.decide(&point(30 * MIN, 2.0), &p).suppressed_by,
+            Suppression::Cooldown
+        );
+    }
+
+    #[test]
+    fn budget_window_cap_arithmetic() {
+        assert_eq!(budget_window_cap(Some(1.0)), Some((DAY, 1)));
+        assert_eq!(budget_window_cap(Some(4.0)), Some((DAY, 4)));
+        // floor: the cap must never buy more than the window's own budget.
+        assert_eq!(budget_window_cap(Some(2.5)), Some((DAY, 2)));
+        assert_eq!(budget_window_cap(Some(1.0 / 7.0)), Some((7 * DAY, 1)));
+        assert_eq!(budget_window_cap(Some(0.0)), None);
+        assert_eq!(budget_window_cap(Some(-1.0)), None);
+        assert_eq!(budget_window_cap(Some(f64::NAN)), None);
+        assert_eq!(budget_window_cap(Some(f64::INFINITY)), None);
+        assert_eq!(budget_window_cap(None), None);
+    }
+
+    /// The Phase B gate [pinned]: delivered <= cap in EVERY trailing enforcement window,
+    /// for any flag stream. Deterministic LCG stream so a failure replays exactly.
+    #[test]
+    fn budget_property_delivered_never_exceeds_the_trailing_window_cap() {
+        let mut lcg: u64 = 0x2545F4914F6CDD1D;
+        let mut next = move || {
+            lcg = lcg
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            lcg >> 33
+        };
+        for budget in [1.0 / 7.0, 1.0, 2.5, 4.0] {
+            let (window_us, cap) = budget_window_cap(Some(budget)).unwrap();
+            let p = AlertPolicy {
+                cooldown_secs: 3600,
+                budget_per_day: Some(budget),
+                ..Default::default()
+            };
+            let mut s = AlertState::default();
+            let mut fires: Vec<i64> = Vec::new();
+            // 30 days of 5m buckets, ~40% of them flagged.
+            for i in 0..(30 * 288) {
+                let t = i * 5 * MIN;
+                if next() % 10 < 4 && s.decide(&point(t, 2.0), &p).fires {
+                    fires.push(t);
+                }
+            }
+            assert!(!fires.is_empty(), "the stream must exercise the meter");
+            for (i, &t) in fires.iter().enumerate() {
+                let in_window = fires[..=i]
+                    .iter()
+                    .filter(|&&u| t.saturating_sub(u) <= window_us)
+                    .count();
+                assert!(
+                    in_window <= cap,
+                    "budget {budget}/day: {in_window} deliveries inside one trailing \
+                     window ending {t}us exceeds cap {cap}"
+                );
+            }
+        }
+    }
+}

