+    /// T34: does the level term's steady-state error track the DIURNAL AMPLITUDE under it?
+    #[test]
+    fn t34_level_error_is_swept_against_the_diurnal_amplitude_under_a_fixed_step() {
+        // One half-width's sweep: the varying coordinate, then the BARE and FIT errors.
+        type AmpSweep = (i64, Vec<(f64, f32, f32)>);
+        type PhaseSweep = (i64, Vec<(&'static str, f32, f32)>);
+
+        let hour_us = 3_600_000_000_i64;
+        let bucket_us = hour_us;
+        // 2024-01-01T00:00:00Z is a Monday, so both weekend halves fill.
+        let start_us = 1_704_067_200_000_000_i64;
+        let (pre, post) = (100.0_f64, 200.0_f64);
+        let step = post - pre;
+        // Amplitude as a fraction of the step: base unit 25.0 = a quarter of the 100.0 step.
+        let amp_unit = step / 4.0;
+        // Step at day 10 of 14, so the widest half-width is fed on both sides at the onset.
+        let span_h = 14 * 24_i64;
+        let onset_h = 10 * 24_i64;
+
+        // A step at `onset_h` on a daily swing of `amp` whose peak sits `phase_h` into the day.
+        let build = |amp: f64, phase_h: f64| -> Vec<QueryDataPoint> {
+            (0..span_h)
+                .map(|i| {
+                    let hour_of_day = (i % 24) as f64;
+                    let swing =
+                        amp * (std::f64::consts::TAU * (hour_of_day - phase_h) / 24.0).sin();
+                    let level = if i >= onset_h { post } else { pre };
+                    QueryDataPoint {
+                        timestamp_us: start_us + i * bucket_us,
+                        value: level + swing,
+                        hour: None,
+                        dow: None,
+                    }
+                })
+                .collect()
+        };
+
+        // ARM BARE: the estimator alone, on RAW values — T33's path, seasonality still in.
+        let bare = |amp: f64, phase_h: f64, hw_us: i64| -> f32 {
+            let points = build(amp, phase_h);
+            let ordered: Vec<(i64, f64)> =
+                points.iter().map(|p| (p.timestamp_us, p.value)).collect();
+            let residual: Vec<f64> = ordered.iter().map(|(_, v)| *v).collect();
+            *rolling_median_level(&ordered, &residual, hw_us)
+                .last()
+                .unwrap()
+                - post as f32
+        };
+
+        // The fit recentres on `global`, so the comparable quantity is how far the level MOVED.
+        let fitted = |amp: f64, phase_h: f64, hw_us: i64| -> f32 {
+            let points = build(amp, phase_h);
+            let baseline = SeasonalBaseline::fit(&points, hw_us).expect("the fixture fits");
+            let (_, _, _, trailing) = baseline.params();
+            // Day 5, deep inside the pre-step stretch and a full half-width from the onset.
+            let pre_level = baseline.level_at(start_us + 5 * 24 * bucket_us);
+            (trailing - pre_level) - step as f32
+        };
+
+        let mut report = String::new();
+        let mut amp_rows: Vec<AmpSweep> = Vec::new();
+        for hw_hours in [12_i64, 18, 24] {
+            let hw_us = hw_hours * hour_us;
+            let mut row = Vec::new();
+            for mult in [0.0_f64, 0.25, 0.5, 1.0, 2.0, 4.0] {
+                let amp = mult * amp_unit;
+                // Phase 0 puts the step on a rising midpoint; the phase sweep moves it.
+                let (b, f) = (bare(amp, 0.0, hw_us), fitted(amp, 0.0, hw_us));
+                report.push_str(&format!(
+                    "HW={hw_hours:>2}h amp={amp:>6.2} ({mult:>4.2}x step/4) | \
+                     BARE err {b:+8.2} ({:+6.1}% of step) | FIT err {f:+8.2} ({:+6.1}% of step)\n",
+                    100.0 * b / step as f32,
+                    100.0 * f / step as f32,
+                ));
+                row.push((amp, b, f));
+            }
+            amp_rows.push((hw_hours, row));
+            report.push('\n');
+        }
+
+        // Fixed amplitude, `phase_h` shifting the peak so the step lands at four points.
+        let phase_amp = 4.0 * amp_unit;
+        let mut phase_rows: Vec<PhaseSweep> = Vec::new();
+        for hw_hours in [12_i64, 18, 24] {
+            let hw_us = hw_hours * hour_us;
+            let mut row = Vec::new();
+            for (label, phase_h) in [
+                ("rising-mid", 0.0_f64),
+                ("peak", 6.0),
+                ("falling-mid", 12.0),
+                ("trough", 18.0),
+            ] {
+                let (b, f) = (
+                    bare(phase_amp, phase_h, hw_us),
+                    fitted(phase_amp, phase_h, hw_us),
+                );
+                report.push_str(&format!(
+                    "HW={hw_hours:>2}h amp={phase_amp:>6.2} step lands at {label:<12} | \
+                     BARE err {b:+8.2} | FIT err {f:+8.2}\n"
+                ));
+                row.push((label, b, f));
+            }
+            phase_rows.push((hw_hours, row));
+            report.push('\n');
+        }
+
+        let spread = |v: &[f32]| -> f32 {
+            let (mut lo, mut hi) = (f32::INFINITY, f32::NEG_INFINITY);
+            for x in v {
+                lo = lo.min(*x);
+                hi = hi.max(*x);
+            }
+            hi - lo
+        };
+        let monotone = |v: &[f32]| {
+            v.windows(2).all(|w| w[0] <= w[1] + 1e-3) || v.windows(2).all(|w| w[0] + 1e-3 >= w[1])
+        };
+        let mut summary = String::new();
+        for (hw_hours, row) in &amp_rows {
+            let b: Vec<f32> = row.iter().map(|(_, b, _)| *b).collect();
+            let f: Vec<f32> = row.iter().map(|(_, _, f)| *f).collect();
+            summary.push_str(&format!(
+                "HW={hw_hours:>2}h | BARE monotone in amp: {:<5} spread {:7.2} | \
+                 FIT monotone in amp: {:<5} spread {:7.2}\n",
+                monotone(&b),
+                spread(&b),
+                monotone(&f),
+                spread(&f),
+            ));
+        }
+        for (hw_hours, row) in &phase_rows {
+            let b: Vec<f32> = row.iter().map(|(_, b, _)| *b).collect();
+            let f: Vec<f32> = row.iter().map(|(_, _, f)| *f).collect();
+            summary.push_str(&format!(
+                "HW={hw_hours:>2}h | phase spread — BARE {:7.2} | FIT {:7.2}\n",
+                spread(&b),
+                spread(&f),
+            ));
+        }
+        println!(
+            "T34 level error vs diurnal amplitude, step fixed at {step:.0} \
+             (BARE = rolling_median_level on raw values, FIT = shipped SeasonalBaseline::fit)\n\
+             {report}{summary}"
+        );
+
+        // Pinned, not assumed: if amp=0 is already mis-levelled, every reading above means nothing.
+        for (hw_hours, row) in &amp_rows {
+            let (amp, b, f) = row[0];
+            assert_eq!(
+                amp, 0.0,
+                "the first sweep point must be the no-seasonality control"
+            );
+            assert!(
+                b.abs() <= 1e-3,
+                "with no diurnal swing the bare estimator must land exactly on the post-step \
+                 level at HW={hw_hours}h; error was {b:+.4}"
+            );
+            assert!(
+                f.abs() <= 1e-3,
+                "with no diurnal swing the shipped fit must recover the whole step at \
+                 HW={hw_hours}h; error was {f:+.4}"
+            );
+        }
+        // Read at HW=12h, not the 24h resonance null where both arms read +0.00 at any amplitude.
+        let resonant = &amp_rows
+            .iter()
+            .find(|(hw, _)| *hw == 24)
+            .expect("the sweep runs at HW=24h")
+            .1;
+        for (amp, b, _) in resonant {
+            assert!(
+                b.abs() <= 1e-3,
+                "a 24h half-width spans a whole diurnal period, so the bare estimator must \
+                 median the swing away exactly at every amplitude; at amp={amp:.2} the error \
+                 was {b:+.4}"
+            );
+        }
+        // The null holds under every PHASE: cancellation is a property of the window's span.
+        let resonant_phase = &phase_rows
+            .iter()
+            .find(|(hw, _)| *hw == 24)
+            .expect("the phase sweep runs at HW=24h")
+            .1;
+        for (label, b, _) in resonant_phase {
+            assert!(
+                b.abs() <= 1e-3,
+                "the 24h cancellation cannot depend on phase; with the step landing at \
+                 {label} the bare error was {b:+.4}"
+            );
+        }
+        let twelve = &amp_rows
+            .iter()
+            .find(|(hw, _)| *hw == 12)
+            .expect("the sweep runs at HW=12h")
+            .1;
+        let (_, widest_b, widest_f) = *twelve.last().expect("the sweep has a widest amplitude");
+        assert!(
+            (widest_b - widest_f).abs() > 1.0,
+            "BARE and FIT must differ at HW=12h and the widest amplitude, or the backfit is \
+             not being exercised and the two arms are the same measurement: BARE \
+             {widest_b:+.2} vs FIT {widest_f:+.2}"
+        );
+    }
+
+    /// T42: does TRAINING-WINDOW LENGTH dissolve the step/seasonality confound?
+    #[test]
+    fn t42_training_window_length_is_swept_against_the_step_seasonality_confound() {
+        let hour_us = 3_600_000_000_i64;
+        // 2024-01-01T00:00:00Z is a Monday; `align_days` rotates the window start off it.
+        let monday_us = 1_704_067_200_000_000_i64;
+        let base = 100.0_f64;
+        let step = -60.0_f64;
+        let diurnal_amp = 20.0_f64;
+
+        // A pinned LCG: deterministic, no unpinned RNG, and identical run to run.
+        let noise_at = |seed: u64, i: i64| -> f64 {
+            let mut x = seed
+                .wrapping_mul(6_364_136_223_846_793_005)
+                .wrapping_add(i as u64 ^ 0x9E37_79B9_7F4A_7C15);
+            x ^= x >> 33;
+            x = x.wrapping_mul(0xFF51_AFD7_ED55_8CCD);
+            x ^= x >> 33;
+            // Flat-tailed noise is the harder case for a median-based fit than a Gaussian.
+            ((x >> 11) as f64 / (1_u64 << 53) as f64 * 2.0 - 1.0) * 8.66
+        };
+
+        // Hourly buckets from `align_days` after a Monday, stepped `step_age_days` before the end.
+        let build = |span_days: i64,
+                     step_age_days: i64,
+                     align_days: i64,
+                     contrast: f64,
+                     seed: Option<u64>|
+         -> (Vec<(i64, f64)>, i64) {
+            let start_us = monday_us + align_days * 24 * hour_us;
+            let n = span_days * 24;
+            let onset = (span_days - step_age_days) * 24;
+            let series = (0..n)
+                .map(|i| {
+                    let ts = start_us + i * hour_us;
+                    let phase = (i % 24) as f64 / 24.0 * std::f64::consts::TAU;
+                    let weekend = f64::from(seasonal_cell(ts) >= BASELINE_HOURS_PER_DAY);
+                    let value = base
+                        + diurnal_amp * phase.sin()
+                        + contrast * weekend
+                        + if i >= onset { step } else { 0.0 }
+                        + seed.map_or(0.0, |s| noise_at(s, i));
+                    (ts, value)
+                })
+                .collect();
+            (series, start_us + n * hour_us)
+        };
+
+        // Mirrors `fit` with the `seasonal` gate forced true, over the production helpers.
+        let fit_cells_on = |ordered: &[(i64, f64)]| -> (Vec<Option<f32>>, [f32; 2], f32, f32) {
+            let mut all: Vec<f64> = ordered.iter().map(|(_, v)| *v).collect();
+            let global = median_of(&mut all).expect("the fixture is non-empty") as f32;
+            let mut cells: Vec<Option<f32>> = vec![None; BASELINE_CELLS];
+            let mut weekend_half = [global; 2];
+            let mut levels: Vec<f32> = vec![0.0; ordered.len()];
+            for _ in 0..BASELINE_FIT_MAX_PASSES {
+                let deleveled: Vec<(i64, f64)> = ordered
+                    .iter()
+                    .zip(levels.iter())
+                    .map(|((ts, v), lvl)| (*ts, v - *lvl as f64))
+                    .collect();
+                let fitted = fit_seasonal_cells(&deleveled, global);
+                cells = fitted.0;
+                weekend_half = fitted.1;
+                let deseasonalized: Vec<f64> = ordered
+                    .iter()
+                    .map(|(ts, v)| {
+                        v - cell_offset(&cells, &weekend_half, global, seasonal_cell(*ts)) as f64
+                    })
+                    .collect();
+                let next =
+                    rolling_median_level(ordered, &deseasonalized, DEFAULT_LEVEL_HALF_WIDTH_US);
+                let moved = next
+                    .iter()
+                    .zip(levels.iter())
+                    .map(|(a, b)| (a - b).abs() as f64)
+                    .fold(0.0_f64, f64::max);
+                levels = next;
+                if moved <= BASELINE_FIT_TOLERANCE * (global.abs() as f64).max(f64::MIN_POSITIVE) {
+                    break;
+                }
+            }
+            let trailing = *levels.last().expect("the fixture is non-empty");
+            (cells, weekend_half, global, trailing)
+        };
+
+        // An unbiased baseline returns exactly `global` here, so this reads 0.
+        let displacement = |ordered: &[(i64, f64)],
+                            window_end_us: i64,
+                            contrast: f64,
+                            want_weekend: bool|
+         -> f64 {
+            let (cells, weekend_half, global, trailing) = fit_cells_on(ordered);
+            // Walk forward to the first post-window day of the wanted class.
+            let day = (0..14)
+                .map(|d| window_end_us + d * 24 * hour_us)
+                .find(|ts| (seasonal_cell(*ts) >= BASELINE_HOURS_PER_DAY) == want_weekend)
+                .expect("a fortnight past the window holds both classes");
+            let total: f64 = (0..24)
+                .map(|h| {
+                    let ts = day + h * hour_us;
+                    let phase = (h % 24) as f64 / 24.0 * std::f64::consts::TAU;
+                    let weekend = f64::from(seasonal_cell(ts) >= BASELINE_HOURS_PER_DAY);
+                    // The TRUE post-step value: the series continues normally past the window.
+                    let truth = base + diurnal_amp * phase.sin() + contrast * weekend + step;
+                    let seasonal = cell_offset(&cells, &weekend_half, global, seasonal_cell(ts));
+                    truth - seasonal as f64 - trailing as f64 + global as f64
+                })
+                .sum();
+            total / 24.0 - global as f64
+        };
+
+        let seeds = [11_u64, 22, 33];
+        let mut report = String::new();
+        // (window_days, step_age_days, contrast) -> worst |weekday displacement|.
+        let mut worst: Vec<(i64, i64, f64, f64)> = Vec::new();
+
+        for step_age_days in [2_i64, 4] {
+            for window_days in [14_i64, 17, 21, 24, 28] {
+                for contrast in [0.0_f64, -35.0] {
+                    let mut peak = 0.0_f64;
+                    let mut peak_align = 0_i64;
+                    for align_days in 0..7_i64 {
+                        for seed in seeds {
+                            let (ordered, end) =
+                                build(window_days, step_age_days, align_days, contrast, Some(seed));
+                            let d = displacement(&ordered, end, contrast, false).abs();
+                            if d > peak {
+                                peak = d;
+                                peak_align = align_days;
+                            }
+                        }
+                    }
+                    report.push_str(&format!(
+                        "step {step_age_days}d old | window {window_days:>2}d | contrast \
+                         {contrast:>6.1} | WORST |weekday displacement| {peak:>8.3} \
+                         (align +{peak_align}d)\n"
+                    ));
+                    worst.push((window_days, step_age_days, contrast, peak));
+                }
+                report.push('\n');
+            }
+        }
+
+        // The alignment is SEARCHED, since a fixed one leaves identified cases wearing the label.
+        let post_step_weekdays = |ordered: &[(i64, f64)], end: i64, step_age_days: i64| -> usize {
+            ordered
+                .iter()
+                .filter(|(ts, _)| {
+                    *ts >= end - step_age_days * 24 * hour_us
+                        && seasonal_cell(*ts) < BASELINE_HOURS_PER_DAY
+                })
+                .count()
+        };
+        let mut unidentified = String::new();
+        let mut unidentified_worst = 0.0_f64;
+        // Recorded per EMITTED row: a fresh search would pass even if the rows were mislabelled.
+        let mut unidentified_rows: Vec<(i64, i64, usize)> = Vec::new();
+        for window_days in [14_i64, 17, 21, 24, 28] {
+            let Some(align_days) = (0..7_i64).find(|a| {
+                let (ordered, end) = build(window_days, 2, *a, 0.0, Some(11));
+                post_step_weekdays(&ordered, end, 2) == 0
+            }) else {
+                unidentified.push_str(&format!(
+                    "window {window_days:>2}d | NO alignment leaves a weekend-only tail\n"
+                ));
+                continue;
+            };
+            let (ordered, end) = build(window_days, 2, align_days, 0.0, Some(11));
+            let post = post_step_weekdays(&ordered, end, 2);
+            let d = displacement(&ordered, end, 0.0, false);
+            unidentified_worst = unidentified_worst.max(d.abs());
+            unidentified_rows.push((window_days, align_days, post));
+            unidentified.push_str(&format!(
+                "window {window_days:>2}d | align +{align_days}d | post-step WEEKDAY buckets \
+                 {post:>3} | weekday displacement {d:+8.3}\n"
+            ));
+        }
+
+        // A longer window buying the fix by destroying genuine weekly seasonality is a regression.
+        let mut survival = String::new();
+        let mut carried: Vec<(i64, f64)> = Vec::new();
+        for window_days in [14_i64, 17, 21, 24, 28] {
+            let n = window_days * 24;
+            let ordered: Vec<(i64, f64)> = (0..n)
+                .map(|i| {
+                    let ts = monday_us + i * hour_us;
+                    let phase = (i % 24) as f64 / 24.0 * std::f64::consts::TAU;
+                    let weekend = f64::from(seasonal_cell(ts) >= BASELINE_HOURS_PER_DAY);
+                    (
+                        ts,
+                        base + diurnal_amp * phase.sin() - 35.0 * weekend + noise_at(11, i),
+                    )
+                })
+                .collect();
+            let (cells, weekend_half, global, _) = fit_cells_on(&ordered);
+            // The fitted contrast: mean weekend cell minus mean weekday cell, at a matched hour.
+            let mean_half = |weekend: bool| -> f64 {
+                let offset = usize::from(weekend) * BASELINE_HOURS_PER_DAY;
+                (0..BASELINE_HOURS_PER_DAY)
+                    .map(|h| cell_offset(&cells, &weekend_half, global, offset + h) as f64)
+                    .sum::<f64>()
+                    / BASELINE_HOURS_PER_DAY as f64
+            };
+            let fitted_contrast = mean_half(true) - mean_half(false);
+            carried.push((window_days, fitted_contrast));
+            survival.push_str(&format!(
+                "window {window_days:>2}d | true contrast  -35.000 | fitted {fitted_contrast:+8.3} \
+                 | carried {:>6.1}%\n",
+                100.0 * fitted_contrast / -35.0
+            ));
+        }
+
+        // Censuses the cells the two MIN_CELL_SAMPLES rules disagree about, since it is private.
+        let mut samples_census = String::new();
+        for window_days in [14_i64, 17, 21, 24, 28] {
+            let (ordered, _) = build(window_days, 2, 0, 0.0, Some(11));
+            let mut buckets: Vec<usize> = vec![0; BASELINE_CELLS];
+            for (ts, _) in &ordered {
+                buckets[seasonal_cell(*ts)] += 1;
+            }
+            // The shipped ladder pools 1 then 2 hours until every group clears the floor.
+            let width_for = |half: usize, floor: usize| -> usize {
+                (1..=2_usize)
+                    .find(|width| {
+                        (0..BASELINE_HOURS_PER_DAY).step_by(*width).all(|start| {
+                            buckets[half * BASELINE_HOURS_PER_DAY + start..]
+                                .iter()
+                                .take(*width)
+                                .sum::<usize>()
+                                >= floor
+                        })
+                    })
+                    .unwrap_or(2)
+            };
+            let alive = |floor: usize| -> usize {
+                (0..BASELINE_CELLS)
+                    .filter(|cell| {
+                        let half = cell / BASELINE_HOURS_PER_DAY;
+                        let width = width_for(half, floor);
+                        let hour = cell % BASELINE_HOURS_PER_DAY;
+                        let group = hour - hour % width;
+                        buckets[half * BASELINE_HOURS_PER_DAY + group..]
+                            .iter()
+                            .take(width.min(BASELINE_HOURS_PER_DAY - group))
+                            .sum::<usize>()
+                            >= floor
+                    })
+                    .count()
+            };
+            let at3 = alive(MIN_CELL_SAMPLES);
+            let at4 = alive(4);
+            samples_census.push_str(&format!(
+                "window {window_days:>2}d | cells alive at floor 3 (shipped) {at3:>3}/48 | at \
+                 floor 4 (T38 port) {at4:>3}/48 | cells the port would drop {:>3}\n",
+                at3.saturating_sub(at4)
+            ));
+        }
+
+        println!(
+            "T42 training-window length vs the step/seasonality confound (cells-ON arm)\n\
+             worst case over 7 window-start alignments x 3 pinned seeds\n\n\
+             {report}\
+             UNIDENTIFIED CASE — zero post-step weekday buckets (reported separately, never \
+             averaged into the sweep above)\n{unidentified}\n\
+             REAL WEEKLY CONTRAST SURVIVAL — no step, true contrast -35\n{survival}\n\
+             MIN_CELL_SAMPLES — shipped Rust floor is 3, the T38 Python port used 4\n\
+             {samples_census}\n\
+             T38 Python port, for comparison (step 2d old): 14d 24.584 | 17d 2.845 | 21d 2.586\n\
+             T38 Python port, step 4d old:                  14d 10.543 | 17d 2.202 | 21d 1.550"
+        );
+
+        // The confound must be PRESENT at 14d, or every later row is trivially small.
+        let at = |w: i64, age: i64, c: f64| -> f64 {
+            worst
+                .iter()
+                .find(|(ww, aa, cc, _)| *ww == w && *aa == age && (*cc - c).abs() < 1e-9)
+                .expect("the sweep covers this cell")
+                .3
+        };
+        assert!(
+            at(14, 2, 0.0) > 5.0,
+            "the confound must be present at the shipped 14d window or there is nothing to \
+             sweep: worst weekday displacement was {:.3}, and every longer window would then \
+             be trivially 'better'",
+            at(14, 2, 0.0)
+        );
+
+        // With cells OFF the fitted contrast is exactly 0, so a non-zero one proves cells-ON.
+        let (_, widest_contrast) = *carried.last().expect("the survival sweep ran");
+        assert!(
+            widest_contrast.abs() > 1.0,
+            "the cells-ON arm must actually fit cells — a fitted weekly contrast of {:.3} means \
+             the cells are empty and this measured the gate, not the confound",
+            widest_contrast
+        );
+
+        // A row with post-step weekday buckets is an ordinary case wearing the label.
+        assert!(
+            !unidentified_rows.is_empty(),
+            "no window length produced a weekend-only tail, so the unidentified regime was never \
+             measured and the section below the sweep reports nothing"
+        );
+        for (window_days, align_days, post) in &unidentified_rows {
+            assert_eq!(
+                *post, 0,
+                "the {window_days}d row (align +{align_days}d) was REPORTED as unidentified while \
+                 holding {post} post-step weekday buckets — that is an ordinary identified case \
+                 wearing the label, which is exactly what a fixed alignment produces"
+            );
+        }
+
+        // It must stay LARGE at 14d, or a longer window would look like a total fix.
+        assert!(
+            unidentified_worst > 5.0,
+            "the unidentified regime must carry a real displacement or reporting it separately \
+             is pointless: worst was {unidentified_worst:.3}"
+        );
+    }
+
+    /// The reading is only worth computing if it reaches an operator, and for years it did not.
+    #[test]
+    fn the_unresolved_level_notice_states_the_consequence_and_the_honest_remedy() {
+        // The consequence, not the internals: the level is HELD for every later bucket.
+        assert!(
+            UNRESOLVED_LEVEL_NOTICE.contains("held flat")
+                && UNRESOLVED_LEVEL_NOTICE.contains("until the next retrain"),
+            "the notice must say the level is held for every scored bucket: \
+             {UNRESOLVED_LEVEL_NOTICE}"
+        );
+
+        // Not a promise that retraining fixes it: an immediate retrain reads the same ambiguity.
+        assert!(
+            UNRESOLVED_LEVEL_REMEDY.contains("ages past"),
+            "the remedy must say it resolves by aging out: {UNRESOLVED_LEVEL_REMEDY}"
+        );
+        assert!(
+            UNRESOLVED_LEVEL_REMEDY.contains("provisional"),
+            "the remedy must tell the operator how to read this model meanwhile: \
+             {UNRESOLVED_LEVEL_REMEDY}"
+        );
+    }
+
+    /// A step exactly half a level-window old splits the trailing window evenly.
+    #[test]
+    fn a_step_half_a_level_window_old_clears_the_share_floor_it_is_reported_against() {
+        let bucket_us = 30 * 60 * 1_000_000_i64;
+        let start_us = 1_700_000_000_000_000_i64;
+        let buckets = 1008_i64;
+        // Jitter, not an alternating offset: two values leave no scatter and ANY split separates.
+        let jitter = |i: i64| ((i * 2_654_435_761) % 1_000) as f64 / 1_000.0 - 0.5;
+        let series = |age_hours: f64| -> Vec<(i64, f64)> {
+            let onset = (buckets - 1) as f64 * 0.5 - age_hours;
+            (0..buckets)
+                .map(|i| {
+                    let hours = i as f64 * 0.5;
+                    let base = if hours >= onset { 65.0 } else { 100.0 };
+                    (start_us + i * bucket_us, base + 4.0 * jitter(i))
+                })
+                .collect()
+        };
+        let read = |ordered: &[(i64, f64)]| {
+            trailing_knot_is_unresolved(
+                ordered,
+                &vec![None; BASELINE_CELLS],
+                &[100.0; 2],
+                100.0,
+                DEFAULT_LEVEL_HALF_WIDTH_US,
+            )
+        };
+        let split =
+            read(&series(12.0)).expect("a step half a level window old is the unresolved case");
+
+        let share = split.past_break as f64 / split.window as f64;
+        assert!(
+            share >= MIN_UNRESOLVED_SHARE,
+            "share {share} must clear the {MIN_UNRESOLVED_SHARE} floor it is reported against"
+        );
+        assert!(
+            split.separation >= MIN_UNRESOLVED_SEPARATION,
+            "separation {} must clear the {MIN_UNRESOLVED_SEPARATION} floor",
+            split.separation
+        );
+        // An even split is the worst case, and it is what this geometry produces.
+        assert!(
+            (share - 0.5).abs() < 0.1,
+            "a step at half the window should split it near evenly, got {share}"
+        );
+
+        // Without this the assertions above would hold for a rule that fires on every series.
+        for resolved_age in [40.0_f64, 72.0] {
+            assert!(
+                read(&series(resolved_age)).is_none(),
+                "a step aged {resolved_age}h has aged out of the window and must not be reported"
+            );
+        }
+        // And a step that has barely started is equally resolved, from the other side.
+        assert!(
+            read(&series(2.0)).is_none(),
+            "a step aged 2h holds far too little of the window to be near flipping it"
+        );
+    }
 }
