+export function formatDuration(value: number, unit: "ms" | "s"): string {
+  if (unit === "ms") return Math.round(value).toLocaleString();
+  const seconds = value / SECOND_MS;
+  return seconds.toFixed(seconds >= 10 ? 1 : 2);
