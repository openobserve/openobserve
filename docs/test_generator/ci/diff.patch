+        let seasonal = trending_daily_points(14 * 24);
+        let fitted_seasonal = SeasonalBaseline::fit(&seasonal, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a daily sine must fit cells");
+        let (seasonal_cells, ..) = fitted_seasonal.params();
