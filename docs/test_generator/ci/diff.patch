+      const action = vi.mocked(toast).mock.calls.at(-1)![0].action!;
+      action.handler();
+      expect(push).toHaveBeenLastCalledWith(
+        expect.objectContaining({
+          params: { report_id: RUN.report_id },
+          query: expect.objectContaining({ org_identifier: orgA }),
+        }),
+      );
+    },
+  );
