+
+  it("keeps a query at exactly the limit", () => {
+    expect(truncateQuery("a".repeat(100))).toBe("a".repeat(100));
+  });
+
+  it("ellipsises past the limit", () => {
+    expect(truncateQuery("a".repeat(101))).toBe("a".repeat(100) + "...");
+  });
+});
