+      expect(issueAt(tiers, ["tiers", 1, "rules", 7, "keys"])).toBe("");
+      expect(issueAt(tiers, ["tiers", 1, "rules", 8, "keys"])).toContain("at most 8");
+    });
+
+    it("allows at most 16 keys and 64 values per rule", () => {
