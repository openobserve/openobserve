+    }
+
+    // A nested record must satisfy a saved flat-key condition end to end.
+    #[tokio::test]
+    async fn test_evaluate_condition_matches_nested_record_via_flat_key() {
+        let row = match serde_json::json!({
+            "meta": {"alert_count": 50, "alert_name": "verify"},
+            "data": []
+        }) {
+            Value::Object(m) => m,
+            _ => unreachable!(),
+        };
+
+        assert!(
+            evaluate_condition(
+                &row,
+                "meta_alert_count",
+                &Operator::EqualTo,
+                &Value::from(50),
+                false
+            )
