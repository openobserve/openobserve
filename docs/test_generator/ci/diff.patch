+            for (guard, what) in [
+                ("match i.venue {", "the §8.2 venue gate"),
+                (r#"if i.error_source == "queue" {"#, "the E11 queue guard"),
+            ] {
+                let guard_at = body.find(guard).unwrap_or_else(|| panic!("{what} is gone"));
+                assert!(
