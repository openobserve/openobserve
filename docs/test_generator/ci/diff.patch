+            "wait_event",
+            "wait_event_type",
+            "db_system",
+            "db_instance",
+            "db_namespace",
+        ] {
+            assert!(
+                dto.get(wire).is_some(),
+                "the DTO must expose `{wire}`, got: {dto}"
+            );
+        }
+        let rendered = dto.to_string();
+        assert!(
+            !rendered.contains("o2_dbm_"),
+            "no storage name may reach the browser: {rendered}"
