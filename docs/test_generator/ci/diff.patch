index 000000000000..50bb07ef1f86
--- /dev/null
+++ b/web/src/components/reports/ReportRunNowDialog.vue
@@ -0,0 +1,165 @@
+<!-- Copyright 2026 OpenObserve Inc.
+
+This program is free software: you can redistribute it and/or modify
