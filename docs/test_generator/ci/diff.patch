+      expect(summaryCalls).toBe(1);
+    });
+
+    it("skips the summary call entirely when isDataIngested is already known true", async () => {
+      let summaryCalls = 0;
+      global.server.use(
+        http.get(SUMMARY_URL, () => {
+          summaryCalls += 1;
