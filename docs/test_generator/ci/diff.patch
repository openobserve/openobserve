+            cooldown_secs: 3600,
+            ..Default::default()
+        };
+        let mut s = AlertState {
+            last_fired_us: Some(0),
+            ..Default::default()
+        };
+        assert!(
+            s.decide(&point(HOUR + 900_000, 2.0), &p).fires,
+            "3600.9s elapsed is outside a 3600s window and must deliver"
+        );
+    }
+
+    /// The headline regression: an hourly cadence must halve, not pass through whole.
+    #[test]
+    fn an_hourly_cadence_is_actually_thinned() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        let delivered = (0..24)
+            .filter(|i| s.decide(&point(i * HOUR, 2.0), &p).fires)
+            .count();
+        assert_eq!(
+            delivered, 12,
+            "24 consecutive hourly flagged runs must deliver 12 alerts, not 24"
+        );
+    }
+
+    #[test]
+    fn a_sub_hourly_cadence_is_thinned() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        let step = 5 * MIN;
+        let delivered = (0..288)
+            .filter(|i| s.decide(&point(i * step, 2.0), &p).fires)
+            .count();
+        assert_eq!(
+            delivered, 23,
+            "a 5m cadence over a day must deliver 23 alerts under a closed 1h window"
+        );
+    }
+
+    #[test]
+    fn a_multi_hour_cadence_is_unaffected() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        let delivered = (0..12)
+            .filter(|i| s.decide(&point(i * 2 * HOUR, 2.0), &p).fires)
+            .count();
+        assert_eq!(
+            delivered, 12,
+            "spacing wider than the cooldown must never be suppressed"
+        );
+    }
+
+    /// At most one alert per closed cooldown window, which is what the cooldown claims.
+    #[test]
+    fn at_most_one_alert_lands_in_any_closed_cooldown_window() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        let step = 5 * MIN;
+        let fires: Vec<i64> = (0..288)
+            .map(|i| i * step)
+            .filter(|t| s.decide(&point(*t, 2.0), &p).fires)
+            .collect();
+        for w in fires.windows(2) {
+            assert!(
+                w[1] - w[0] > HOUR,
+                "consecutive delivered alerts were {}us apart, inside the window",
+                w[1] - w[0]
+            );
+        }
+    }
+
+    /// A huge configured cooldown must saturate rather than overflow the microsecond scale.
+    #[test]
+    fn an_enormous_cooldown_does_not_overflow() {
+        let p = AlertPolicy {
+            cooldown_secs: i64::MAX,
+            ..Default::default()
+        };
+        let mut s = AlertState {
+            last_fired_us: Some(0),
+            ..Default::default()
+        };
+        assert_eq!(
+            s.decide(&point(HOUR, 2.0), &p).suppressed_by,
+            Suppression::Cooldown
+        );
+    }
+
+    // ── Budget meter (Phase B Layer 1) ──────────────────────────────────────
+
+    const DAY: i64 = 24 * HOUR;
+
+    /// Every fire's data-time from a saturated stream of over-bar points.
+    fn delivered_times(step_us: i64, until_us: i64, policy: &AlertPolicy) -> Vec<i64> {
+        let mut s = AlertState::default();
+        (0..)
+            .map(|i| i * step_us)
+            .take_while(|t| *t < until_us)
+            .filter(|t| s.decide(&point(*t, 2.0), policy).fires)
+            .collect()
+    }
+
+    #[test]
+    fn a_budgetless_policy_ignores_a_seeded_spend_log() {
+        let mut s = AlertState {
+            last_fired_us: None,
+            recent_delivered_us: vec![0, MIN],
+        };
+        assert!(
+            s.decide(&point(2 * MIN, 2.0), &AlertPolicy::default())
+                .fires,
+            "with no budget the spend log must be inert - the exact pre-budget behaviour"
+        );
+    }
+
+    #[test]
+    fn budget_one_per_day_thins_a_saturated_5m_stream_to_one_a_day() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        let fires = delivered_times(5 * MIN, 7 * DAY, &p);
+        assert_eq!(
+            fires.len(),
+            7,
+            "7 days of a permanently-flagging 5m stream must deliver 7 alerts, got {fires:?}"
+        );
+        for w in fires.windows(2) {
+            assert!(
+                w[1] - w[0] > DAY,
+                "consecutive deliveries {}us apart breach the trailing-day window",
+                w[1] - w[0]
+            );
+        }
+    }
+
+    #[test]
+    fn budget_enforces_without_any_cooldown() {
+        let p = AlertPolicy {
+            cooldown_secs: 0,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        assert_eq!(
+            delivered_times(5 * MIN, 3 * DAY, &p).len(),
+            3,
+            "the budget stage must thin on its own; cooldown 0 previously meant no thinning"
+        );
+    }
+
+    #[test]
+    fn a_weekly_budget_delivers_once_per_trailing_week() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            budget_per_day: Some(1.0 / 7.0),
+            ..Default::default()
+        };
+        let fires = delivered_times(5 * MIN, 21 * DAY, &p);
+        assert_eq!(fires.len(), 3, "3 weeks must buy 3 alerts, got {fires:?}");
+        for w in fires.windows(2) {
+            assert!(w[1] - w[0] > 7 * DAY);
+        }
+    }
+
+    /// The cap is floor(budget) per trailing day, so an incident CLUSTER spends up to the
+    /// whole day's budget quickly - the design's not-starved requirement - then stops.
+    #[test]
+    fn budget_four_per_day_allows_a_cluster_then_caps_the_day() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            budget_per_day: Some(4.0),
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        let step = 61 * MIN;
+        let mut delivered_in_first_day = 0;
+        let mut fifth: Option<AlertDecision> = None;
+        for i in 0..24 {
+            let d = s.decide(&point(i * step, 2.0), &p);
+            if d.fires {
+                delivered_in_first_day += 1;
+            } else if fifth.is_none() {
+                fifth = Some(d);
+            }
+        }
+        assert_eq!(delivered_in_first_day, 4, "the cluster must spend all 4");
+        assert_eq!(
+            fifth
+                .expect("a 5th candidate must have been suppressed")
+                .suppressed_by,
+            Suppression::Budget
+        );
+    }
+
+    /// floor, never round: 2.5/day must cap at 2, or a trailing day could hold 3 > 2.5.
+    #[test]
+    fn a_fractional_budget_caps_at_its_floor() {
+        let p = AlertPolicy {
+            cooldown_secs: 3600,
+            budget_per_day: Some(2.5),
+            ..Default::default()
+        };
+        let fires = delivered_times(2 * HOUR, DAY, &p);
+        assert_eq!(fires.len(), 2, "got {fires:?}");
+    }
+
+    #[test]
+    fn a_budget_suppressed_point_does_not_move_the_anchor_or_the_log() {
+        let p = AlertPolicy {
+            cooldown_secs: 0,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        let mut s = AlertState::default();
+        assert!(s.decide(&point(0, 2.0), &p).fires);
+        let d = s.decide(&point(HOUR, 2.0), &p);
+        assert_eq!(d.suppressed_by, Suppression::Budget);
+        assert_eq!(
+            s.last_fired_us,
+            Some(0),
+            "a refused point must not arm the cooldown"
+        );
+        assert_eq!(
+            s.recent_delivered_us,
+            vec![0],
+            "a refused point buys nothing"
+        );
+    }
+
+    /// The scheduler seeds the log from the persisted anchor, so a restart cannot re-spend.
+    #[test]
+    fn a_seeded_spend_log_suppresses_after_a_restart() {
+        let p = AlertPolicy {
+            cooldown_secs: 0,
+            budget_per_day: Some(1.0),
+            ..Default::default()
+        };
+        let mut s = AlertState {
+            last_fired_us: Some(0),
+            recent_delivered_us: vec![0],
+        };
