+            q.sql
+                .contains("approx_percentile_cont(duration_ms, 0.95) AS zo_slo_value"),
+            "{}",
+            q.sql
+        );
+        assert_eq!(q.start_micros, 1_200 * 1_000_000);
+        assert_eq!(q.end_micros, 2_100 * 1_000_000);
+    }
