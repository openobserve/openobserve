+    let mut ctx = PricingContext::known();
+    let keys = definition.rule_attribute_keys();
+    if !keys.is_empty() {
+        ctx.extend_json("", span_attributes, Some(&keys));
+        ctx.extend_json_mapped(
+            "resource.",
+            resource_attributes,
+            Some(&keys),
