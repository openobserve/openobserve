+/// Warm-up, mismatch and quiet verdicts are terminal for this grid, so they never hold.
+pub fn undecided_absence_hold_us(input: &AbsenceInput, policy: &AbsencePolicy) -> Option<i64> {
+    if !policy.enabled {
+        return None;
+    }
+    let grid = closed_grid(input);
+    let returned: HashSet<i64> = input.returned_buckets_us.iter().copied().collect();
+    let missing: Vec<i64> = grid
+        .iter()
+        .copied()
+        .filter(|b| !returned.contains(b))
+        .collect();
+    if missing.is_empty() {
+        return None;
+    }
+    let presence = usable_presence(&input.profile, policy)?;
+    if is_interval_mismatch(input, presence, policy) {
+        return None;
+    }
+    let busy_grid: Vec<i64> = grid
+        .iter()
+        .copied()
+        .filter(|b| is_alertable_slot(*b, &input.profile, policy))
+        .collect();
+    let busy_missing: Vec<i64> = missing
+        .iter()
+        .copied()
+        .filter(|b| is_alertable_slot(*b, &input.profile, policy))
+        .collect();
+    let edge = settled_edge_run(&busy_grid, &busy_missing, &input.returned_buckets_us);
+    if edge == 0 {
+        return None;
+    }
+    let start = busy_grid[busy_grid.len() - edge];
+    let fires = edge >= policy.min_missing_buckets
+        && edge_outlasts_allowance(
+            &grid,
+            start,
+            input.interval_us,
+            input.window_cap_us,
+            policy.edge_settle_seconds,
+        );
+    (!fires).then_some(start)
