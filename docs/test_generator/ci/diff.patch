+/// a synthetics step does not — and NOT by org, since org ids are
+/// customer-chosen. This only COUNTS the loss; §11 **F8** is still open.
+fn record_flush_drop(
+    org_id: &str,
+    feature: TrialQuotaFeature,
+    cost: i64,
+    error: &dyn std::fmt::Display,
