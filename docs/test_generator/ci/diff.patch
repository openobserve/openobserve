+    graded_until_us: i64,
+) -> Result<()> {
+    let s3_key = graded_until_key(org_id, config_id);
+    infra::storage::put(
+        org_id,
+        &s3_key,
+        Bytes::from(encode_graded_until(interval_us, graded_until_us)),
+    )
