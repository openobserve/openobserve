+/// Seasonal cells per day: one per hour. Paired with the weekend flag this gives 48 cells.
+const BASELINE_HOURS_PER_DAY: usize = 24;
+
+/// Hour-of-week is too thin at the shipped width: ~2 samples a cell, so one anomaly drags it.
+const BASELINE_CELLS: usize = BASELINE_HOURS_PER_DAY * 2;
+
+/// Samples a cell needs before its own median is trusted rather than a wider pooled one.
+const MIN_CELL_SAMPLES: usize = 3;
+
+/// Default half-width of the local level window, in microseconds (one day each side).
+pub const DEFAULT_LEVEL_HALF_WIDTH_US: i64 = 86_400_000_000;
+
+/// Below two per side the centred median IS the point and the fitted residual collapses to 0.
+const MIN_LEVEL_BUCKETS_PER_SIDE: i64 = 2;
+
+/// Without it a fine cadence fits a level so short it eats the signal, not the drift.
+const MIN_LEVEL_HALF_WIDTH_US: i64 = 3_600_000_000;
+
+/// A centred window must fit twice inside its training data, or it truncates at most buckets.
+const MAX_LEVEL_WINDOW_SHARE_OF_TRAINING: i64 = 4;
+
+/// Hard cap on the backfitting passes, so a series that never contracts still terminates.
+const BASELINE_FIT_MAX_PASSES: usize = 12;
+
+/// Bounds the blob: neither `training_window_days` nor `histogram_interval` has a ceiling.
+const MAX_LEVEL_KNOTS: usize = 2048;
+
+/// Not zero: medians can shuffle which sample sits at the middle and move the fit forever.
+const BASELINE_FIT_TOLERANCE: f64 = 1e-3;
+
+/// Below this, the 48 cells are fitting sampling noise and subtracting them manufactures it.
+const MIN_SEASONAL_STRENGTH: f64 = 2.0;
+
+/// Four: two points a side for any scatter, and higher would mute coarse cadences entirely.
+const MIN_UNRESOLVED_WINDOW: usize = 4;
+
+/// Sits in the gap between an about-to-flip trailing median and every clean shape.
+const MIN_UNRESOLVED_SEPARATION: f64 = 6.0;
+
+/// Without it a single outlying bucket reads as a whole regime.
+const MIN_UNRESOLVED_SHARE: f64 = 0.35;
+
+/// The level is held flat until the next retrain, so a knot on the wrong side displaces all of it.
+pub(crate) const UNRESOLVED_LEVEL_NOTICE: &str = "Trailing level is unresolved: a level break splits the last window evenly enough that \
+     the fitted level may carry either side of it, and that level is held flat for every \
+     bucket scored until the next retrain.";
+
+/// Deliberately not a promise that retraining fixes it: at the window edge the cases are identical.
+pub(crate) const UNRESOLVED_LEVEL_REMEDY: &str = "No estimator can resolve this while the break is still at the edge of its window. It \
+     resolves on its own once the break ages past half the level window; until then, treat \
+     this model's level — and any threshold fitted on it — as provisional.";
+
+/// Not the median: a mostly-flat shape's median reads its flat majority, not its swing.
+const SEASONAL_SPREAD_QUANTILE: f64 = 0.75;
+
+/// Medians throughout, because the training data is fitted with its anomalies still in it.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct SeasonalBaseline {
+    /// Indexed `weekend * 24 + hour`. `None` falls back to a wider pooled offset.
+    cells: Vec<Option<f32>>,
+    /// Pooled offset for each weekend half, used when a cell is too thin to trust.
+    weekend_half: [f32; 2],
+    /// Offset of last resort, over every training bucket.
+    global: f32,
+    /// Held flat past the window: its error is bounded by how far the level actually moved.
+    trailing_level: f32,
+    /// Ascending, so a re-scored training bucket is judged against the level that held then.
+    level_knots: Vec<(i64, f32)>,
+}
+
+impl SeasonalBaseline {
+    /// `None` when there is nothing to fit, in which case the caller scores raw values.
+    pub fn fit(points: &[QueryDataPoint], half_width_us: i64) -> Option<Self> {
+        let mut ordered: Vec<(i64, f64)> = points
+            .iter()
+            .filter(|p| p.value.is_finite())
+            .map(|p| (p.timestamp_us, p.value))
+            .collect();
+        if ordered.is_empty() {
+            return None;
+        }
+        ordered.sort_by_key(|(ts, _)| *ts);
+
+        let mut all: Vec<f64> = ordered.iter().map(|(_, v)| *v).collect();
+        // Finite inputs still overflow: the even median averages two and the f32 cast saturates.
+        let global = match median_of(&mut all) {
+            Some(m) if (m as f32).is_finite() => m as f32,
+            _ => {
+                tracing::warn!(
+                    buckets = ordered.len(),
+                    "Series magnitude overflows the baseline's f32 offsets; scoring raw values"
+                );
+                return None;
+            }
+        };
+        let mut cells: Vec<Option<f32>> = vec![None; BASELINE_CELLS];
+        let mut weekend_half = [global; 2];
+        let mut levels: Vec<f32> = vec![0.0; ordered.len()];
+        // Cells indistinguishable from within-cell scatter hand the forest a manufactured signal.
+        let seasonal = seasonal_strength(&ordered) >= MIN_SEASONAL_STRENGTH;
+        if !seasonal {
+            tracing::debug!(
+                strength = seasonal_strength(&ordered),
+                floor = MIN_SEASONAL_STRENGTH,
+                buckets = ordered.len(),
+                "Series carries no usable seasonality; the baseline keeps only its level term"
+            );
+        } else {
+            // Only visible here: a far-from-UTC tenant's weekend splits across both halves.
+            tracing::debug!(
+                buckets = ordered.len(),
+                "Seasonal cells are binned on the UTC hour and UTC weekend; a tenant whose \
+                 local week is offset from UTC gets a weaker weekday/weekend contrast"
+            );
+        }
+
+        // The terms are confounded, so each pass re-fits one against the RAW series.
+        let mut converged_moved = None;
+        for _ in 0..BASELINE_FIT_MAX_PASSES {
+            let deleveled: Vec<(i64, f64)> = ordered
+                .iter()
+                .zip(levels.iter())
+                .map(|((ts, v), lvl)| (*ts, v - *lvl as f64))
+                .collect();
+            if seasonal {
+                let fitted = fit_seasonal_cells(&deleveled, global);
+                cells = fitted.0;
+                weekend_half = fitted.1;
+            }
+            let deseasonalized: Vec<f64> = ordered
+                .iter()
+                .map(|(ts, v)| {
+                    v - cell_offset(&cells, &weekend_half, global, seasonal_cell(*ts)) as f64
+                })
+                .collect();
+            let next = rolling_median_level(&ordered, &deseasonalized, half_width_us);
+            let moved = next
+                .iter()
+                .zip(levels.iter())
+                .map(|(a, b)| (a - b).abs() as f64)
+                .fold(0.0_f64, f64::max);
+            levels = next;
+            let tolerance = BASELINE_FIT_TOLERANCE * (global.abs() as f64).max(f64::MIN_POSITIVE);
+            converged_moved = Some((moved, tolerance));
+            if moved <= tolerance {
+                converged_moved = None;
+                break;
+            }
+        }
+        // Bounded and monotone, so hitting the cap is a precision note rather than a failure.
+        if let Some((moved, tolerance)) = converged_moved {
+            tracing::debug!(
+                passes = BASELINE_FIT_MAX_PASSES,
+                moved,
+                tolerance,
+                buckets = ordered.len(),
+                "Seasonal baseline backfit hit its pass cap before tolerance"
+            );
+        }
+
+        let level_knots = downsample_level_knots(&ordered, &levels);
+        let trailing_level = level_knots.last().map(|(_, lvl)| *lvl).unwrap_or(0.0);
+
+        // Kept out of the persisted struct, whose byte layout is what the schema version gates.
+        if let Some(split) =
+            trailing_knot_is_unresolved(&ordered, &cells, &weekend_half, global, half_width_us)
+        {
+            // Warn: the level every later bucket is judged against may be the wrong side.
+            tracing::warn!(
+                window_buckets = split.window,
+                majority_needed = split.needed,
+                past_break = split.past_break,
+                share = split.past_break as f64 / split.window as f64,
+                share_floor = MIN_UNRESOLVED_SHARE,
+                separation = split.separation,
+                separation_floor = MIN_UNRESOLVED_SEPARATION,
+                trailing_level,
+                "{UNRESOLVED_LEVEL_NOTICE} {UNRESOLVED_LEVEL_REMEDY}"
+            );
+        }
+
+        Some(Self {
+            cells,
+            weekend_half,
+            global,
+            trailing_level,
+            level_knots,
+        })
+    }
+
+    /// Recentred on the global offset, the magnitude the `FeatureScaler` was calibrated on.
+    pub fn residual(&self, timestamp_us: i64, value: f64) -> f64 {
+        if !value.is_finite() {
+            return value;
+        }
+        let seasonal = cell_offset(
+            &self.cells,
+            &self.weekend_half,
+            self.global,
+            seasonal_cell(timestamp_us),
+        );
+        let residual =
+            value - seasonal as f64 - self.level_at(timestamp_us) as f64 + self.global as f64;
+        // A non-finite residual would reach the forest as an uncuttable coordinate.
+        if residual.is_finite() {
+            residual
+        } else {
+            value
+        }
+    }
+
+    /// Retained level knots, for the size guard's tests and for diagnostics.
+    pub fn level_knot_count(&self) -> usize {
+        self.level_knots.len()
+    }
+
+    /// The fitted `(cells, weekend_half, global, trailing_level)`, for tests and diagnostics.
+    pub fn params(&self) -> (&[Option<f32>], &[f32; 2], f32, f32) {
+        (
+            &self.cells,
+            &self.weekend_half,
+            self.global,
+            self.trailing_level,
+        )
+    }
+
+    /// Held flat past the fitted window: its error is bounded by how far the level actually moved.
+    fn level_at(&self, timestamp_us: i64) -> f32 {
+        match self
+            .level_knots
+            .binary_search_by_key(&timestamp_us, |(ts, _)| *ts)
+        {
+            Ok(i) => self.level_knots[i].1,
+            Err(i) if i >= self.level_knots.len() => self.trailing_level,
+            Err(0) => self.level_knots.first().map(|(_, l)| *l).unwrap_or(0.0),
+            Err(i) => self.level_knots[i - 1].1,
+        }
+    }
+}
+
+/// Neither bound can bind on the default, so the knob moves no config that does not set it.
+pub fn level_half_width_us(
+    requested_us: Option<i64>,
+    interval_us: i64,
+    training_window_days: u32,
+) -> i64 {
+    let training_span_us = i64::from(training_window_days).saturating_mul(86_400_000_000);
+    // Below the surviving knot spacing the fit resolves detail the blob then throws away.
+    let knot_spacing_us = training_span_us / MAX_LEVEL_KNOTS as i64;
+    // `clamp` is safe here: both bounds are ordered constants, unlike the computed clamp below.
+    let floor = interval_us
+        .max(1)
+        .saturating_mul(MIN_LEVEL_BUCKETS_PER_SIDE)
+        .max(knot_spacing_us)
+        .clamp(MIN_LEVEL_HALF_WIDTH_US, DEFAULT_LEVEL_HALF_WIDTH_US);
+    let ceiling =
+        (training_span_us / MAX_LEVEL_WINDOW_SHARE_OF_TRAINING).max(DEFAULT_LEVEL_HALF_WIDTH_US);
+    requested_us
+        .unwrap_or(DEFAULT_LEVEL_HALF_WIDTH_US)
+        .clamp(floor, ceiling)
+}
+
+/// UTC, matching `extract_hour_norm`/`extract_dow_norm`, so a far-from-UTC weekend splits.
+fn seasonal_cell(timestamp_us: i64) -> usize {
+    use chrono::{DateTime, Datelike, Timelike};
+    let Some(dt) = DateTime::from_timestamp_micros(timestamp_us) else {
+        return 0;
+    };
+    let weekend = usize::from(dt.weekday().num_days_from_monday() >= 5);
+    weekend * BASELINE_HOURS_PER_DAY + dt.hour() as usize
+}
+
+/// Robust throughout: the series is fitted with its anomalies still in it.
+fn seasonal_strength(ordered: &[(i64, f64)]) -> f64 {
+    let mut buckets: Vec<Vec<f64>> = vec![Vec::new(); BASELINE_CELLS];
+    for (ts, v) in ordered {
+        buckets[seasonal_cell(*ts)].push(*v);
+    }
+
+    let mut centres = Vec::new();
+    let mut spreads = Vec::new();
+    for column in buckets.iter_mut() {
+        if column.len() < MIN_CELL_SAMPLES {
+            continue;
+        }
+        let Some(centre) = median_of(column) else {
+            continue;
+        };
+        let mut deviations: Vec<f64> = column.iter().map(|v| (v - centre).abs()).collect();
+        if let Some(spread) = median_of(&mut deviations) {
+            centres.push(centre);
+            spreads.push(spread);
+        }
+    }
+    if centres.len() < 2 {
+        return 0.0;
+    }
+
+    let Some(grand) = median_of(&mut centres.clone()) else {
+        return 0.0;
+    };
+    let mut between: Vec<f64> = centres.iter().map(|c| (c - grand).abs()).collect();
+    between.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let rank = (SEASONAL_SPREAD_QUANTILE * (between.len() - 1) as f64) as usize;
+    let between = between[rank.min(between.len() - 1)];
+    let within = median_of(&mut spreads).unwrap_or(0.0);
+    if within <= 0.0 {
+        // No within-cell scatter at all: any between-cell difference is real structure.
+        return if between > 0.0 { f64::INFINITY } else { 0.0 };
+    }
+    between / within
+}
+
+/// Pooling adjacent hours keeps enough samples that an anomaly cannot drag its own cell.
+fn fit_seasonal_cells(points: &[(i64, f64)], global: f32) -> (Vec<Option<f32>>, [f32; 2]) {
+    let mut buckets: Vec<Vec<f64>> = vec![Vec::new(); BASELINE_CELLS];
+    for (ts, v) in points {
+        buckets[seasonal_cell(*ts)].push(*v);
+    }
+    let widths = [
+        half_cell_width(&buckets[..BASELINE_HOURS_PER_DAY]),
+        half_cell_width(&buckets[BASELINE_HOURS_PER_DAY..]),
+    ];
+
+    let mut weekend_half = [global; 2];
+    for (half, slot) in weekend_half.iter_mut().enumerate() {
+        let mut pooled: Vec<f64> = buckets
+            [half * BASELINE_HOURS_PER_DAY..(half + 1) * BASELINE_HOURS_PER_DAY]
+            .iter()
+            .flatten()
+            .copied()
+            .collect();
+        match median_of(&mut pooled) {
+            Some(m) => *slot = m as f32,
+            // Leaving `global` reads identically to a real fit, so only this line tells them apart.
+            None => tracing::debug!(
+                half,
+                buckets = points.len(),
+                "Seasonal half has no samples; it falls back to the global offset"
+            ),
+        }
+    }
+
+    // A thin cell yields to its half rather than a median an anomaly in it would drag to itself.
+    let cells = (0..BASELINE_CELLS)
+        .map(|cell| {
+            let half = cell / BASELINE_HOURS_PER_DAY;
+            let width = widths[half];
+            let hour = cell % BASELINE_HOURS_PER_DAY;
+            let group = hour - hour % width;
+            let mut column: Vec<f64> = buckets[half * BASELINE_HOURS_PER_DAY + group..]
+                [..width.min(BASELINE_HOURS_PER_DAY - group)]
+                .iter()
+                .flatten()
+                .copied()
+                .collect();
+            (column.len() >= MIN_CELL_SAMPLES)
+                .then(|| median_of(&mut column))
+                .flatten()
+                .map(|m| m as f32)
+        })
+        .collect();
+    (cells, weekend_half)
+}
+
+/// Never pools past the business-hours boundary, where the pooled median is the worse one.
+fn half_cell_width(half: &[Vec<f64>]) -> usize {
+    const MAX_POOLED_HOURS: usize = 2;
+    (1..=MAX_POOLED_HOURS)
+        .find(|width| {
+            (0..BASELINE_HOURS_PER_DAY).step_by(*width).all(|start| {
+                half[start..]
+                    .iter()
+                    .take(*width)
+                    .map(Vec::len)
+                    .sum::<usize>()
+                    >= MIN_CELL_SAMPLES
+            })
+        })
+        .unwrap_or(MAX_POOLED_HOURS)
+}
+
+/// The offset for a cell, walking the fallback ladder: own median, weekend half, global.
+fn cell_offset(cells: &[Option<f32>], weekend_half: &[f32; 2], global: f32, cell: usize) -> f32 {
+    if let Some(Some(offset)) = cells.get(cell) {
+        return *offset;
+    }
+    weekend_half
+        .get(cell / BASELINE_HOURS_PER_DAY)
+        .copied()
+        .unwrap_or(global)
+}
+
+/// The trailing knot seeds `trailing_level`, so it is carried verbatim, not left to the stride.
+fn downsample_level_knots(ordered: &[(i64, f64)], levels: &[f32]) -> Vec<(i64, f32)> {
+    let knots = ordered.iter().zip(levels.iter());
+    if ordered.len() <= MAX_LEVEL_KNOTS {
+        return knots.map(|((ts, _), lvl)| (*ts, *lvl)).collect();
+    }
+    let stride = ordered.len().div_ceil(MAX_LEVEL_KNOTS);
+    let mut thinned: Vec<(i64, f32)> = knots
+        .step_by(stride)
+        .map(|((ts, _), lvl)| (*ts, *lvl))
+        .collect();
+    if let (Some((last_ts, _)), Some(last_lvl)) = (ordered.last(), levels.last())
+        && thinned.last().is_none_or(|(ts, _)| ts != last_ts)
+    {
+        thinned.push((*last_ts, *last_lvl));
+    }
+    thinned
+}
+
+/// What the trailing median is sitting on, when a level break lands near its majority.
+struct UnresolvedTrailingKnot {
+    window: usize,
+    needed: usize,
+    past_break: usize,
+    separation: f64,
+}
+
+/// Not a defect: at the window edge a persisting step and a reverting one are the same data.
+fn trailing_knot_is_unresolved(
+    ordered: &[(i64, f64)],
+    cells: &[Option<f32>],
+    weekend_half: &[f32; 2],
+    global: f32,
+    half_width_us: i64,
+) -> Option<UnresolvedTrailingKnot> {
+    let last_ts = ordered.last()?.0;
+    let lo = ordered.partition_point(|(ts, _)| *ts < last_ts.saturating_sub(half_width_us));
+    // The seasonal term is removed first, or a daily swing reads as a break every fit.
+    let window: Vec<f64> = ordered[lo..]
+        .iter()
+        .map(|(ts, v)| v - cell_offset(cells, weekend_half, global, seasonal_cell(*ts)) as f64)
+        .collect();
+    let n = window.len();
+    if n < MIN_UNRESOLVED_WINDOW {
+        return None;
+    }
+    let mut sorted = window.clone();
+    let mid = median_of(&mut sorted)?;
+    let (below, above): (Vec<f64>, Vec<f64>) = window.iter().partition(|v| **v <= mid);
+    if below.is_empty() || above.is_empty() {
+        return None;
+    }
+    let mean = |side: &[f64]| side.iter().sum::<f64>() / side.len() as f64;
+    let (mb, ma) = (mean(&below), mean(&above));
+    let scatter = (mean(&below.iter().map(|v| (v - mb).abs()).collect::<Vec<_>>())
+        + mean(&above.iter().map(|v| (v - ma).abs()).collect::<Vec<_>>()))
+        / 2.0;
+    if scatter <= f64::EPSILON {
+        return None;
+    }
+    let separation = (ma - mb).abs() / scatter;
+    let past_break = below.len().min(above.len());
+    let needed = n / 2 + 1;
+    // Both sides must hold a real share, or one outlying bucket reads as a regime.
+    let balanced = past_break as f64 / n as f64 >= MIN_UNRESOLVED_SHARE;
+    (separation >= MIN_UNRESOLVED_SEPARATION && balanced).then_some(UnresolvedTrailingKnot {
+        window: n,
+        needed,
+        past_break,
+        separation,
+    })
+}
+
+/// Centred, not trailing: it is only fitted over training data, and trailing lags by half a window.
+fn rolling_median_level(ordered: &[(i64, f64)], residual: &[f64], half_width_us: i64) -> Vec<f32> {
+    let timestamps: Vec<i64> = ordered.iter().map(|(ts, _)| *ts).collect();
+    timestamps
+        .iter()
+        .map(|ts| {
+            // Saturating: a near-i64 timestamp otherwise wraps to `lo > hi` and panics here.
+            let lo = timestamps.partition_point(|t| *t < ts.saturating_sub(half_width_us));
+            let hi = timestamps.partition_point(|t| *t <= ts.saturating_add(half_width_us));
+            let mut window: Vec<f64> = residual[lo..hi].to_vec();
+            median_of(&mut window).unwrap_or(0.0) as f32
+        })
+        .collect()
+}
+
+/// Median of an unsorted column, sorting it in place. `None` only when the column is empty.
+fn median_of(column: &mut [f64]) -> Option<f64> {
+    if column.is_empty() {
+        return None;
+    }
+    column.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let mid = column.len() / 2;
+    Some(if column.len().is_multiple_of(2) {
+        (column[mid - 1] + column[mid]) / 2.0
+    } else {
+        column[mid]
+    })
+}
+
 /// Build the RCF feature vector for a single data point.
 ///
 /// Uses SQL-provided `hour`/`dow` when available; falls back to Rust-side extraction
@@ -139,6 +634,17 @@ pub fn build_window_vectors(
