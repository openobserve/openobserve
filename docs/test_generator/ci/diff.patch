+fn user_turn_text(input: &Value, pick: TurnPick) -> Option<String> {
+    match input {
+        Value::String(text) => match serde_json::from_str::<Value>(text) {
+            Ok(parsed) if parsed.is_array() || parsed.is_object() => user_turn_text(&parsed, pick),
+            _ => Some(text.clone()),
+        },
+        Value::Array(messages) => {
+            let mut users = messages
+                .iter()
+                .filter(|message| message.get("role").is_some_and(is_user_role));
+            let mut roleless = messages
+                .iter()
+                .filter(|message| message.get("role").is_none());
+            let turn = match pick {
+                TurnPick::First => users.next().or_else(|| roleless.next()),
+                TurnPick::Last => users.next_back().or_else(|| roleless.next_back()),
+            }?;
+            match turn {
+                Value::String(text) => Some(text.clone()),
+                Value::Object(_) => message_text(turn).or_else(|| Some(turn.to_string())),
+                other => Some(other.to_string()),
+            }
+        }
+        Value::Object(map) => {
+            if let Some(messages) = map.get("messages").filter(|value| value.is_array()) {
+                return user_turn_text(messages, pick);
+            }
+            if map.get("role").is_some() {
+                return message_text(input).or_else(|| Some(input.to_string()));
+            }
+            for key in [
+                "input", "inputs", "question", "query", "prompt", "content", "text",
+            ] {
+                if let Some(value) = map.get(key).filter(|value| is_non_empty_json(value)) {
