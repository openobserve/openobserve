+    /// T33: is a trailing level window worth pursuing in place of the shipped centred one?
+    #[test]
+    fn t33_a_trailing_level_window_is_measured_against_the_centred_one_at_four_half_widths() {
+        let bucket_us = 300_000_000_i64;
+        let hour_us = 3_600_000_000_i64;
+        let start_us = 1_704_067_200_000_000_i64;
+        let (pre, post) = (100.0_f64, 200.0_f64);
+        let midpoint = ((pre + post) / 2.0) as f32;
+
+        // A step `onset_h` into a `span_h` series, on an optional daily swing of `amp`.
+        let series = |span_h: f64, onset_h: f64, amp: f64| -> (Vec<(i64, f64)>, Vec<f64>) {
+            let n = (span_h * hour_us as f64 / bucket_us as f64) as i64;
+            let onset = (onset_h * hour_us as f64 / bucket_us as f64) as i64;
+            let ordered: Vec<(i64, f64)> = (0..n)
+                .map(|i| {
+                    let hour_of_day = (i * bucket_us) as f64 / hour_us as f64 % 24.0;
+                    let swing = amp * (std::f64::consts::TAU * hour_of_day / 24.0).sin();
+                    let level = if i >= onset { post } else { pre };
+                    (start_us + i * bucket_us, level + swing)
+                })
+                .collect();
+            let residual: Vec<f64> = ordered.iter().map(|(_, v)| *v).collect();
+            (ordered, residual)
+        };
+
+        type Rule = fn(&[(i64, f64)], &[f64], i64) -> Vec<f32>;
+        let last_level = |rule: Rule, span_h: f64, onset_h: f64, amp: f64, hw_us: i64| -> f32 {
+            let (ordered, residual) = series(span_h, onset_h, amp);
+            *rule(&ordered, &residual, hw_us).last().unwrap()
+        };
+
+        let mut report = String::new();
+        let mut errors: Vec<(i64, f32, f32)> = Vec::new();
+        for hw_hours in [6_i64, 12, 18, 24] {
+            let hw_us = hw_hours * hour_us;
+            // Six days of pre-step history keeps the widest window fully fed on the left.
+            let crossing = |rule: Rule| -> Option<i64> {
+                (1..=(4 * hw_us / bucket_us)).find_map(|b| {
+                    let age_us = b * bucket_us;
+                    let age_h = age_us as f64 / hour_us as f64;
+                    let level = last_level(rule, 144.0 + age_h, 144.0, 0.0, hw_us);
+                    (level > midpoint).then_some(age_us)
+                })
+            };
+            // Steady state on the ledger's regime: 72h prefix, onset at 43.2h.
+            let steady = |rule: Rule, amp: f64| last_level(rule, 72.0, 43.2, amp, hw_us) - 200.0;
+
+            let centred_cross = crossing(rolling_median_level);
+            let trailing_cross = crossing(trailing_median_level);
+            // Read INTERIOR: at the edge both rules truncate to `[ts-HW, ts]` and look alike.
+            let interior_cross = |rule: Rule| -> Option<i64> {
+                let (ordered, residual) = series(288.0, 144.0, 0.0);
+                let levels = rule(&ordered, &residual, hw_us);
+                let onset = (144.0 * hour_us as f64 / bucket_us as f64) as usize;
+                levels
+                    .iter()
+                    .position(|l| *l > midpoint)
+                    .map(|i| (i as i64 - onset as i64) * bucket_us)
+            };
+            let centred_interior = interior_cross(rolling_median_level);
+            let trailing_interior = interior_cross(trailing_median_level);
+            let (flat_c, flat_t) = (
+                steady(rolling_median_level, 0.0),
+                steady(trailing_median_level, 0.0),
+            );
+            let (diur_c, diur_t) = (
+                steady(rolling_median_level, 30.0),
+                steady(trailing_median_level, 30.0),
+            );
+            errors.push((hw_hours, diur_c, diur_t));
+
+            let as_hours = |us: Option<i64>| {
+                us.map(|u| format!("{:.1}h", u as f64 / hour_us as f64))
+                    .unwrap_or_else(|| "never".to_string())
+            };
+            report.push_str(&format!(
+                "HW={hw_hours:>2}h | edge cross C {:>6} T {:>6} | \
+                 interior cross C {:>6} T {:>6} | \
+                 flat err C {flat_c:+7.2} T {flat_t:+7.2} | \
+                 diurnal err C {diur_c:+7.2} T {diur_t:+7.2}\n",
+                as_hours(centred_cross),
+                as_hours(trailing_cross),
+                as_hours(centred_interior),
+                as_hours(trailing_interior),
+            ));
+
+            // Two legs, because either alone is satisfied by the wrong estimator.
+            let cross = centred_cross.expect("the centred rule must cross within 4 half-widths");
+            assert!(
+                (cross - hw_us / 2).abs() <= bucket_us,
+                "centred crossing age at the data edge must be HW/2 ({:.1}h) within one bucket \
+                 at HW={hw_hours}h, got {:.1}h",
+                (hw_us / 2) as f64 / hour_us as f64,
+                cross as f64 / hour_us as f64,
+            );
+            // INTERIOR: a centred window is symmetric, so its majority flips AT the step.
+            let interior = centred_interior.expect("the centred rule must cross inside the series");
+            assert!(
+                interior.abs() <= bucket_us,
+                "a centred window is symmetric, so its interior crossing must sit at the step \
+                 (0.0h) within one bucket for every HW; at HW={hw_hours}h it was {:.1}h",
+                interior as f64 / hour_us as f64,
+            );
+            let interior_t =
+                trailing_interior.expect("the trailing rule must cross inside the series");
+            assert!(
+                (interior_t - hw_us).abs() <= bucket_us,
+                "the trailing window spans `[ts-2HW, ts]`, so its interior crossing must LAG \
+                 the step by HW ({hw_hours}.0h) within one bucket, got {:.1}h — if this and the \
+                 centred leg agree, the two rules are not being compared",
+                interior_t as f64 / hour_us as f64,
+            );
+        }
+
+        // Reported, not asserted: monotonicity in HW is the open question this exists to test.
+        let monotone = |pick: fn(&(i64, f32, f32)) -> f32| {
+            let e: Vec<f32> = errors.iter().map(pick).collect();
+            e.windows(2).all(|w| w[0] <= w[1]) || e.windows(2).all(|w| w[0] >= w[1])
+        };
+        println!(
+            "T33 trailing-vs-centred level window (C = centred as shipped, T = trailing)\n\
+             {report}\
+             diurnal steady-state error by HW: {errors:?}\n\
+             monotone in HW — centred: {} | trailing: {}",
+            monotone(|e| e.1),
+            monotone(|e| e.2),
+        );
+    }
