+      sendHits(0, 42);
+
+      window.dispatchEvent(new Event("cancelQuery"));
+      await settle();
+
+      expect(fakes.saves).toHaveLength(0);
+      expect(fakes.cache.get("panel-1")).toBe(entryBefore);
+    });
+
+    it("when the executor drops an aborted run before it streams", async () => {
