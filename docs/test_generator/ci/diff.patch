+        // F34: neither name is a stream-name fallback, so the tie must be broken
+        // deterministically (freshest last_seen), not by DB return order.
+        let a = make_record("alpha", 100, serde_json::json!(["logs_a"]));
+        let b = make_record("beta", 200, serde_json::json!(["logs_b"]));
+
+        let merged_ab = merge_by_disambiguation(vec![a.clone(), b.clone()]);
+        let merged_ba = merge_by_disambiguation(vec![b, a]);
+
+        assert_eq!(merged_ab.len(), 1);
+        assert_eq!(merged_ba.len(), 1);
+        assert_eq!(merged_ab[0].service_name, "beta", "freshest record wins");
+        assert_eq!(
