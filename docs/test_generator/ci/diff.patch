+    /// A reading that also fired on ordinary series would say nothing.
+    #[test]
+    fn test_the_unresolved_reading_marks_the_flipping_band_and_leaves_clean_series_alone() {
+        let bucket_us = 1_800_000_000_i64;
+        let start_us = 1_788_602_400_000_000_i64;
+        let buckets = 384_i64;
+        // Jitter: a noiseless series has no within-side scatter, so every split separates.
+        let jitter = |i: i64| ((i * 2_654_435_761) % 1_000) as f64 / 1_000.0 - 0.5;
+        // The 24h trailing median flips at half its span, so ~12h is the ambiguous age.
+        let step_series = |age_hours: f64| -> Vec<QueryDataPoint> {
+            let onset = (buckets - 1) as f64 * 0.5 - age_hours;
+            (0..buckets)
+                .map(|i| {
+                    let hours = i as f64 * 0.5;
+                    let base = if hours >= onset { 65.0 } else { 100.0 };
+                    QueryDataPoint {
+                        timestamp_us: start_us + i * bucket_us,
+                        value: base + 4.0 * jitter(i),
+                        hour: None,
+                        dow: None,
+                    }
+                })
+                .collect()
+        };
+        let reading = |points: &[QueryDataPoint]| {
+            let ordered: Vec<(i64, f64)> =
+                points.iter().map(|p| (p.timestamp_us, p.value)).collect();
+            let cells = vec![None; BASELINE_CELLS];
+            trailing_knot_is_unresolved(
+                &ordered,
+                &cells,
+                &[100.0; 2],
+                100.0,
+                DEFAULT_LEVEL_HALF_WIDTH_US,
+            )
+            .is_some()
+        };
+
+        for age in [11.0, 12.0, 13.0] {
+            assert!(
+                reading(&step_series(age)),
+                "a step aged {age}h leaves the trailing median within a bucket of flipping and \
+                 must be reported"
+            );
+        }
+        for age in [3.0, 36.0] {
+            assert!(
+                !reading(&step_series(age)),
+                "a step aged {age}h is resolved — the median is not near its own majority — so \
+                 reporting it would be noise"
+            );
+        }
+
+        // A daily swing is the likeliest false break: the trailing window holds a whole cycle.
+        let seasonal: Vec<QueryDataPoint> = (0..buckets)
+            .map(|i| {
+                let hour = (i as f64 * 0.5) % 24.0;
+                QueryDataPoint {
+                    timestamp_us: start_us + i * bucket_us,
+                    value: 100.0
+                        + 40.0 * (std::f64::consts::TAU * (hour - 6.0) / 24.0).sin()
+                        + 4.0 * jitter(i),
+                    hour: None,
+                    dow: None,
+                }
+            })
+            .collect();
+        assert!(
+            !reading(&seasonal),
+            "a daily swing is not a level break and must not be reported"
+        );
+
+        // A floor in buckets rather than in wall-clock would silently mute a coarse cadence.
+        for interval_hours in [4_i64, 6] {
+            let coarse_us = interval_hours * 3_600_000_000;
+            let span = 14 * 24 / interval_hours;
+            let onset = (span - 1) * coarse_us - 12 * 3_600_000_000;
+            let coarse: Vec<QueryDataPoint> = (0..span)
+                .map(|i| {
+                    let ts = start_us + i * coarse_us;
+                    let base = if ts - start_us >= onset { 65.0 } else { 100.0 };
+                    QueryDataPoint {
+                        timestamp_us: ts,
+                        value: base + 4.0 * jitter(i),
+                        hour: None,
+                        dow: None,
+                    }
+                })
+                .collect();
+            assert!(
+                reading(&coarse),
+                "a step at the window edge must still be reported at a {interval_hours}h \
+                 interval, where the trailing window holds only {} buckets",
+                DEFAULT_LEVEL_HALF_WIDTH_US / coarse_us + 1
+            );
+        }
+    }
