+        #[test]
+        fn the_edit_guard_is_the_shared_rule_function() {
+            let mut a = eligible();
+            a.is_real_time = true;
+            assert_eq!(
+                source_alert_edit_breakage(&a, 300),
+                source_alert_ineligibility(&source_alert_facts(&a), 300),
