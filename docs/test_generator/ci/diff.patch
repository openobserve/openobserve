new file mode 100644
index 00000000000..7b8486f8781
--- /dev/null
+++ b/web/src/lib/core/EmptyState/illustrations/EmptyLock.vue
@@ -0,0 +1,142 @@
+<!-- Copyright 2026 OpenObserve Inc.
+
