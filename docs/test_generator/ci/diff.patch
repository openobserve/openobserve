+            "a reservoir starvation must say lowering the percentile cannot help: {notice}"
+        );
+
+        let tail = Trainer::uncalibrated_bar_notice(
+            BarStarvation::TailRank {
+                windows: 299,
+                needed: 300,
+            },
+            90.0,
+        );
+        assert!(
+            tail.contains("299") && tail.contains("300"),
+            "the tail-rank notice must carry both counts: {tail}"
+        );
+        assert!(
+            !tail.contains("every percentile"),
+            "a tail-rank starvation IS percentile-specific and must not say otherwise: {tail}"
+        );
+
+        // A hardcoded generic day count is wrong for most configs, and the operator acts on it.
+        assert!(
+            !UNCALIBRATED_BAR_REMEDY.contains("14 days or more"),
+            "the generic day count was wrong for most configs and must be derived per-config \
+             instead: {UNCALIBRATED_BAR_REMEDY}"
+        );
+
+        for remedy in ["training_window_days", "histogram_interval", "percentile"] {
+            assert!(
+                UNCALIBRATED_BAR_REMEDY.contains(remedy),
+                "the remedy must name the {remedy} knob: {UNCALIBRATED_BAR_REMEDY}"
+            );
+        }
+        for measured in ["10pp", "17pp", "27pp"] {
+            assert!(
+                UNCALIBRATED_BAR_REMEDY.contains(measured),
+                "the remedy must carry the measured {measured} so it is not read as \
+                 boilerplate: {UNCALIBRATED_BAR_REMEDY}"
+            );
+        }
+    }
 }
