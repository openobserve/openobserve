+//! G6. Whether enough of the training window actually arrived, judged on the bucket grid.
+//!
+//! `min_training_data_points` counts returned rows, which cannot tell 7 complete days at
+//! 1h from 14 days half of which are missing — both return the same number. This gate
+//! asks the other question: of the buckets the requested window *should* have held, what
+//! fraction came back.
+//!
+//! Built on the expected-versus-returned grid, never on a value predicate. A `count(*)`
+//! histogram emits no row for an empty interval, so a zero is structurally unrepresentable
+//! there and a `value == 0` guard would catch nothing; on `avg` and rate configs the rows
+//! do exist and legitimately evaluate to zero (2.7% of the fixture corpus), so the same
+//! guard would misfire. Only the grid separates the two.
+//!
+//! Gaps are skipped, never filled. Imputing zero into a count series moves zero into the
+//! training support, after which a real outage scores as ordinary — the failure this
+//! detector already shipped once.
+
+use super::types::QueryDataPoint;
+
+/// G6. Whether the training window arrived intact enough to model.
+#[derive(Debug, PartialEq)]
+pub enum Coverage {
+    Sufficient,
+    Insufficient(String),
+}
+
+/// G6. The grid census a coverage verdict is taken from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CoverageCensus {
+    /// Grid buckets the requested window spans.
+    pub expected_buckets: usize,
+    /// Distinct grid buckets the query returned inside that window.
+    pub returned_buckets: usize,
+}
+
+impl CoverageCensus {
+    /// Fraction of the requested window that arrived. An empty grid reads as complete:
+    /// a window too short to hold one bucket is a config problem, not a gappy series.
+    pub fn ratio(&self) -> f64 {
+        if self.expected_buckets == 0 {
+            return 1.0;
+        }
+        self.returned_buckets as f64 / self.expected_buckets as f64
+    }
+}
+
+/// G6. The verdict. A non-positive bar admits everything, which is how the gate ships off.
+pub fn assess_coverage(census: &CoverageCensus, min_coverage: f64) -> Coverage {
+    // Written positively so a NaN bar falls through to admit rather than refusing every
+    // config in the deployment: NaN fails both this test and the `>=` below.
+    let bar_is_set = min_coverage > 0.0;
+    if !bar_is_set {
+        return Coverage::Sufficient;
+    }
+    let ratio = census.ratio();
+    if ratio >= min_coverage {
+        return Coverage::Sufficient;
+    }
+    Coverage::Insufficient(format!(
+        "only {:.1}% of this training window arrived ({} of {} expected buckets); the gate \
+         requires {:.1}%. Training on a window this incomplete would learn a partial week as \
+         the whole of normal. Widen the training window, pick a stream that reports \
+         continuously, or lower O2_ANOMALY_MIN_TRAINING_COVERAGE.",
+        ratio * 100.0,
+        census.returned_buckets,
+        census.expected_buckets,
+        min_coverage * 100.0
+    ))
+}
+
+/// G6. Census the returned rows against the window training requested.
+///
+/// The window is the requested span, never the extent of the data that came back — the
+/// same choice the presence profile makes, and for the same reason: clipping to the
+/// returned extent would make a training-period outage invisible to the very gate that
+/// exists to see it, because the missing buckets would fall outside the grid.
+pub fn census_from_points(
+    data_points: &[QueryDataPoint],
+    window_start_us: i64,
+    window_end_us: i64,
+    interval_us: i64,
+) -> CoverageCensus {
+    let grid = super::absence::expected_grid(window_start_us, window_end_us, interval_us);
+    if grid.is_empty() {
+        return CoverageCensus {
+            expected_buckets: 0,
+            returned_buckets: 0,
+        };
+    }
+    let expected: std::collections::HashSet<i64> = grid.iter().copied().collect();
+    // Counted against the grid rather than by range test: a search returning a row twice,
+    // or a row off the epoch-aligned grid, must not inflate coverage past 100%.
+    let returned: std::collections::HashSet<i64> = data_points
+        .iter()
+        .map(|p| snap_to_grid(p.timestamp_us, interval_us))
+        .filter(|b| expected.contains(b))
+        .collect();
+    CoverageCensus {
+        expected_buckets: grid.len(),
+        returned_buckets: returned.len(),
+    }
+}
+
+/// G6. The training-time verdict over the rows the training query returned.
+/// An unparsable interval yields no verdict: a config problem must not read as a gap.
+pub fn assess_training_coverage(
+    data_points: &[QueryDataPoint],
+    histogram_interval: &str,
+    training_end_us: i64,
+    training_window_days: i64,
+    min_coverage: f64,
+) -> Coverage {
+    let Some(interval_us) = super::absence::interval_to_micros(histogram_interval) else {
+        return Coverage::Sufficient;
+    };
+    let window_start_us =
+        super::trainer::presence_window_start_us(training_end_us, training_window_days);
+    let census = census_from_points(data_points, window_start_us, training_end_us, interval_us);
+    assess_coverage(&census, min_coverage)
+}
+
+/// Floor a timestamp onto the epoch-aligned bucket grid, matching `expected_grid`.
+fn snap_to_grid(timestamp_us: i64, interval_us: i64) -> i64 {
+    if interval_us <= 0 {
+        return timestamp_us;
+    }
+    timestamp_us.div_euclid(interval_us) * interval_us
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIN_US: i64 = 60 * 1_000_000;
+    const HOUR_US: i64 = 3_600 * 1_000_000;
+    const DAY_US: i64 = 86_400 * 1_000_000;
+
+    fn point(timestamp_us: i64) -> QueryDataPoint {
+        QueryDataPoint {
+            timestamp_us,
+            value: 100.0,
+            hour: None,
+            dow: None,
+        }
+    }
+
+    /// A complete 7-day 1h window: 168 buckets, all present.
+    fn complete_week(end_us: i64) -> Vec<QueryDataPoint> {
+        let start = end_us - 7 * DAY_US;
+        (0..168).map(|i| point(start + i * HOUR_US)).collect()
+    }
+
+    // ── the verdict ─────────────────────────────────────────────────────
+
+    #[test]
+    fn a_complete_window_is_sufficient() {
+        let census = CoverageCensus {
+            expected_buckets: 168,
+            returned_buckets: 168,
+        };
+        assert_eq!(assess_coverage(&census, 0.8), Coverage::Sufficient);
+    }
+
+    #[test]
+    fn exactly_at_the_bar_is_sufficient() {
+        let census = CoverageCensus {
+            expected_buckets: 100,
+            returned_buckets: 80,
+        };
+        assert_eq!(assess_coverage(&census, 0.8), Coverage::Sufficient);
+    }
+
+    #[test]
+    fn one_bucket_under_the_bar_refuses() {
+        let census = CoverageCensus {
+            expected_buckets: 100,
+            returned_buckets: 79,
+        };
+        assert!(matches!(
+            assess_coverage(&census, 0.8),
+            Coverage::Insufficient(_)
+        ));
+    }
+
+    /// The refusal names the numbers, because it reaches the operator through `last_error`
+    /// and "training refused" without a fraction is unactionable.
+    #[test]
+    fn the_refusal_names_the_fraction_and_the_bar() {
+        let census = CoverageCensus {
+            expected_buckets: 168,
+            returned_buckets: 84,
+        };
+        let Coverage::Insufficient(reason) = assess_coverage(&census, 0.8) else {
+            panic!("50% coverage must refuse at a 0.80 bar");
+        };
+        assert!(reason.contains("50.0%"), "{reason}");
+        assert!(reason.contains("84 of 168"), "{reason}");
+        assert!(reason.contains("80.0%"), "{reason}");
+        assert!(
+            reason.contains("O2_ANOMALY_MIN_TRAINING_COVERAGE"),
+            "{reason}"
+        );
+    }
+
+    // ── the off switch ──────────────────────────────────────────────────
+
+    /// The shipped default. A window 99% missing still trains, because the gate is off.
+    #[test]
+    fn a_zero_bar_admits_an_almost_empty_window() {
+        let census = CoverageCensus {
+            expected_buckets: 2016,
+            returned_buckets: 20,
+        };
+        assert_eq!(assess_coverage(&census, 0.0), Coverage::Sufficient);
+    }
+
+    /// A negative bar is a misconfiguration, and admitting is the safe reading of it:
+    /// a typo must not refuse every config in the deployment.
+    #[test]
+    fn a_negative_bar_admits() {
+        let census = CoverageCensus {
+            expected_buckets: 100,
+            returned_buckets: 1,
+        };
+        assert_eq!(assess_coverage(&census, -1.0), Coverage::Sufficient);
+    }
+
+    /// NaN compares false against every bound, so it must be caught by the same guard
+    /// rather than silently refusing everything through a failed `>=`.
+    #[test]
+    fn a_nan_bar_admits() {
+        let census = CoverageCensus {
+            expected_buckets: 100,
+            returned_buckets: 1,
+        };
+        assert_eq!(assess_coverage(&census, f64::NAN), Coverage::Sufficient);
+    }
+
+    // ── the census ──────────────────────────────────────────────────────
+
+    #[test]
+    fn a_complete_week_censuses_at_full_coverage() {
+        let end = 30 * DAY_US;
+        let census = census_from_points(&complete_week(end), end - 7 * DAY_US, end, HOUR_US);
+        assert_eq!(census.expected_buckets, 168);
+        assert_eq!(census.returned_buckets, 168);
+        assert!((census.ratio() - 1.0).abs() < 1e-9);
+    }
+
+    /// The case `min_training_data_points` cannot see: a two-day outage inside the window
+    /// leaves 120 of 168 rows, which clears any plausible row-count bar and is still a
+    /// window missing 29% of itself.
+    #[test]
+    fn a_mid_window_outage_shows_up_as_missing_coverage() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (0..168)
+            .filter(|i| !(48..96).contains(i))
+            .map(|i| point(start + i * HOUR_US))
+            .collect();
+        assert_eq!(points.len(), 120);
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.expected_buckets, 168);
+        assert_eq!(census.returned_buckets, 120);
+        assert!(matches!(
+            assess_coverage(&census, 0.8),
+            Coverage::Insufficient(_)
+        ));
+    }
+
+    /// The row count alone cannot distinguish these, which is the whole reason this gate
+    /// exists alongside the volume check rather than instead of it.
+    #[test]
+    fn the_row_count_cannot_tell_these_two_windows_apart() {
+        let end = 30 * DAY_US;
+        let dense_start = end - 7 * DAY_US;
+        let dense: Vec<QueryDataPoint> =
+            (0..84).map(|i| point(dense_start + i * HOUR_US)).collect();
+        let sparse_start = end - 14 * DAY_US;
+        let sparse: Vec<QueryDataPoint> = (0..84)
+            .map(|i| point(sparse_start + i * 4 * HOUR_US))
+            .collect();
+        assert_eq!(dense.len(), sparse.len());
+
+        let dense_census = census_from_points(&dense, dense_start, end, HOUR_US);
+        let sparse_census = census_from_points(&sparse, sparse_start, end, HOUR_US);
+        assert_eq!(dense_census.expected_buckets, 168);
+        assert_eq!(sparse_census.expected_buckets, 336);
+        assert!(dense_census.ratio() > sparse_census.ratio());
+    }
+
+    /// Coverage is measured over the window training asked for. A stream that died
+    /// halfway and returned nothing since must read as half-missing, not as complete —
+    /// which is exactly what clipping to the returned extent would produce.
+    #[test]
+    fn the_window_is_the_requested_span_not_the_returned_extent() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (0..84).map(|i| point(start + i * HOUR_US)).collect();
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.expected_buckets, 168);
+        assert_eq!(census.returned_buckets, 84);
+
+        let clipped_end = start + 84 * HOUR_US;
+        let clipped = census_from_points(&points, start, clipped_end, HOUR_US);
+        assert_eq!(clipped.expected_buckets, 84);
+        assert!((clipped.ratio() - 1.0).abs() < 1e-9);
+        assert!(
+            census.ratio() < clipped.ratio(),
+            "clipping to the returned extent hides the outage the gate exists to catch"
+        );
+    }
+
+    /// A zero-valued bucket is a bucket that arrived. Count configs cannot emit one, but
+    /// avg and rate configs legitimately do — 2.7% of the fixture corpus, and 68.9% of
+    /// `nginx_latency_p50_1h`. Reading a zero as a gap would refuse those outright.
+    #[test]
+    fn zero_valued_buckets_count_as_present() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (0..168)
+            .map(|i| QueryDataPoint {
+                timestamp_us: start + i * HOUR_US,
+                value: 0.0,
+                hour: None,
+                dow: None,
+            })
+            .collect();
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.returned_buckets, 168);
+        assert_eq!(assess_coverage(&census, 0.8), Coverage::Sufficient);
+    }
+
+    /// A duplicated row is one bucket. Without the grid dedup a search returning rows
+    /// twice would census at 200% and paper over a genuinely gappy window.
+    #[test]
+    fn duplicate_rows_count_once() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let mut points: Vec<QueryDataPoint> = (0..84).map(|i| point(start + i * HOUR_US)).collect();
+        points.extend(points.clone());
+        assert_eq!(points.len(), 168);
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.returned_buckets, 84);
+        assert!(matches!(
+            assess_coverage(&census, 0.8),
+            Coverage::Insufficient(_)
+        ));
+    }
+
+    /// Rows off the epoch-aligned grid snap onto it rather than being discarded, so a
+    /// bucket reported a few seconds late still counts as arrived.
+    #[test]
+    fn rows_snap_onto_the_epoch_aligned_grid() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (0..168)
+            .map(|i| point(start + i * HOUR_US + 37 * 1_000_000))
+            .collect();
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.returned_buckets, 168);
+    }
+
+    /// Rows outside the requested window are not evidence about it. A window that
+    /// returned only stale history is as empty as one that returned nothing.
+    #[test]
+    fn rows_outside_the_window_do_not_count() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (1..169).map(|i| point(start - i * HOUR_US)).collect();
+        let census = census_from_points(&points, start, end, HOUR_US);
+        assert_eq!(census.expected_buckets, 168);
+        assert_eq!(census.returned_buckets, 0);
+    }
+
+    // ── the adapter ─────────────────────────────────────────────────────
+
+    #[test]
+    fn an_unparsable_interval_admits() {
+        let end = 30 * DAY_US;
+        assert_eq!(
+            assess_training_coverage(&[], "not-an-interval", end, 7, 0.8),
+            Coverage::Sufficient
+        );
+    }
+
+    #[test]
+    fn the_adapter_refuses_a_half_missing_window() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> = (0..84).map(|i| point(start + i * HOUR_US)).collect();
+        assert!(matches!(
+            assess_training_coverage(&points, "1h", end, 7, 0.8),
+            Coverage::Insufficient(_)
+        ));
+    }
+
+    #[test]
+    fn the_adapter_admits_a_complete_window() {
+        let end = 30 * DAY_US;
+        assert_eq!(
+            assess_training_coverage(&complete_week(end), "1h", end, 7, 0.8),
+            Coverage::Sufficient
+        );
+    }
+
+    /// The adapter derives its window from the same helper the presence profile uses, so
+    /// a 5m config censuses 2016 buckets over a 7-day window rather than 168.
+    #[test]
+    fn the_adapter_follows_the_configs_cadence() {
+        let end = 30 * DAY_US;
+        let start = end - 7 * DAY_US;
+        let points: Vec<QueryDataPoint> =
+            (0..2016).map(|i| point(start + i * 5 * MIN_US)).collect();
+        assert_eq!(
+            assess_training_coverage(&points, "5m", end, 7, 0.8),
+            Coverage::Sufficient
+        );
+        // The identical rows read against a 1h grid are 168 of 168 — same data, different
+        // question — so the cadence has to come from the config, never from the rows.
+        let hourly: Vec<QueryDataPoint> = points
+            .iter()
+            .filter(|p| (p.timestamp_us - start) % HOUR_US == 0)
+            .map(|p| point(p.timestamp_us))
+            .collect();
+        assert_eq!(hourly.len(), 168);
+        assert!(matches!(
+            assess_training_coverage(&hourly, "5m", end, 7, 0.8),
+            Coverage::Insufficient(_)
+        ));
+    }
+}

