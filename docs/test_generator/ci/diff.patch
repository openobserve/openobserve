diff --git a/src/infra/src/table/migration/m20260825_000001_add_steps_configured_to_synthetics_jobs.rs b/src/infra/src/table/migration/m20260825_000001_add_steps_configured_to_synthetics_jobs.rs
--- a/src/infra/src/table/migration/m20260825_000001_add_steps_configured_to_synthetics_jobs.rs
+++ b/src/infra/src/table/migration/m20260825_000001_add_steps_configured_to_synthetics_jobs.rs
@@ -0,0 +1,150 @@
+// Copyright 2026 OpenObserve Inc.
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
