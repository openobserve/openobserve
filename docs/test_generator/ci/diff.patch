+use sea_orm_migration::prelude::*;
+
+#[derive(DeriveMigrationName)]
+pub struct Migration;
+
+#[async_trait::async_trait]
+impl MigrationTrait for Migration {
+    async fn up(&self, manager: &SchemaManager) -> Result<(), DbErr> {
+        // 0 means the row belongs to no month, which is what every pool but the status one is.
+        if manager.has_column("trial_quota_usage", "period").await? {
+            return Ok(());
+        }
+
+        manager
+            .alter_table(
+                Table::alter()
+                    .table(TrialQuotaUsage::Table)
+                    .add_column(
+                        ColumnDef::new(TrialQuotaUsage::Period)
+                            .integer()
+                            .not_null()
+                            .default(0),
+                    )
+                    .to_owned(),
+            )
+            .await
+    }
+
+    async fn down(&self, _manager: &SchemaManager) -> Result<(), DbErr> {
+        // This migration cannot know whether it added the column or found it already there.
+        Ok(())
+    }
+}
+
+#[derive(DeriveIden)]
+enum TrialQuotaUsage {
+    Table,
+    Period,
+}
+
+#[cfg(test)]
+mod tests {
+    use sea_orm_migration::{MigrationName, sea_orm::Database};
+
+    use super::*;
+    use crate::enterprise::cloud::table::migration::m20260305_000001_create_trial_quota_usage_table;
+
+    async fn create_legacy_table(manager: &SchemaManager<'_>) {
+        manager
+            .create_table(
+                Table::create()
+                    .table(TrialQuotaUsage::Table)
+                    .col(ColumnDef::new("org_id").string_len(256).not_null())
+                    .col(ColumnDef::new("feature").string_len(64).not_null())
+                    .col(
+                        ColumnDef::new("usage_count")
+                            .big_integer()
+                            .not_null()
+                            .default(0),
+                    )
+                    .col(
+                        ColumnDef::new("updated_at")
+                            .big_integer()
+                            .not_null()
+                            .default(0),
+                    )
+                    .col(
+                        ColumnDef::new("notified_checkpoint")
+                            .small_integer()
+                            .not_null()
+                            .default(0),
+                    )
+                    .primary_key(Index::create().col("org_id").col("feature"))
+                    .to_owned(),
+            )
+            .await
+            .unwrap();
+    }
+
+    #[test]
+    fn test_migration_name() {
+        assert_eq!(
+            Migration.name(),
+            "m20260908_000001_add_period_to_trial_quota_usage_table"
+        );
+    }
+
+    #[tokio::test]
+    async fn test_adds_period_to_legacy_table_idempotently() {
+        let db = Database::connect("sqlite::memory:").await.unwrap();
+        let manager = SchemaManager::new(&db);
+        create_legacy_table(&manager).await;
+
+        assert!(
+            !manager
+                .has_column("trial_quota_usage", "period")
+                .await
+                .unwrap()
+        );
+
+        Migration.up(&manager).await.unwrap();
+        Migration.up(&manager).await.unwrap();
+
+        assert!(
+            manager
+                .has_column("trial_quota_usage", "period")
+                .await
+                .unwrap()
+        );
+    }
+
+    #[tokio::test]
+    async fn test_adds_period_to_a_freshly_created_table() {
+        let db = Database::connect("sqlite::memory:").await.unwrap();
+        let manager = SchemaManager::new(&db);
+
+        m20260305_000001_create_trial_quota_usage_table::Migration
+            .up(&manager)
+            .await
+            .unwrap();
+        Migration.up(&manager).await.unwrap();
+
+        assert!(
+            manager
+                .has_column("trial_quota_usage", "period")
+                .await
+                .unwrap()
+        );
+    }
+}
