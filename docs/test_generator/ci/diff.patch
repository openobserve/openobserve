--- a/o2_openfga/src/authorizer/authz.rs
+++ b/o2_openfga/src/authorizer/authz.rs
@@ -105,13 +105,18 @@ pub async fn is_allowed(
     // Governance resources where editor has read-only access via standard role.
     // POST/PUT/DELETE requires an explicit custom role grant.
     const GOVERNANCE_RESOURCES: &[&str] = &["user", "role", "group", "service_accounts"];
+    // Resources granted only to admins or via an explicit custom-role grant:
+    // excluded from the editor/viewer blanket approval below.
