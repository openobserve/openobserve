+                .map(|i| QueryDataPoint {
+                    timestamp_us: if anchor == i64::MAX {
+                        anchor - (buckets - 1 - i) * bucket_us
+                    } else {
+                        anchor + i * bucket_us
+                    },
+                    value: if i >= step_at { 200.0 } else { 100.0 },
+                    hour: None,
+                    dow: None,
