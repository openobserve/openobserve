-//! Built-in self-monitoring alerts over each org's `triggers` stream, seeded switched off.
-
-use common::utils::sql::escape_like;
-use config::{
-    meta::{
-        alerts::{
-            Operator, QueryCondition, QueryType, TriggerCondition, alert::Alert, default_align_time,
-        },
