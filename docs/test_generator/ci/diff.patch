+            }
+            Err(e) => {
+                log::error!(
+                    "error in sending workflow draft upsert notification to super cluster queue for {}/{} : {e}",
+                    workflow.org_id,
+                    workflow.id
+                );
+            }
+        }
+    }
+    Ok(())
+}
