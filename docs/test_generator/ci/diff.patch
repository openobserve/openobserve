+        first_name: user.first_name,
+        last_name: user.last_name,
+        is_external: user.is_external,
+        orgs: None,
+        created_at: org_user.created_at,
+        token,
+        is_system,
+        description: is_system.then(|| "Used by the AI SRE Agent.".to_string()),
