+    /// One UTC hour per bucket from a fixed Monday 00:00, so the 48 cells are exercised.
+    fn seasonal_points(
+        count: usize,
+        mut shape: impl FnMut(usize, i64) -> f64,
+    ) -> Vec<QueryDataPoint> {
+        // 2024-01-01T00:00:00Z is a Monday, so weekday and weekend cells both fill.
+        let start_us = 1_704_067_200_000_000_i64;
+        (0..count)
+            .map(|i| {
+                let ts = start_us + i as i64 * 3_600_000_000;
+                QueryDataPoint {
+                    timestamp_us: ts,
+                    value: shape(i, ts),
+                    hour: None,
+                    dow: None,
+                }
+            })
+            .collect()
+    }
+
+    /// A daily sine riding a linear trend: both baseline terms have something to find.
+    fn trending_daily_points(count: usize) -> Vec<QueryDataPoint> {
+        seasonal_points(count, |i, _| {
+            let phase = (i % 24) as f64 / 24.0 * std::f64::consts::TAU;
+            100.0 + 20.0 * phase.sin() + 0.05 * i as f64
+        })
+    }
