+        std::time::Duration::from_secs(5),
+        chart::build_payload(&req),
+    )
+    .await
+    .ok()
+    .flatten()?;
+    let url = chart::build_chart_url(&alert.org_id, &payload).await?;
+    Some((url, payload))
