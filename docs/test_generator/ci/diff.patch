+/// What is left of the monthly pool. A row carrying an older month has already been forgiven, so
+/// only its override survives into this month.
+fn monthly_remaining(rows: &[quota_entity::Model], month: i32, default_limit: u64) -> u64 {
+    let this_month: Vec<quota_entity::Model> = rows
+        .iter()
+        .filter(|row| row.feature == trial_quota_usage::SYNTHETICS_STATUS_FEATURE)
+        .map(|row| quota_entity::Model {
+            usage_count: if row.period == month {
+                row.usage_count
+            } else {
+                0
+            },
+            ..row.clone()
+        })
+        .collect();
+    remaining(
+        &this_month,
+        &[trial_quota_usage::SYNTHETICS_STATUS_FEATURE],
+        default_limit,
+    )
+}
