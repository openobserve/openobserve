+<template>
+  <ODialog
+    :open="state.open"
+    size="lg"
+    :title="t('dashboard.saveConflict.title')"
+    :persistent="!!state.busy"
+    data-test="dashboard-save-conflict-dialog"
+    @update:open="onOpenChange"
+  >
+    <div class="flex flex-col gap-4">
