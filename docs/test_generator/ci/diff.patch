new file mode 100644
index 000000000..859cdeedf
--- /dev/null
+++ b/o2_enterprise/src/enterprise/announcements/meta.rs
@@ -0,0 +1,197 @@
+// Copyright 2026 OpenObserve Inc.
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+//! Announcement banner types.
+//!
+//! Timestamps on the wire are microseconds; they are parsed from RFC 3339 during
+//! [`super::normalize`].
+
+use serde::{Deserialize, Serialize};
+use utoipa::ToSchema;
+
+/// Visual treatment. Also the ordering key: the most severe banner wins the slot.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, ToSchema, Default)]
+#[serde(rename_all = "lowercase")]
+pub enum BannerVariant {
+    #[default]
+    Info,
+    Warning,
+    Critical,
+    /// Marketing content. Always sorts last. The client additionally hides promos
+    /// while a `critical` banner is up — a webinar ad next to an outage notice
+    /// reads badly — and it has to happen there rather than here, because the
+    /// client mixes in a promo of its own that the server never sees.
+    Promo,
+}
+
+impl BannerVariant {
+    /// Higher sorts first.
+    pub fn rank(&self) -> u8 {
+        match self {
+            BannerVariant::Critical => 3,
+            BannerVariant::Warning => 2,
+            BannerVariant::Info => 1,
+            BannerVariant::Promo => 0,
+        }
+    }
+}
+
+fn default_dismissible() -> bool {
+    true
+}
+
+/// Optional call-to-action link.
+///
+/// Structured rather than embedded markup: the message renders as plain text so
+/// that stored config can never become stored XSS.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, ToSchema)]
+pub struct BannerCta {
+    pub text: String,
+    pub url: String,
+}
+
+/// One announcement.
+///
+/// Deserialization is deliberately lenient about unknown keys so a newer authoring
+/// schema does not break an older node mid-rollout.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, ToSchema)]
+pub struct Banner {
+    /// Plain text. The only required field.
+    pub message: String,
+
+    /// Stable key for dismissal. Derived from the content when omitted, so editing
+    /// the text re-shows a banner a user had already dismissed.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub id: Option<String>,
+
+    #[serde(default)]
+    pub variant: BannerVariant,
+
+    /// Display window start, micros. Absent means "already showing".
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub starts_at: Option<i64>,
+
+    /// Display window end, micros. Absent means "until removed".
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ends_at: Option<i64>,
+
+    #[serde(default = "default_dismissible")]
+    pub dismissible: bool,
+
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cta: Option<BannerCta>,
+
+    /// Organizations that should see this. Absent or empty means all of them.
+    ///
+    /// Round-trips through storage, which holds the whole config. It is stripped
+    /// from what any single org receives — see [`super::resolve_for_org`].
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub orgs: Option<Vec<String>>,
+}
+
+impl Banner {
+    /// Whether this banner's display window contains `now` (micros).
+    ///
+    /// The window is half-open: a banner is visible at its start instant and gone
+    /// at its end instant.
+    pub fn is_active_at(&self, now: i64) -> bool {
+        if let Some(start) = self.starts_at
+            && now < start
+        {
+            return false;
+        }
+        if let Some(end) = self.ends_at
+            && now >= end
+        {
+            return false;
+        }
+        true
+    }
+
+    /// Whether this banner targets `org`. An absent or empty allowlist means all orgs.
+    pub fn targets_org(&self, org: &str) -> bool {
+        match &self.orgs {
+            None => true,
+            Some(orgs) if orgs.is_empty() => true,
+            Some(orgs) => orgs.iter().any(|o| o == org),
+        }
+    }
+
+    /// The next instant at which this banner's visibility changes, if any.
+    ///
+    /// Lets the client arm a timer on the exact boundary instead of waiting out its
+    /// poll interval — a banner scheduled for 02:00 should appear at 02:00, not
+    /// somewhere in the following five minutes.
+    pub fn next_boundary_after(&self, now: i64) -> Option<i64> {
+        [self.starts_at, self.ends_at]
+            .into_iter()
+            .flatten()
+            .filter(|t| *t > now)
+            .min()
+    }
+}
+
+/// The stored value: `{"banners": [...]}`.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize, ToSchema)]
+pub struct AnnouncementBanners {
+    #[serde(default)]
+    pub banners: Vec<Banner>,
+}
+
+/// What the client receives.
+///
+/// `now` is the server's clock. Browsers with skewed clocks would otherwise flip a
+/// scheduled banner minutes early or late; the client keeps the offset and times
+/// its boundaries against this instead of `Date.now()`.
+#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
+pub struct AnnouncementsResponse {
+    pub banners: Vec<Banner>,
+    /// Server time in microseconds.
+    pub now: i64,
+    /// The next instant any banner in this set appears or disappears, if any.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub next_boundary: Option<i64>,
+}
+
+/// What a banner looks like as authored, before normalization.
+///
+/// Timestamps arrive as RFC 3339 strings and `duration` as a human span (`"1h"`),
+/// both resolved to absolute micros on write.
+#[derive(Debug, Clone, Deserialize)]
+pub(super) struct RawBanner {
+    pub message: String,
+    #[serde(default)]
+    pub id: Option<String>,
+    #[serde(default)]
+    pub variant: Option<BannerVariant>,
+    #[serde(default)]
+    pub starts_at: Option<String>,
+    #[serde(default)]
+    pub ends_at: Option<String>,
+    #[serde(default)]
+    pub duration: Option<String>,
+    #[serde(default)]
+    pub dismissible: Option<bool>,
+    #[serde(default)]
+    pub cta: Option<BannerCta>,
+    #[serde(default)]
+    pub orgs: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub(super) struct RawAnnouncementBanners {
+    #[serde(default)]
+    pub banners: Vec<RawBanner>,
+}
