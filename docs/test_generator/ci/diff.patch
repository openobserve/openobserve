+              {
+                "name": "Flex",
+                "rules": [
+                  {
+                    "keys": ["openai.response.service_tier", "openai.request.service_tier"],
+                    "op": "in",
+                    "values": ["flex"]
+                  }
+                ],
+                "prices": { "input": 1e-06, "output": 5e-06 }
+              },
+              {
+                "name": "Flex · Extended Context (272k+)",
+                "condition": { "usage_key": "input", "operator": "gte", "value": 272000 },
+                "rules": [
+                  {
+                    "keys": ["openai.response.service_tier", "openai.request.service_tier"],
+                    "op": "in",
+                    "values": ["flex"]
