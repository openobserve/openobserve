+            serde_json::json!({"org_id": "org_c", "event": "Pipeline", "value": 3.0}),
+        ];
+        let collected = rows
+            .into_iter()
+            .map(serde_json::from_value::<UsageResult>)
+            .collect::<Result<Vec<_>, _>>()
+            .expect("one unknown row must not abort the cycle for every other org");
