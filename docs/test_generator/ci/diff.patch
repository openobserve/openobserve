+        let expected = vec![(0, 100.0, 300.0), (300, 0.0, 100.0)];
+        let ordered = [ok(0, 0, 300), critical(100, 100, 300)];
+        let reversed = [critical(100, 100, 300), ok(0, 0, 300)];
+        assert_eq!(triples(&uptime_slices(&ordered, grid(0, 600))), expected);
