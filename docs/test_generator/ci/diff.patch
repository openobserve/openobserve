+        (Some(a), Some(b)) => a.max(b),
+        (Some(a), None) => a,
+        (None, Some(b)) => b,
+        (None, None) => return range_start,
+    };
+    align_up(floor, slice_interval_secs)
+        .max(range_start)
+        .min(range_end)
