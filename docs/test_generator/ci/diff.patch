+
+const ROLES: PlaygroundRole[] = ["system", "user", "assistant", "tool"];
+
+export interface PlaygroundHandoff {
+  messages: PlaygroundMessage[];
+  temperature: string;
+  /** The span this came from, for the provenance chip. */
+  sourceId: string;
