+
+//! The layer between a score and an alert.
+//!
+//! Production fires on a bare `anomaly_count > 0`, measured at 7.6-13.2
+//! alerts/day per config per destination with no threshold that moves it. This
+//! module is where that burden is addressed, deliberately outside any forest
+//! library: krcflib's veto chain was measured rejecting four of six confirmed
+//! incidents that its own forest had scored above threshold, so suppression here
+//! is explicit, ordered, and reports why it fired rather than being a chain of
+//! opaque corrections.
+
+use serde::{Deserialize, Serialize};
+
+/// A point is deadbanded when it sits within this fraction of its expectation.
+/// OpenSearch hands every detector a +/-20% ratio suppression by default; the
+/// value is theirs, the noise floor below is what stops it dominating a metric
+/// whose absolute movements are tiny.
+const DEFAULT_DEADBAND_RATIO: f64 = 0.20;
+
+/// One day of data time in microseconds, the budget meter's base window.
+const DAY_US: f64 = 86_400_000_000.0;
+
+/// Why a scored point did not become an alert. Carried on the decision so the
+/// UI and the operator can tell "not anomalous" from "suppressed", which
+/// OpenSearch's own plugin cannot do - it never reads CorrectionMode.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum Suppression {
+    /// Fired: nothing suppressed it.
+    None,
+    /// Score never cleared the threshold.
+    BelowThreshold,
+    /// Within the deadband of its expected value, in the metric's own units.
+    Deadband,
+    /// Inside the cooldown window of a previous fire.
+    Cooldown,
+    /// The delivered-alert budget for the trailing window is already spent.
+    Budget,
+}
+
+/// Inputs to one alert decision. Deliberately not tied to `ScoredPoint` so the
+/// policy can be exercised from the experiment harness without constructing a
+/// full detection result.
+#[derive(Debug, Clone, Copy)]
+pub struct PointDecision {
+    pub timestamp_us: i64,
+    pub score: f64,
+    pub threshold: f64,
+    pub actual: f64,
+    /// Expected value in the metric's own units, when the detector supplies one.
+    pub expected: Option<f64>,
+}
+
+/// Tunables. `cooldown_secs = 0` disables suppression, which reproduces the
+/// shipped bare rule exactly - the baseline any change has to beat.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+pub struct AlertPolicy {
+    pub cooldown_secs: i64,
+    /// Whether a suppressed point pushes the cooldown window out. Stronger than
+    /// OpenSearch, which re-fires every `shingle_size` intervals regardless, so
+    /// this has no external track record and must be measured before it ships.
+    pub extend_on_suppress: bool,
+    /// Off by default: nothing produces `expected` yet, so the stage stays inert.
+    #[serde(default)]
+    pub deadband_enabled: bool,
+    pub deadband_ratio: f64,
+    /// Absolute floor for the deadband, in the metric's units. Without it a
+    /// ratio band collapses to nothing on a metric that idles near zero.
+    pub noise_floor: f64,
+    /// Delivered-alert budget in alerts/day of data time; `None` (the default) is inert.
+    /// Enforced as a sliding-window cap, not a token bucket: a bucket's burst capacity
+    /// would break the trailing-window invariant the budget promises.
+    #[serde(default)]
+    pub budget_per_day: Option<f64>,
+}
+
+impl Default for AlertPolicy {
+    fn default() -> Self {
+        Self {
+            cooldown_secs: 0,
+            extend_on_suppress: false,
+            deadband_enabled: false,
+            deadband_ratio: DEFAULT_DEADBAND_RATIO,
+            noise_floor: 0.0,
+            budget_per_day: None,
+        }
+    }
+}
+
+/// Outcome for one point.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct AlertDecision {
+    pub fires: bool,
+    pub suppressed_by: Suppression,
+}
+
+/// Carries the last-fired timestamp across a detection run. A timestamp rather
+/// than a state machine: it survives a model reload and a process restart, which
+/// a state machine would not.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct AlertState {
+    pub last_fired_us: Option<i64>,
+    /// Data-times of delivered alerts inside the budget window; empty when no budget runs.
+    #[serde(default)]
+    pub recent_delivered_us: Vec<i64>,
+}
+
+impl AlertState {
+    /// Decide one point and advance the state. Order is load-bearing: threshold,
+    /// then deadband, then cooldown, then budget. Budget is evaluated last so a
+    /// point suppressed for any other reason can never consume budget.
+    pub fn decide(&mut self, p: &PointDecision, policy: &AlertPolicy) -> AlertDecision {
+        if p.score <= p.threshold {
+            return AlertDecision {
+                fires: false,
+                suppressed_by: Suppression::BelowThreshold,
+            };
+        }
+        if policy.deadband_enabled
+            && let Some(expected) = p.expected
+        {
+            let band = (policy.deadband_ratio * expected.abs()).max(policy.noise_floor);
+            if (p.actual - expected).abs() <= band {
+                return AlertDecision {
+                    fires: false,
+                    suppressed_by: Suppression::Deadband,
+                };
+            }
+        }
+        if policy.cooldown_secs > 0
+            && let Some(last) = self.last_fired_us
+        {
+            // Closed window and microsecond precision: an hourly config's buckets land
+            // exactly on the boundary, so a strict `<` on truncated seconds suppressed
+            // nothing at the shipped 3600s default.
+            let elapsed_us = p.timestamp_us.saturating_sub(last);
+            if elapsed_us <= policy.cooldown_secs.saturating_mul(1_000_000) {
+                if policy.extend_on_suppress {
+                    self.last_fired_us = Some(p.timestamp_us);
+                }
+                return AlertDecision {
+                    fires: false,
+                    suppressed_by: Suppression::Cooldown,
+                };
+            }
+        }
+        if let Some((window_us, cap)) = budget_window_cap(policy.budget_per_day) {
+            // Negative elapsed (a future anchor) counts as in-window, matching the
+            // cooldown's suppress-until-data-time-catches-up rule for skewed anchors.
+            let spent = self
+                .recent_delivered_us
+                .iter()
+                .filter(|&&t| p.timestamp_us.saturating_sub(t) <= window_us)
+                .count();
+            if spent >= cap {
+                return AlertDecision {
+                    fires: false,
+                    suppressed_by: Suppression::Budget,
+                };
+            }
+            self.recent_delivered_us.push(p.timestamp_us);
+            self.recent_delivered_us
+                .retain(|&t| p.timestamp_us.saturating_sub(t) <= window_us);
+        }
+        self.last_fired_us = Some(p.timestamp_us);
+        AlertDecision {
+            fires: true,
+            suppressed_by: Suppression::None,
+        }
+    }
+}
+
+/// The anchor value to persist after a run, or None when nothing may be written.
+pub fn conclude_alert_run(
+    decision: &AlertDecision,
+    state: &AlertState,
+    cooldown_secs: i64,
+    send_results: &[bool],
+) -> Option<i64> {
+    // Keyed on decision.fires: a loaded anchor alone must never re-persist itself.
+    if should_persist_alert_anchor(decision.fires, cooldown_secs, send_results) {
+        state.last_fired_us
+    } else {
+        None
+    }
+}
+
+/// Leading-edge selection: the first point whose score strictly clears its own threshold.
+/// Callers must supply chronologically ascending points; "first" means earliest only then.
+pub fn select_run_point(points: &[PointDecision]) -> Option<&PointDecision> {
+    points.iter().find(|p| p.score > p.threshold)
+}
+
+/// Enforcement window and cap for a budget, or None for an absent/unusable budget.
+///
+/// Budgets >= 1/day cap floor(budget) deliveries per trailing day; sub-daily budgets cap
+/// one delivery per trailing 1/budget days. floor, never round: the cap must not exceed
+/// what the window's own budget buys, or the trailing-window invariant breaks.
+fn budget_window_cap(budget_per_day: Option<f64>) -> Option<(i64, usize)> {
+    let per_day = budget_per_day.filter(|b| b.is_finite() && *b > 0.0)?;
+    let window_days = (1.0 / per_day).max(1.0);
+    let window_us = (window_days * DAY_US) as i64;
+    // max(1): float noise in per_day * (1/per_day) must not floor a valid budget to zero.
+    let cap = ((per_day * window_days).floor() as usize).max(1);
+    Some((window_us, cap))
+}
+
+/// True iff a fired run with the cooldown enabled delivered to at least one destination.
+fn should_persist_alert_anchor(fired: bool, cooldown_secs: i64, send_results: &[bool]) -> bool {
+    fired && cooldown_secs > 0 && send_results.contains(&true)
+}
