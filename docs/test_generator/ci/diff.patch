+      </div>
+    </div>
+
+    <div class="announcement-card-actions">
+      <q-btn
+        flat
+        dense
+        round
+        size="sm"
+        icon="edit"
+        :title="t('announcements.card.edit')"
+        :aria-label="t('announcements.card.edit')"
+        :data-test="`announcements-banner-card-edit-${index}`"
+        @click="$emit('edit')"
+      />
+      <q-btn
