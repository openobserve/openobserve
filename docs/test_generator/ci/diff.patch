+    /// Nothing upstream bounds a timestamp away from `i64`'s edges before that arithmetic.
+    #[test]
+    fn test_the_level_window_survives_timestamps_at_the_edge_of_i64() {
+        // Straddling either end of `i64` wraps the window edge into `lo > hi` and panics.
+        let bucket_us = 1_800_000_000_i64;
+        let buckets = 192_i64;
+        let step_at = 144_i64;
+        for anchor in [i64::MAX, i64::MIN] {
