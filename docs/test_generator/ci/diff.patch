+    fn test_the_weekend_shape_survives_the_default_seven_day_window() {
+        // The weekend keeps a diurnal shape of its own, which a pooled half-median erases.
+        let shape = |i: usize, ts: i64| {
+            let hour = i % 24;
+            let weekend = seasonal_cell(ts) >= BASELINE_HOURS_PER_DAY;
+            let amplitude = if (8..18).contains(&hour) { 1.0 } else { 0.35 };
+            200.0 + 800.0 * amplitude * if weekend { 0.6 } else { 1.0 }
+        };
+        let week = seasonal_points(7 * 24, shape);
+        let fitted = SeasonalBaseline::fit(&week, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a seasonal week must fit");
+
+        let weekend_offsets: Vec<f32> = week
+            .iter()
+            .filter(|p| seasonal_cell(p.timestamp_us) >= BASELINE_HOURS_PER_DAY)
+            .map(|p| {
+                let (cells, halves, global, _) = fitted.params();
+                cell_offset(cells, halves, global, seasonal_cell(p.timestamp_us))
+            })
+            .collect();
+        let distinct = weekend_offsets
+            .iter()
+            .map(|v| v.to_bits())
+            .collect::<std::collections::HashSet<_>>()
+            .len();
+        assert!(
+            distinct > 1,
+            "the weekend half collapsed onto a single pooled offset, erasing its diurnal shape"
+        );
+
+        // The forest scores the residual, so the weekend's own shape must be gone from it.
+        let weekend_residuals: Vec<f64> = week
+            .iter()
+            .filter(|p| seasonal_cell(p.timestamp_us) >= BASELINE_HOURS_PER_DAY)
+            .map(|p| fitted.residual(p.timestamp_us, p.value))
+            .collect();
+        let spread = weekend_residuals
+            .iter()
+            .fold(f64::NEG_INFINITY, |a, b| a.max(*b))
+            - weekend_residuals
+                .iter()
+                .fold(f64::INFINITY, |a, b| a.min(*b));
+        assert!(
+            spread < 100.0,
+            "weekend residual spread {spread} still carries the 520-unit weekend diurnal swing"
+        );
