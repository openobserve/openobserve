+    }
+
+    async function mountAt(path: string) {
+      const router = makeTracesRouter();
+      router.push(path);
+      await router.isReady();
+      const w = mount(ONavGroup, {
+        props: {
+          groupKey: "traces",
+          title: "Traces",
+          icon: "account-tree",
+          children: tracesChildren,
+          parentItem: {
