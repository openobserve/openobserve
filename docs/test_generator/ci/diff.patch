+        // so the FE can warn that the query is wider than the chips imply.
+        let stream = resp
+            .related_streams
+            .logs
+            .iter()
+            .find(|s| s.stream_name == "default")
+            .expect("log stream present");
+        assert!(stream.filters.is_empty());
+        let mut dropped = stream.dropped_dimensions.clone();
+        dropped.sort();
+        assert_eq!(
+            dropped,
+            vec![
+                "environment".to_string(),
+                "host".to_string(),
+                "service".to_string()
+            ]
+        );
+    }
+
+    #[tokio::test]
+    async fn test_correlate_conflict_still_rejects_despite_service_match() {
+        let org = "test_org_service_anchor_conflict";
+
+        let svc = create_service("api", vec![("environment", "prod")], "default", "logs");
+        let mut services = HashMap::new();
+        services.insert("row".to_string(), svc);
+        super::super::cache::update_services_cache(org, &services).await;
+
+        let mut input = HashMap::new();
+        input.insert("service_name".to_string(), "api".to_string());
+        input.insert("deployment_environment".to_string(), "staging".to_string());
+
+        let resp = correlate(
+            org,
+            &input,
+            &service_anchor_identity_config(),
+            &service_anchor_semantic_groups(),
+        )
+        .await
+        .unwrap();
+
+        assert!(
+            resp.is_none(),
+            "a genuine distinguish_by conflict must reject even with a service-name match"
+        );
+    }
+
+    #[tokio::test]
+    async fn test_correlate_service_optional_still_requires_overlap() {
+        let org = "test_org_service_optional_guard";
+
+        let svc = create_service("api", vec![], "default", "logs");
+        let mut services = HashMap::new();
+        services.insert("row".to_string(), svc);
+        super::super::cache::update_services_cache(org, &services).await;
+
+        let mut config = service_anchor_identity_config();
+        config.service_optional = true;
+
+        // No service dimension in the request: candidates are every org service, so
+        // the positive-overlap guard must hold — empty rows cannot match everything.
+        let mut input = HashMap::new();
+        input.insert("deployment_environment".to_string(), "local".to_string());
+        input.insert("host_name".to_string(), "dev-laptop".to_string());
+
+        let resp = correlate(org, &input, &config, &service_anchor_semantic_groups())
+            .await
+            .unwrap();
+
+        assert!(
+            resp.is_none(),
+            "service_optional path must still require a positive distinguish_by overlap"
+        );
+    }
+
+    #[tokio::test]
+    async fn test_correlate_rejects_disjoint_disambiguation_keys() {
+        // F11: row "payments" is disambiguated ONLY by {environment: prod-eu}; the request
+        // carries service + a k8s-cluster value (an infra dim the row knows nothing about).
+        // Old anchor rule: no conflict (disjoint keys) + service anchor → the row matched,
+        // unioning prod-eu streams into a prod-us request. The narrowed rule rejects it:
+        // the request DOES carry values for selected fields and the row's disambiguation is
+        // non-empty, so absence-of-conflict is not evidence of a match.
+        let org = "test_org_service_anchor_disjoint";
+
+        let svc = create_service(
+            "payments",
+            vec![("environment", "prod-eu")],
+            "eu_logs",
+            "logs",
+        );
+        let mut services = HashMap::new();
+        services.insert("row".to_string(), svc);
+        super::super::cache::update_services_cache(org, &services).await;
+
+        let mut config = service_anchor_identity_config();
+        config.sets = vec![config::meta::correlation::IdentitySet {
+            id: "custom-1".to_string(),
+            label: "custom-1".to_string(),
+            distinguish_by: vec!["environment".to_string(), "k8s-cluster".to_string()],
+        }];
+
+        let mut input = HashMap::new();
+        input.insert("service_name".to_string(), "payments".to_string());
+        input.insert("k8s_cluster".to_string(), "us-east".to_string());
+
+        let resp = correlate(org, &input, &config, &service_anchor_semantic_groups())
+            .await
+            .unwrap();
+
+        assert!(
+            resp.is_none(),
+            "disjoint-key row must not match a valued request"
+        );
+    }
 }
