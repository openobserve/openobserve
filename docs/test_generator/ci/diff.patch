+
+    await seed.deleteFolder(page, folderId);
+  });
+
+  test('WFF-UI-13: a draft is folder-scoped and cannot be moved', {
+    tag: ['@workflowFolders', '@P1'],
+  }, async ({ page }) => {
+    const draft = await seedWorkflow(page, { folderId: ctx.folderB, draft: true });
+
