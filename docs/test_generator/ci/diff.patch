+/// Which of the window's protocol steps came from a check attached to a status page.
+///
+/// Every failure answers "all regular": the status allowance is the cheaper answer for us only
+/// when it is earned, so an unreadable breakdown must never widen it.
+async fn classify(org_id: &str, totals: StepUsage, from: i64, to: i64) -> StepUsage {
+    if totals.protocol_regular == 0 {
+        return totals;
+    }
+    let per_check = match protocol_steps_per_check(org_id, from, to).await {
+        Ok(rows) => rows,
+        Err(e) => {
+            log::error!(
+                "[O2::ENT::Metering] {org_id}: no per-check protocol breakdown, billing every step as regular: {e}"
+            );
+            return totals;
+        }
+    };
+    let ids: Vec<String> = per_check.keys().cloned().collect();
+    let attached = match status_pages::mapped_check_ids(get_orm_client_ro().await, Some(&ids)).await
+    {
+        Ok(attached) => attached,
+        Err(e) => {
+            log::error!(
+                "[O2::ENT::Metering] {org_id}: the status page mapping is unreadable, billing every step as regular: {e}"
+            );
+            return totals;
+        }
+    };
+    let usage = bucket(per_check, &attached, totals);
+    log::info!(
+        "[O2::ENT::Metering] {org_id} window protocol steps: status={} regular={} across {} checks, {} attached",
+        usage.protocol_status,
+        usage.protocol_regular,
+        ids.len(),
+        attached.len(),
+    );
+    usage
+}
+
+/// The window's protocol steps, keyed by the check id the ack stamped into `stream_name`.
+async fn protocol_steps_per_check(
+    org_id: &str,
+    from: i64,
+    to: i64,
+) -> Result<HashMap<String, u64>> {
+    let query = super::common::usage_query()
+        .ok_or_else(|| anyhow::anyhow!("metering is not initialized"))?;
+    // The `event` column holds the OSS `UsageEvent` spelling, not this crate's meter name.
+    let event = config::meta::self_reporting::usage::UsageEvent::SyntheticsProtocolSteps;
+    let sql = format!(
+        "SELECT stream_name, SUM(size) AS value FROM \"{USAGE_STREAM}\" WHERE org_id = '{}' AND event = '{event}' GROUP BY stream_name",
+        super::common::sql_literal(org_id)
+    );
+    let rows = query(sql, from, to, false).await?;
+    Ok(rows
+        .into_iter()
+        .filter_map(|row| {
+            let stream_name = row.get("stream_name")?.as_str()?.to_string();
+            let value = json::get_float_value(row.get("value")?);
+            (value > 0.0).then_some((stream_name, value as u64))
+        })
+        .collect())
+}
+
+/// The per-check totals, folded into the two protocol buckets.
+///
+/// The breakdown runs moments after the window total, against a stream still being written, so the
+/// two rarely agree to the step. The attached share is CAPPED at the window total and any
+/// remainder stays regular, so a lagging read can only ever bill more, never grant more.
+fn bucket(
+    per_check: HashMap<String, u64>,
+    attached: &HashSet<String>,
+    totals: StepUsage,
+) -> StepUsage {
+    let mut status = 0u64;
+    for (check_id, steps) in per_check {
+        // A blank id is a legacy row from before the ack stamped the check, so it reads as regular.
+        if attached.contains(&check_id) {
+            status = status.saturating_add(steps);
+        }
+    }
+    let protocol_status = status.min(totals.protocol_regular);
+    StepUsage {
+        browser: totals.browser,
+        protocol_regular: totals.protocol_regular - protocol_status,
+        protocol_status,
+    }
+}
+
+/// Take the free share off the ingestion, search and retention of the streams the probes wrote.
+///
+/// SPEC §6.6: an org wholly inside its grants pays nothing on any of the three meters, so all
+/// three amounts drop by the synthetics share times the free fraction. A read that fails leaves
+/// the meter whole, which bills the org rather than forgiving something it did not earn.
+///
+/// Retention is an APPROXIMATION: the stored size is the size as of now and this window's fraction
+/// applies to all of it, so bytes written in a billable month ride a free month's discount. Exact
+/// billing needs a free-byte counter per org, which no meter keeps today.
+async fn discount_synthetics_data(
+    org_id: &str,
+    events: &mut [MeteringEvent],
+    free_fraction: f64,
+    from: i64,
+    to: i64,
+) {
+    if free_fraction <= 0.0 {
+        return;
+    }
+    let ingested = config::meta::self_reporting::usage::UsageEvent::Ingestion;
+    let searched = config::meta::self_reporting::usage::UsageEvent::Search;
+    // Every metered org pays these round trips once a window, so they go out together.
+    let (ingestion, search, stored) = tokio::join!(
+        synthetics_usage_mb(org_id, ingested, from, to),
+        synthetics_usage_mb(org_id, searched, from, to),
+        synthetics_stored_mb(org_id),
+    );
+    let mut taken: Vec<(MeteringEventName, i64)> = Vec::with_capacity(3);
+    // Ingestion and search are both metered per megabyte against the stream they name.
+    for (usage, meter, read) in [
+        (ingested, MeteringEventName::Ingestion, ingestion),
+        (searched, MeteringEventName::Query, search),
+    ] {
+        match read {
+            Ok(mb) => {
+                let off = discount(events, meter.clone(), mb * free_fraction);
+                taken.push((meter, off));
+            }
+            Err(e) => log::error!(
+                "[O2::ENT::Metering] {org_id}: synthetics {usage} is unreadable, billing it whole: {e}"
+            ),
+        }
+    }
+    let hours = (to - from) as f64 / super::NUM_OF_MICRO_SEC_ONE_HOUR as f64;
+    match stored {
+        Ok(mb) => taken.push((
+            MeteringEventName::DataRetention,
+            discount(
+                events,
+                MeteringEventName::DataRetention,
+                mb * hours * free_fraction,
+            ),
+        )),
+        Err(e) => log::error!(
+            "[O2::ENT::Metering] {org_id}: synthetics storage is unreadable, billing retention whole: {e}"
+        ),
+    }
+    let summary = taken
+        .iter()
+        .map(|(meter, off)| format!("{meter}=-{off}"))
+        .collect::<Vec<_>>()
+        .join(" ");
+    log::info!(
+        "[O2::ENT::Metering] {org_id} discounted synthetics data free_fraction={free_fraction:.3} {summary}"
+    );
+}
+
+/// Subtract from one meter and report what actually came off.
+///
+/// The share is spread ACROSS the events of a meter rather than taken from each, the same way
+/// the step remainder is: the usage query returns one event per meter today, and a second would
+/// otherwise be discounted twice.
+fn discount(events: &mut [MeteringEvent], event: MeteringEventName, amount: f64) -> i64 {
+    let off = amount.round().max(0.0) as i64;
+    if off == 0 {
+        return 0;
+    }
+    let mut left = off;
+    for e in events.iter_mut().filter(|e| e.event == event) {
+        let take = left.min(e.amount.max(0));
+        e.amount -= take;
+        left -= take;
+        if left == 0 {
+            break;
+        }
+    }
+    off - left
+}
+
+/// The megabytes one meter counted against the probe streams inside this window.
+///
+/// A search across several streams reports them as one joined `stream_name`, which this filter
+/// does not match, so a mixed query keeps billing in full.
+async fn synthetics_usage_mb(
+    org_id: &str,
+    event: config::meta::self_reporting::usage::UsageEvent,
+    from: i64,
+    to: i64,
+) -> Result<f64> {
+    let query = super::common::usage_query()
+        .ok_or_else(|| anyhow::anyhow!("metering is not initialized"))?;
+    let streams = SYNTHETICS_STREAMS.map(|s| format!("'{s}'")).join(", ");
+    let sql = format!(
+        "SELECT SUM(size) AS value FROM \"{USAGE_STREAM}\" WHERE org_id = '{}' AND event = '{event}' AND stream_name IN ({streams})",
+        super::common::sql_literal(org_id)
+    );
+    let rows = query(sql, from, to, false).await?;
+    Ok(rows
+        .first()
+        .and_then(|row| row.get("value"))
+        .map(json::get_float_value)
+        .unwrap_or(0.0))
+}
+
+/// The megabytes the probe streams hold right now, index included, as the retention meter counts.
+async fn synthetics_stored_mb(org_id: &str) -> Result<f64> {
+    let logs = Some(config::meta::stream::StreamType::Logs);
+    let (results, step_results) = tokio::join!(
+        infra::file_list::get_stream_stats(org_id, logs, Some(SYNTHETICS_STREAMS[0])),
+        infra::file_list::get_stream_stats(org_id, logs, Some(SYNTHETICS_STREAMS[1])),
+    );
+    let bytes: i64 = [results?, step_results?]
+        .iter()
+        .flatten()
+        .map(|(_, s)| s.storage_size as i64 + s.index_size as i64)
+        .sum();
+    Ok(bytes as f64 / (1024.0 * 1024.0))
 }
 
