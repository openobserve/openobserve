+const maskStringLiterals = (sql: string): string =>
+  sql.replace(
+    /'(?:[^']|'')*'|"(?:[^"]|"")*"/g,
+    (m) => m[0] + "x".repeat(m.length - 2) + m[m.length - 1],
+  );
