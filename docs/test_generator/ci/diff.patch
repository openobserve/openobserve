+    /// Fitting 48 medians to a structureless series manufactures the structure the forest scores.
+    #[test]
+    fn test_a_structureless_series_is_not_given_a_seasonal_baseline() {
+        // A deterministic LCG, so the test never flakes on a reseeded RNG.
+        let mut state = 0x2545_F491_4F6C_DD1D_u64;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            (state >> 11) as f64 / (1_u64 << 53) as f64
+        };
+        let flat = seasonal_points(14 * 24, |_, _| 100.0 + 30.0 * (next() - 0.5));
