+
+/// OSS `update_config` calls this on an interval edit: the blob has no replication channel.
+pub async fn delete_graded_until_blob(org_id: &str, anomaly_id: &str) -> Result<()> {
+    let s3_key = graded_until_key(org_id, anomaly_id);
+    infra::storage::del(vec![(org_id, &s3_key)])
+        .await
+        .context("Failed to delete the absence grading watermark")?;
+    Ok(())
+}
+
+/// The versioned watermark payload; the embedded interval is the reader's discard key.
+pub(crate) fn encode_graded_until(interval_us: i64, graded_until_us: i64) -> String {
+    format!("1:{interval_us}:{graded_until_us}")
+}
+
+/// Floors onto the current data grid, so a foreign-grid or mismatched write can never leak through.
+pub(crate) fn parse_graded_until(text: &str, interval_us: i64) -> Option<i64> {
+    let mut parts = text.trim().split(':');
+    if parts.next()? != "1" {
+        return None;
+    }
+    let stored_interval: i64 = parts.next()?.parse().ok()?;
+    let graded_until: i64 = parts.next()?.parse().ok()?;
+    if parts.next().is_some() || stored_interval != interval_us {
+        return None;
+    }
+    Some(super::detector::bucket_floor_us(graded_until, interval_us))
+}
