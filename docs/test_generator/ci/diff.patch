+    Ok((starts_at, ends_at))
+}
+
+fn normalize_banner(
+    index: usize,
+    item: serde_json::Value,
+    now: i64,
+    grandfathered: &HashSet<&str>,
+) -> Result<Banner, anyhow::Error> {
+    let path = format!("banners[{index}]");
+    let item: RawBanner = parse_item(&path, item)?;
+    validate_message(index, &item.message, grandfathered)?;
+    let ctas = normalize_ctas(index, &item)?;
+    let (starts_at, ends_at) = resolve_window(index, &item, now)?;
+
+    let id = item.id.clone().filter(|s| !s.trim().is_empty());
+    let id = Some(id.unwrap_or_else(|| derive_id(&item.message, &ctas)));
+
+    Ok(Banner {
+        id,
+        variant: item.variant.unwrap_or_default(),
+        starts_at,
+        ends_at,
+        dismissible: item.dismissible.unwrap_or(true),
+        text_size: item.text_size,
+        colors: normalize_colors(&path, item.colors)?,
+        icon: normalize_icon(&path, item.icon)?,
+        message: item.message,
+        cta: ctas.first().cloned(),
+        ctas,
+        orgs: item.orgs,
+    })
+}
+
+/// One config entry, with a parse error naming its position rather than serde's bare message.
+fn parse_item<T: serde::de::DeserializeOwned>(
+    path: &str,
+    item: serde_json::Value,
+) -> Result<T, anyhow::Error> {
+    serde_json::from_value(item).map_err(|e| anyhow::anyhow!("{path}: {e}"))
+}
+
+/// Saved styles are only read back by the editor, but a bad one would be copied into every banner.
+fn validate_styles(styles: Vec<serde_json::Value>) -> Result<(), anyhow::Error> {
+    let mut ids = HashSet::new();
+    let mut names = HashSet::new();
+    for (index, style) in styles.into_iter().enumerate() {
+        let path = format!("styles[{index}]");
+        let style: BannerStyle = parse_item(&path, style)?;
+        let id = style.id.trim();
+        let name = style.name.trim();
+        if id.is_empty() || name.is_empty() {
+            return Err(anyhow::anyhow!("{path}: id and name must not be empty"));
+        }
+        if name.chars().count() > STYLE_NAME_MAX_CHARS {
+            return Err(anyhow::anyhow!(
+                "{path}.name must be at most {STYLE_NAME_MAX_CHARS} characters"
+            ));
+        }
+        if !ids.insert(id.to_string()) || !names.insert(name.to_lowercase()) {
+            return Err(anyhow::anyhow!(
+                "{path}: another style already uses this id or name"
+            ));
+        }
+        normalize_colors(&path, style.colors)?;
+        normalize_icon(&path, style.icon)?;
+    }
+    Ok(())
+}
