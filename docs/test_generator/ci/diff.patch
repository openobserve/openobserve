+    /// The fit must actually REMOVE the trend, not leave it in the residual.
+    #[test]
+    fn test_the_fitted_level_takes_the_trend_out_of_the_residual() {
+        let points = trending_daily_points(14 * 24);
+        let fitted = SeasonalBaseline::fit(&points, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a full fortnight must fit");
+
+        let correlation_with_time = |values: &[f64]| {
+            let n = values.len() as f64;
+            let mean_x = (n - 1.0) / 2.0;
+            let mean_y = values.iter().sum::<f64>() / n;
+            let mut num = 0.0;
+            let mut var_x = 0.0;
+            let mut var_y = 0.0;
+            for (i, v) in values.iter().enumerate() {
+                let dx = i as f64 - mean_x;
+                let dy = v - mean_y;
+                num += dx * dy;
+                var_x += dx * dx;
+                var_y += dy * dy;
+            }
+            num / (var_x.sqrt() * var_y.sqrt())
+        };
+
+        let raw: Vec<f64> = points.iter().map(|p| p.value).collect();
+        let residual: Vec<f64> = points
+            .iter()
+            .map(|p| fitted.residual(p.timestamp_us, p.value))
+            .collect();
+
+        let before = correlation_with_time(&raw).abs();
+        let after = correlation_with_time(&residual).abs();
+        assert!(
+            after < before / 2.0,
+            "the level term must at least halve the residual's correlation with time, got \
+             {before} -> {after}"
+        );
+    }
