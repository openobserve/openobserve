+//! Announcement Banners
+//!
+//! One generic primitive for operator-authored notices shown at the top of the
+//! app: maintenance windows, release notes, policy reminders, promos. Downtime is
+//! a use case, not the model.
+//!
+//! Authored as JSON and stored as a single row in `system_settings` (scope `org`,
+//! org `_meta`, key [`ANNOUNCEMENT_BANNERS_KEY`]). `message` is the only required
+//! field; an empty list means no banner renders.
+//!
+//! Timestamps are authored as RFC 3339 **with an offset** and normalized to
+//! microseconds on write. Naive datetimes are rejected rather than assumed to be
+//! UTC — guessing a zone silently shifts a maintenance notice by hours.
+//!
+//! This module is pure: storage lives on the OSS side, which owns the cached and
+//! cluster-watched `system_settings` service.
+
+pub mod meta;
+
+use std::{
+    collections::hash_map::DefaultHasher,
+    hash::{Hash, Hasher},
+};
+
+use chrono::{DateTime, Utc};
+use config::utils::time::parse_milliseconds;
+
+use crate::enterprise::announcements::meta::{
+    AnnouncementBanners, Banner, RawAnnouncementBanners, RawBanner,
+};
+
+/// `system_settings` key holding the authored banner config on the `_meta` org.
+pub const ANNOUNCEMENT_BANNERS_KEY: &str = "announcement_banners";
+
+/// Parse a timestamp that carries an explicit UTC offset.
+///
+/// A naive datetime is an error: assuming UTC (or server-local) is how a notice
+/// scheduled for 02:00 local shows up hours off for whoever authored it.
+fn parse_offset_timestamp(field: &str, index: usize, value: &str) -> Result<i64, anyhow::Error> {
+    DateTime::parse_from_rfc3339(value.trim())
+        .map(|dt| dt.with_timezone(&Utc).timestamp_micros())
+        .map_err(|_| {
+            anyhow::anyhow!(
+                "banners[{index}].{field}: expected an RFC 3339 timestamp with a UTC offset, \
+                 e.g. \"2026-08-12T02:00:00Z\" or \"2026-08-12T07:30:00+05:30\", got {value:?}"
+            )
+        })
+}
+
+/// Fallback id: a hash of the fields a reader actually sees.
+///
+/// Editing the message or the CTA yields a new id, which re-shows the banner to
+/// users who dismissed the previous wording. That is the desired behavior, and it
+/// spares authors from inventing unique ids they would otherwise recycle.
+fn derive_id(banner: &RawBanner) -> String {
+    let mut hasher = DefaultHasher::new();
+    banner.message.hash(&mut hasher);
+    if let Some(cta) = &banner.cta {
+        cta.text.hash(&mut hasher);
+        cta.url.hash(&mut hasher);
+    }
+    format!("auto-{:x}", hasher.finish())
+}
+
+/// Validate and normalize authored banner JSON.
+///
+/// `now` (micros) anchors relative durations and is passed in so callers stay
+/// testable. Resolving `duration` here rather than at read time keeps the window
+/// from restarting every time an unrelated field is edited, and keeps cluster
+/// nodes from disagreeing at the boundary.
+///
+/// Errors name the offending index and field — this is authored in a raw JSON
+/// editor, so a vague failure leaves the author guessing.
+pub fn normalize(
+    value: &serde_json::Value,
+    now: i64,
+) -> Result<AnnouncementBanners, anyhow::Error> {
+    // Clearing the setting is the documented way to take every banner down, so
+    // null and empty string are valid input meaning "nothing".
+    if value.is_null() {
+        return Ok(AnnouncementBanners::default());
+    }
+    if let Some(s) = value.as_str()
+        && s.trim().is_empty()
+    {
+        return Ok(AnnouncementBanners::default());
+    }
+
+    let raw: RawAnnouncementBanners = serde_json::from_value(value.clone())
+        .map_err(|e| anyhow::anyhow!("invalid announcement banner config: {e}"))?;
+
+    let mut banners = Vec::with_capacity(raw.banners.len());
+    for (index, item) in raw.banners.into_iter().enumerate() {
+        if item.message.trim().is_empty() {
+            return Err(anyhow::anyhow!(
+                "banners[{index}].message must not be empty"
+            ));
+        }
+
+        if item.ends_at.is_some() && item.duration.is_some() {
+            return Err(anyhow::anyhow!(
+                "banners[{index}]: set either \"ends_at\" or \"duration\", not both"
+            ));
+        }
+
+        let starts_at = item
+            .starts_at
+            .as_deref()
+            .map(|v| parse_offset_timestamp("starts_at", index, v))
+            .transpose()?;
+
+        let ends_at = match (&item.ends_at, &item.duration) {
+            (Some(v), _) => Some(parse_offset_timestamp("ends_at", index, v)?),
+            (None, Some(d)) => {
+                let millis = parse_milliseconds(d.trim()).map_err(|e| {
+                    anyhow::anyhow!(
+                        "banners[{index}].duration: expected a span like \"30m\", \"1h\" or \
+                         \"2d\", got {d:?} ({e})"
+                    )
+                })?;
+                if millis == 0 {
+                    return Err(anyhow::anyhow!(
+                        "banners[{index}].duration must be greater than zero"
+                    ));
+                }
+                // Anchored to the display start so that a later edit does not
+                // silently extend the window.
+                let anchor = starts_at.unwrap_or(now);
+                Some(anchor + (millis as i64) * 1000)
+            }
+            (None, None) => None,
+        };
+
+        if let (Some(start), Some(end)) = (starts_at, ends_at)
+            && end <= start
+        {
+            return Err(anyhow::anyhow!(
+                "banners[{index}]: the display window ends before it starts"
+            ));
+        }
+
+        if let Some(cta) = &item.cta {
+            if cta.text.trim().is_empty() {
+                return Err(anyhow::anyhow!(
+                    "banners[{index}].cta.text must not be empty"
+                ));
+            }
+            let url = cta.url.trim();
+            // Anything but http(s) is either a mistake or an attempt at
+            // `javascript:` — neither should reach a rendered anchor.
+            if !url.starts_with("http://") && !url.starts_with("https://") {
+                return Err(anyhow::anyhow!(
+                    "banners[{index}].cta.url must start with http:// or https://"
+                ));
+            }
+        }
+
+        let id = item.id.clone().filter(|s| !s.trim().is_empty());
+        let id = Some(id.unwrap_or_else(|| derive_id(&item)));
+
+        banners.push(Banner {
+            message: item.message,
+            id,
+            variant: item.variant.unwrap_or_default(),
+            starts_at,
+            ends_at,
+            dismissible: item.dismissible.unwrap_or(true),
+            cta: item.cta,
+            orgs: item.orgs,
+        });
+    }
+
+    Ok(AnnouncementBanners { banners })
+}
+
+/// Banners an org should see at `now`, most severe first.
+///
+/// The allowlist is applied here, server-side, so one tenant never receives another
+/// tenant's notice text or org identifiers. `orgs` is cleared on the way out for the
+/// same reason: a banner targeting three tenants would otherwise name the other two
+/// to each of them.
+pub fn resolve_for_org(config: &AnnouncementBanners, org: &str, now: i64) -> Vec<Banner> {
+    let mut visible: Vec<Banner> = config
+        .banners
+        .iter()
+        .filter(|b| b.targets_org(org) && b.is_active_at(now))
+        .map(|b| Banner {
+            orgs: None,
+            ..b.clone()
+        })
+        .collect();
+
+    visible.sort_by(|a, b| {
+        b.variant
+            .rank()
+            .cmp(&a.variant.rank())
+            .then_with(|| a.starts_at.unwrap_or(0).cmp(&b.starts_at.unwrap_or(0)))
+    });
+
+    visible
+}
+
+/// The next instant the rendered set changes for `org`, across every configured
+/// banner — including ones not currently visible, whose start time is exactly what
+/// the client needs to wake up for.
+pub fn next_boundary_for_org(config: &AnnouncementBanners, org: &str, now: i64) -> Option<i64> {
+    config
+        .banners
+        .iter()
+        .filter(|b| b.targets_org(org))
+        .filter_map(|b| b.next_boundary_after(now))
+        .min()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{meta::BannerVariant, *};
+
+    const HOUR: i64 = 3_600_000_000;
+    const NOW: i64 = 1_754_985_600_000_000;
+
+    fn normalize_ok(json: serde_json::Value) -> AnnouncementBanners {
+        normalize(&json, NOW).expect("expected config to normalize")
+    }
+
+    fn banner_with_window(starts_at: Option<i64>, ends_at: Option<i64>) -> Banner {
+        Banner {
+            message: "m".into(),
+            id: None,
+            variant: BannerVariant::Info,
+            starts_at,
+            ends_at,
+            dismissible: true,
+            cta: None,
+            orgs: None,
+        }
+    }
+
+    #[test]
+    fn message_is_the_only_required_field() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [{"message": "Heads up"}]}));
+        let banner = &cfg.banners[0];
+
+        assert_eq!(banner.message, "Heads up");
+        assert_eq!(banner.variant, BannerVariant::Info);
+        assert!(banner.dismissible);
+        assert!(banner.starts_at.is_none());
+        assert!(banner.ends_at.is_none());
+        assert!(banner.is_active_at(NOW));
+    }
+
+    #[test]
+    fn empty_config_renders_nothing() {
+        assert!(
+            normalize_ok(serde_json::json!({"banners": []}))
+                .banners
+                .is_empty()
+        );
+        assert!(normalize_ok(serde_json::json!({})).banners.is_empty());
+        assert!(normalize_ok(serde_json::json!(null)).banners.is_empty());
+        assert!(normalize_ok(serde_json::json!("")).banners.is_empty());
+    }
+
+    #[test]
+    fn duration_resolves_against_the_display_start() {
+        // Anchored to starts_at when present...
+        let cfg = normalize_ok(serde_json::json!({"banners": [{
+            "message": "Maintenance",
+            "starts_at": "2026-08-12T02:00:00Z",
+            "duration": "2h",
+        }]}));
+        let start = cfg.banners[0].starts_at.unwrap();
+        assert_eq!(cfg.banners[0].ends_at, Some(start + 2 * HOUR));
+
+        // ...and to "now" when it is not.
+        let cfg = normalize_ok(serde_json::json!({"banners": [{
+            "message": "Back in an hour",
+            "duration": "1h",
+        }]}));
+        assert_eq!(cfg.banners[0].ends_at, Some(NOW + HOUR));
+    }
+
+    #[test]
+    fn naive_timestamps_are_rejected() {
+        let err = normalize(
+            &serde_json::json!({"banners": [{
+                "message": "Maintenance",
+                "starts_at": "2026-08-12T02:00:00",
+            }]}),
+            NOW,
+        )
+        .unwrap_err()
+        .to_string();
+
+        assert!(err.contains("banners[0].starts_at"), "{err}");
+        assert!(err.contains("UTC offset"), "{err}");
+    }
+
+    #[test]
+    fn offsets_are_honored_not_dropped() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [
+            {"message": "a", "starts_at": "2026-08-12T07:30:00+05:30"},
+            {"message": "b", "starts_at": "2026-08-12T02:00:00Z"},
+        ]}));
+        assert_eq!(cfg.banners[0].starts_at, cfg.banners[1].starts_at);
+    }
+
+    #[test]
+    fn ends_at_and_duration_are_mutually_exclusive() {
+        let err = normalize(
+            &serde_json::json!({"banners": [{
+                "message": "Maintenance",
+                "ends_at": "2026-08-12T04:00:00Z",
+                "duration": "1h",
+            }]}),
+            NOW,
+        )
+        .unwrap_err()
+        .to_string();
+        assert!(err.contains("not both"), "{err}");
+    }
+
+    #[test]
+    fn backwards_window_is_rejected() {
+        let err = normalize(
+            &serde_json::json!({"banners": [{
+                "message": "Maintenance",
+                "starts_at": "2026-08-12T04:00:00Z",
+                "ends_at": "2026-08-12T02:00:00Z",
+            }]}),
+            NOW,
+        )
+        .unwrap_err()
+        .to_string();
+        assert!(err.contains("ends before it starts"), "{err}");
+    }
+
+    #[test]
+    fn non_http_cta_urls_are_rejected() {
+        let err = normalize(
+            &serde_json::json!({"banners": [{
+                "message": "Click",
+                "cta": {"text": "Go", "url": "javascript:alert(1)"},
+            }]}),
+            NOW,
+        )
+        .unwrap_err()
+        .to_string();
+        assert!(err.contains("http://"), "{err}");
+    }
+
+    #[test]
+    fn unknown_keys_are_ignored_for_forward_compatibility() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [{
+            "message": "Hello",
+            "some_future_field": {"nested": true},
+        }]}));
+        assert_eq!(cfg.banners.len(), 1);
+    }
+
+    #[test]
+    fn derived_id_tracks_content() {
+        let first = normalize_ok(serde_json::json!({"banners": [{"message": "v1"}]}));
+        let same = normalize_ok(serde_json::json!({"banners": [{"message": "v1"}]}));
+        let edited = normalize_ok(serde_json::json!({"banners": [{"message": "v2"}]}));
+
+        assert_eq!(first.banners[0].id, same.banners[0].id);
+        assert_ne!(first.banners[0].id, edited.banners[0].id);
+    }
+
+    #[test]
+    fn explicit_id_survives_an_edit() {
+        let before = normalize_ok(serde_json::json!({
+            "banners": [{"id": "maint", "message": "starting soon"}]
+        }));
+        let after = normalize_ok(serde_json::json!({
+            "banners": [{"id": "maint", "message": "still running"}]
+        }));
+        assert_eq!(before.banners[0].id, after.banners[0].id);
+    }
+
+    #[test]
+    fn window_bounds_are_half_open() {
+        let banner = banner_with_window(Some(NOW), Some(NOW + HOUR));
+
+        assert!(!banner.is_active_at(NOW - 1));
+        assert!(banner.is_active_at(NOW), "the start instant is inclusive");
+        assert!(banner.is_active_at(NOW + HOUR - 1));
+        assert!(
+            !banner.is_active_at(NOW + HOUR),
+            "the end instant is exclusive"
+        );
+    }
+
+    #[test]
+    fn next_boundary_is_the_nearest_future_edge() {
+        let banner = banner_with_window(Some(NOW + HOUR), Some(NOW + 2 * HOUR));
+
+        assert_eq!(banner.next_boundary_after(NOW), Some(NOW + HOUR));
+        assert_eq!(banner.next_boundary_after(NOW + HOUR), Some(NOW + 2 * HOUR));
+        assert_eq!(banner.next_boundary_after(NOW + 2 * HOUR), None);
+    }
+
+    #[test]
+    fn allowlist_scopes_banners_to_named_orgs() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [
+            {"message": "everyone"},
+            {"message": "acme only", "orgs": ["acme"]},
+            {"message": "empty list means everyone", "orgs": []},
+        ]}));
+
+        assert_eq!(resolve_for_org(&cfg, "acme", NOW).len(), 3);
+
+        let other: Vec<_> = resolve_for_org(&cfg, "other", NOW)
+            .into_iter()
+            .map(|b| b.message)
+            .collect();
+        assert_eq!(other, vec!["everyone", "empty list means everyone"]);
+    }
+
+    #[test]
+    fn resolution_strips_the_allowlist_from_what_a_tenant_receives() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [
+            {"message": "shared notice", "orgs": ["acme", "globex", "initech"]},
+        ]}));
+
+        let resolved = resolve_for_org(&cfg, "acme", NOW);
+        assert_eq!(resolved.len(), 1);
+        assert!(
+            resolved[0].orgs.is_none(),
+            "acme must not learn that globex and initech were targeted too"
+        );
+
+        // Belt and braces: the wire form must not carry the key either.
+        let wire = serde_json::to_value(&resolved[0]).unwrap();
+        assert!(wire.get("orgs").is_none(), "{wire}");
+
+        // The stored config keeps it, or the allowlist would not survive a write.
+        assert_eq!(
+            cfg.banners[0].orgs.as_deref(),
+            Some(&["acme".to_string(), "globex".into(), "initech".into()][..])
+        );
+    }
+
+    #[test]
+    fn resolution_drops_inactive_and_sorts_by_severity() {
+        let cfg = normalize_ok(serde_json::json!({"banners": [
+            {"message": "promo", "variant": "promo"},
+            {"message": "outage", "variant": "critical"},
+            {"message": "notice", "variant": "info"},
+            {"message": "expired", "variant": "critical", "ends_at": "2020-01-01T00:00:00Z"},
+            {"message": "future", "variant": "critical", "starts_at": "2099-01-01T00:00:00Z"},
+        ]}));
+
+        let visible: Vec<_> = resolve_for_org(&cfg, "acme", NOW)
+            .into_iter()
+            .map(|b| b.message)
+            .collect();
+        assert_eq!(visible, vec!["outage", "notice", "promo"]);
+    }
+
+    #[test]
+    fn next_boundary_covers_banners_not_yet_visible() {
+        let cfg = AnnouncementBanners {
+            banners: vec![
+                banner_with_window(None, None),
+                banner_with_window(Some(NOW + 2 * HOUR), None),
+                banner_with_window(Some(NOW + HOUR), Some(NOW + 3 * HOUR)),
+            ],
+        };
+
+        // The soonest edge wins even though that banner is not on screen yet.
+        assert_eq!(next_boundary_for_org(&cfg, "acme", NOW), Some(NOW + HOUR));
+    }
+
+    #[test]
+    fn next_boundary_ignores_other_orgs() {
+        let mut theirs = banner_with_window(Some(NOW + HOUR), None);
+        theirs.orgs = Some(vec!["other".into()]);
+        let mut mine = banner_with_window(Some(NOW + 2 * HOUR), None);
+        mine.orgs = Some(vec!["acme".into()]);
+
+        let cfg = AnnouncementBanners {
+            banners: vec![theirs, mine],
+        };
+        assert_eq!(
+            next_boundary_for_org(&cfg, "acme", NOW),
+            Some(NOW + 2 * HOUR)
+        );
+    }
+}
