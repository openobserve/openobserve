+impl IdempotencyLedger {
+    fn new(capacity: usize) -> Self {
+        Self {
+            inner: Mutex::new(LedgerInner {
+                seen: HashSet::new(),
+                order: VecDeque::new(),
+            }),
+            // A zero capacity would silently disable the guard, so it is floored.
+            capacity: capacity.max(1),
