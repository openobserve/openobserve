+fn warn_if_wholly_discarded(org_id: &str, endpoint: &str, status: &StreamStatus) {
+    if !is_wholly_discarded(&status.status) {
+        return;
+    }
+    if !discard_warn_permitted(&format!("{org_id}/{}", status.name), Instant::now()) {
+        return;
+    }
