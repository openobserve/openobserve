+      <OButton
+        variant="ghost"
+        size="icon"
+        data-test="workflows-results-collapse"
+        @click="emit('toggle-collapse')"
+      >
+        <OIcon :name="collapsed ? 'expand-less' : 'expand-more'" size="sm" />
