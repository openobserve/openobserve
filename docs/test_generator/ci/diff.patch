+    await pm.workflowFoldersPage.expectFolderInUrl(ctx.folderA);
+  });
+
+  test('WFF-UI-09: rename a folder, and filter the rail by name', {
+    tag: ['@workflowFolders', '@P1'],
+  }, async ({ page }) => {
