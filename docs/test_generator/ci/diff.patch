+fn anthropic_chat_messages(messages: &[ProviderChatMessage]) -> Vec<Value> {
+    let mut rendered: Vec<Value> = Vec::new();
+    for message in messages.iter().filter(|message| message.role != "system") {
+        if !message.tool_calls.is_empty() {
+            let mut content = Vec::new();
+            let text = provider_content_as_text(&message.content);
+            if !text.is_empty() {
+                content.push(serde_json::json!({"type": "text", "text": text}));
+            }
+            content.extend(message.tool_calls.iter().map(|call| {
+                serde_json::json!({
+                    "type": "tool_use",
+                    "id": call.id,
+                    "name": call.name,
+                    "input": tool_arguments_value(&call.arguments),
+                })
+            }));
+            rendered.push(serde_json::json!({"role": "assistant", "content": content}));
+            continue;
+        }
+
+        if message.role == "tool" {
+            let block = serde_json::json!({
+                "type": "tool_result",
+                "tool_use_id": message.tool_call_id,
+                "content": provider_content_as_text(&message.content),
+            });
+            if let Some(last) = rendered.last_mut()
+                && last["role"] == "user"
+                && last["content"]
+                    .as_array()
+                    .is_some_and(|parts| parts.iter().all(|part| part["type"] == "tool_result"))
+            {
+                last["content"].as_array_mut().unwrap().push(block);
+            } else {
+                rendered.push(serde_json::json!({"role": "user", "content": [block]}));
+            }
+            continue;
+        }
+
+        rendered.push(serde_json::json!({
+            "role": message.role,
+            "content": message.content,
+        }));
+    }
+    rendered
+}
+
+fn tool_arguments_value(arguments: &str) -> Value {
+    serde_json::from_str(arguments).unwrap_or_else(|_| Value::Object(serde_json::Map::new()))
+}
