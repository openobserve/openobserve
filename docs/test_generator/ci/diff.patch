+/// Collapses whitespace and bounds the excerpt to [`MAX_INPUT_PREVIEW_CHARS`].
+/// The collapse is lazy: a prompt carrying a pasted document must not be
+/// copied whole just to keep its first couple of hundred characters.
+fn bounded_preview(text: &str) -> Option<String> {
+    let mut chars = text
+        .split_whitespace()
+        .enumerate()
+        .flat_map(|(index, word)| {
+            std::iter::once(' ')
+                .take(usize::from(index > 0))
+                .chain(word.chars())
+        });
+    let mut preview = chars
+        .by_ref()
+        .take(MAX_INPUT_PREVIEW_CHARS)
+        .collect::<String>();
+    if preview.is_empty() {
+        return None;
+    }
+    if chars.next().is_some() {
+        preview = preview.trim_end().to_string();
+        preview.push('…');
+    }
+    Some(preview)
