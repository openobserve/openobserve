+  props.chip.scoredAtMs ? new Date(props.chip.scoredAtMs).toLocaleString() : "",
+);
+</script>
diff --git a/web/src/enterprise/components/onlineEvals/composables/useTraceScoreChips.spec.ts b/web/src/enterprise/components/onlineEvals/composables/useTraceScoreChips.spec.ts
