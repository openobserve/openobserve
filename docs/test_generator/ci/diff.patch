+    let scan = scan_drop_buckets(&grid, input, policy, absence_policy);
+    let edge = settled_edge_run(&scan.judged, &scan.lows, &scan.normals);
+    if edge == 0 {
+        return None;
+    }
+    let start = scan.judged[scan.judged.len() - edge];
