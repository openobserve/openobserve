+    #[test]
+    fn a_malformed_buffer_reads_as_empty_rather_than_failing() {
+        assert!(parse_trailing(None).is_empty());
+        assert!(parse_trailing(Some(&json!(null))).is_empty());
+        assert!(parse_trailing(Some(&json!("nonsense"))).is_empty());
