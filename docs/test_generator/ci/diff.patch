+    /// Past the fitted window, `level_at` holds the trailing knot unchanged for every horizon.
+    #[test]
+    fn test_the_level_is_read_per_bucket_and_held_flat_past_the_window() {
+        let points = trending_daily_points(14 * 24);
+        let fitted = SeasonalBaseline::fit(&points, DEFAULT_LEVEL_HALF_WIDTH_US)
+            .expect("a full fortnight must fit");
+        let (_, _, _, trailing) = fitted.params();
+        assert!(
+            trailing.abs() > 1e-6,
+            "a trending series must leave a non-zero trailing level for the hold to carry"
+        );
+
+        // Exact equality, not a tolerance: any rule that moves the level differs by construction.
+        let last = points.last().unwrap().timestamp_us;
+        for hours in [0_i64, 1, 6, 24, 72, 168, 336, 720] {
+            let carried = fitted.level_at(last + hours * 3_600_000_000 + 1);
+            assert_eq!(
+                carried, trailing,
+                "at +{hours}h past the window the level must still be the trailing knot \
+                 {trailing}, got {carried}"
+            );
+        }
+
+        let mid = points[points.len() / 2].timestamp_us;
+        assert_ne!(
+            fitted.level_at(mid),
