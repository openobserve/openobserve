+  describe("tab-alias active state (activeOnTab)", () => {
+    const tracesChildren: SubnavChild[] = [
+      { titleKey: "menu.traces", icon: "account-tree", name: "traces" },
+      {
+        titleKey: "menu.serviceGraph",
