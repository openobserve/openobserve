+  it("shows Enter Fullscreen until the parent reports this box IS the fullscreen element", () => {
+    const collapsed = mountBox({ fullscreen: false });
+    expect(collapsed.get('[data-test="box-fullscreen"]').attributes("title")).toBe(
+      "Enter Fullscreen",
