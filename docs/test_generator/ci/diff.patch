+    let Some(configured) = configured else {
+        return kind
+            .default_run_endpoint()
+            .map(str::to_string)
+            .ok_or_else(|| {
+                anyhow::anyhow!("endpoint is required for provider type {}", kind.as_str())
+            });
+    };
+
+    let mut url = Url::parse(configured)
+        .map_err(|e| anyhow::anyhow!("Invalid provider endpoint '{configured}': {e}"))?;
+
+    let segments = significant_path_segments(&url);
+    let already_complete = TERMINAL_ENDPOINT_PATHS.iter().any(|terminal| {
+        segments.len() >= terminal.len()
+            && segments[segments.len() - terminal.len()..]
+                .iter()
+                .zip(terminal.iter())
+                .all(|(segment, expected)| segment.eq_ignore_ascii_case(expected))
+    });
+    if already_complete {
+        return Ok(configured.to_string());
+    }
+
+    let suffix = match segments.last() {
+        Some(last) if is_version_segment(last) => {
+            kind.versioned_base_suffix().ok_or_else(|| {
+                anyhow::anyhow!(
+                    "provider type {} does not serve a versioned base URL; use provider type \
+                     openai_compatible to reach an OpenAI-compatible endpoint",
+                    kind.as_str()
+                )
+            })?
+        }
+        // An unrecognized path is a gateway's custom route; leave it exactly as configured.
+        Some(_) => return Ok(configured.to_string()),
+        None => kind.bare_host_suffix(),
+    };
+
+    append_path_segments(&mut url, suffix)
+        .map_err(|e| anyhow::anyhow!("Invalid provider endpoint '{configured}': {e}"))?;
