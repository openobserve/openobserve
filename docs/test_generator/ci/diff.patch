+});
+
+describe("openDashboardConflict", () => {
+  it("re-fetches once, keeps my working copy in the cache and lists what they changed", async () => {
+    await editPanelAndConflict();
+
+    expect(service.get_Dashboard).toHaveBeenCalledTimes(2);
