+            assert!(reason.contains("10"), "{reason}");
+            assert!(reason.contains("silence to 0"), "{reason}");
+            assert!(reason.contains("warning threshold"), "{reason}");
+        }
+
+        /// 300 is the coarsest slice (S-4), so the picker's cadence cut-off is
