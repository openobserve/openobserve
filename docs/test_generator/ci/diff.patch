+                        UsageEvent::SyntheticsBrowserSteps
+                            | UsageEvent::SyntheticsProtocolSteps
+                            | UsageEvent::SyntheticsFreeBrowserSteps
+                            | UsageEvent::SyntheticsFreeProtocolSteps
