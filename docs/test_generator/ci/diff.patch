+      name: name ?? `wf_auto_fld_${uniq()}`,
+      destName: ctx.destName,
+      folderId,
+      draft,
+    });
+    ctx.workflows.push(wf);
+    return wf;
+  };
+
+  // ===== P0 =====
+
+  test('WFF-UI-01: folder rail renders with the default folder and the list loads inside it', {
+    tag: ['@workflowFolders', '@P0'],
+  }, async () => {
