+/// The rows whose conversation fields stand for the target's question and
+/// final answer. Tool spans often carry the generic input/output fields too,
+/// so a chat turn is chosen explicitly instead of trusting whichever span the
+/// stream returned last.
+///
+/// A trace answers from its root chat span. A session answers from the first
+/// trace's chat root (the opening question) and the last trace's chat root
+/// (the final answer). Tool spans stay available in `tool_calls`, `steps`
+/// and `spans`.
+fn target_io_rows<'a>(
+    target_scope: &EvaluationTargetScope,
+    rows: &'a [Value],
+) -> Option<(&'a Value, &'a Value)> {
+    match target_scope {
+        EvaluationTargetScope::Span => None,
+        EvaluationTargetScope::Trace => target_root_row(rows).map(|row| (row, row)),
+        EvaluationTargetScope::Session => {
+            let roots = session_trace_roots(rows)
+                .into_iter()
+                .map(|(_, _, root)| root)
+                .filter(|root| is_chat_row(root))
+                .collect::<Vec<_>>();
+            Some((*roots.first()?, *roots.last()?))
+        }
+    }
 }
 
