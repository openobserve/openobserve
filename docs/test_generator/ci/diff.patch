+        queue.push("a", ["a1", "a2", "a3"]);
+        queue.push("a", ["a4", "a5"]);
+        queue.push("b", ["b1", "b2"]);
+        queue.push("c", ["c1", "c2"]);
+        let first = (0..4).map(|_| queue.next().unwrap().1).collect::<Vec<_>>();
+        assert_eq!(first, ["a1", "b1", "c1", "a4"]);
+        assert!(queue.next().is_none());
+    }
+
+    #[test]
+    fn slow_org_cannot_accumulate_all_workers_while_other_orgs_wait() {
+        let mut queue = FairQueue::new(4);
+        queue.push("slow", 0..100);
+        queue.push("fast", 100..200);
+        let first = (0..4).map(|_| queue.next().unwrap()).collect::<Vec<_>>();
+        assert_eq!(
+            first.iter().map(|(_, slot)| *slot).collect::<Vec<_>>(),
+            [0, 100, 1, 101]
+        );
+        let fast = first[1].0;
+        // Keep one fast worker completing while both slow calls remain active.
+        for expected in 102..120 {
+            queue.complete(fast);
+            assert_eq!(queue.next(), Some((fast, expected)));
+            assert!(queue.next().is_none());
+        }
+    }
+
+    #[test]
+    fn more_orgs_than_workers_rotate_without_starvation() {
+        let mut queue = FairQueue::new(1);
+        for org in ["a", "b", "c", "d"] {
+            queue.push(org, [org; 2]);
+        }
+        let mut order = Vec::new();
+        while let Some((org, slot)) = queue.next() {
+            order.push(slot);
+            queue.complete(org);
+        }
+        assert_eq!(order, ["a", "b", "c", "d", "a", "b", "c", "d"]);
+    }
+
+    #[test]
+    fn spare_capacity_is_reused_when_an_org_exhausts_its_backlog() {
+        let mut queue = FairQueue::new(4);
+        queue.push("a", 0..10);
+        queue.push("b", [100]);
+        let first = (0..4).map(|_| queue.next().unwrap()).collect::<Vec<_>>();
+        assert_eq!(
+            first.iter().map(|(_, slot)| *slot).collect::<Vec<_>>(),
+            [0, 100, 1, 2]
+        );
+        queue.complete(first[1].0);
+        assert_eq!(queue.next(), Some((first[0].0, 3)));
+        assert!(queue.next().is_none());
+    }
+
+    #[test]
+    fn single_org_uses_full_capacity_and_empty_orgs_take_no_turns() {
+        let mut queue = FairQueue::new(3);
+        queue.push("empty", []);
+        queue.push("a", 0..6);
+        let first = (0..3).map(|_| queue.next().unwrap()).collect::<Vec<_>>();
+        assert_eq!(
+            first.iter().map(|(_, slot)| *slot).collect::<Vec<_>>(),
+            [0, 1, 2]
+        );
+        assert!(queue.next().is_none());
+        for (org, _) in first {
+            queue.complete(org);
+        }
+        for expected in 3..6 {
+            let (org, slot) = queue.next().unwrap();
+            assert_eq!(slot, expected);
+            queue.complete(org);
+        }
+        assert!(queue.next().is_none());
+    }
+}
