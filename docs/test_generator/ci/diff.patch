+
+describe("ReportRunNowDialog", () => {
+  beforeEach(() => {
+    push.mockClear();
+    vi.mocked(toast).mockClear();
+    vi.mocked(reports.triggerReportById).mockClear();
+    vi.mocked(reports.getReportById).mockResolvedValue({
+      data: { destinations: [{ email: "lin@acme.io" }, { email: "cfo@acme.io" }] },
+    } as any);
+  });
+
