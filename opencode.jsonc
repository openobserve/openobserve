{
  // OpenCode configuration for the PR review engine (scripts/ai-review). The workflow passes this
  // file from the trusted base-branch checkout via OPENCODE_CONFIG and disables project config, so
  // a PR cannot change it for its own review. Docs: https://opencode.ai/docs/
  "$schema": "https://opencode.ai/config.json",

  // Nothing here may reach into the PR tree: no `instructions`, no `skills.paths`, no plugins.
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  // LSP servers would build the PR (rust-analyzer runs build scripts and proc macros).
  "lsp": false,
  "formatter": false,

  "provider": {
    "deepseek-review": {
      // Bundled in the opencode binary at this exact name; a versioned name would trigger an npm install.
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (review)",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": { "context": 1048576, "output": 262144 },
          // USD per 1M tokens at peak rate; models fetch is disabled, so without this every cost reads 0.
          "cost": { "input": 1.32, "output": 3.96, "cache_read": 0.044 }
        }
      }
    }
  },

  "model": "deepseek-review/deepseek-v4-pro",

  // Every ai-review-* agent gets the same ruleset. Rules are ordered and the last match wins, so
  // "*": "deny" first and the three read-only tools after it. The startup self-check in
  // scripts/ai-review/src/opencode.mjs refuses to run if any other tool resolves to allow.
  "agent": {
    "ai-review-security": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-code-quality": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-performance": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-documentation": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-release": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-frontend": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-qa": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-coordinator": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-v4-pro",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    }
  }
}
