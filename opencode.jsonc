{
  // Loaded from the trusted base-branch checkout via OPENCODE_CONFIG, so a PR cannot change its own review.
  "$schema": "https://opencode.ai/config.json",

  // Nothing here may reach into the PR tree: no `instructions`, no `skills.paths`, no plugins.
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  // LSP servers would build the PR (rust-analyzer runs build scripts and proc macros).
  "lsp": false,
  "formatter": false,

  "provider": {
    "deepseek-review": {
      // Bundled in the opencode binary at this exact name; a versioned name would trigger an npm install.
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (review)",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4.1-Flash",
          // Max reasoning effort for every agent; opencode sends it as "reasoning_effort": "max".
          "options": { "reasoningEffort": "max" },
          "limit": { "context": 1048576, "output": 262144 },
          // USD per 1M tokens at peak rate; models fetch is disabled, so without this every cost reads 0.
          // TODO: these are still the V4-Pro rates; replace them with the Flash price list.
          "cost": { "input": 1.32, "output": 3.96, "cache_read": 0.044 }
        }
      }
    }
  },

  "model": "deepseek-review/deepseek-flash",

  // Last match wins, so "*": "deny" must come first; src/opencode.mjs selfCheck refuses any other allowed tool.
  "agent": {
    "ai-review-security": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-code-quality": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-performance": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-documentation": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-release": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-frontend": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-qa": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    },
    "ai-review-coordinator": {
      "mode": "primary",
      "model": "deepseek-review/deepseek-flash",
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow", "external_directory": "deny" }
    }
  }
}
