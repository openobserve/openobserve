# OpenObserve instance the suite QUERIES (Search API + dashboard UI login). Fill in your own.
OO_URL=https://your-openobserve-host.example.com
OO_ORG=your_org_id

# Credentials for the OpenObserve Search API + dashboard UI login (fill in your own).
OO_USER=you@openobserve.ai
# QUOTE the password if it contains '#' (dotenv treats unquoted # as a comment)
OO_PASS="changeme"

# The React Native app under test
RN_ANDROID_APP_ID=com.o2rumtester
RN_SERVICE=o2-rum-tester
RN_ENV=production

# NOTE: the APPS ingest via their own build-time config (committed defaults are PLACEHOLDERS).
# Set the RUM target before building the apps — export these, or edit each app's config:
#   O2_RUM_HOST / O2_RUM_ORG / O2_RUM_TOKEN / O2_RUM_ENV
#   RN:            apps/o2-rum-tester/App.tsx  (@gen:* consts)
#   android-native apps/o2-native-android/app/build.gradle.kts (OO_* defaults)
#   ios-native     apps/o2-native-ios/Sources/GeneratedConfig.swift  (run gen-config.sh)
# Get the RUM token from your org's RUM install page (Data > RUM) or "Reset RUM Token".
