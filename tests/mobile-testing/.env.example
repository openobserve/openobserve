# OpenObserve instance the suite QUERIES (Search API + dashboard UI login).
# New stable env (introspect). Org = vamsi_org.
OO_URL=https://o2.introspect.internal.zinclabs.dev
OO_ORG=3H4eDirnysdrcO60XNNKT1wJyQs

# Credentials for the OpenObserve Search API + dashboard UI login (fill in your own).
OO_USER=you@openobserve.ai
# QUOTE the password if it contains '#' (dotenv treats unquoted # as a comment)
OO_PASS="changeme"

# The React Native app under test
RN_ANDROID_APP_ID=com.o2rumtester
RN_SERVICE=o2-rum-tester
RN_ENV=production

# NOTE: the APPS ingest to a DIFFERENT host — https://api.introspect.internal.zinclabs.dev
# (baked into each app's config). Set the vamsi_org RUM token before building the apps:
#   RN:            apps/o2-rum-tester/App.tsx  (@gen:token)  — or export O2_RUM_TOKEN
#   android-native apps/o2-native-android/app/build.gradle.kts (OO_TOKEN default) — or O2_RUM_TOKEN
#   ios-native     apps/o2-native-ios/Sources/GeneratedConfig.swift (token) — or O2_RUM_TOKEN + gen-config.sh
# Get vamsi_org's token from its RUM install page (Data > RUM) or "Reset RUM Token".
