    "tests/ui-testing/fixtures/**",
    "tests/ui-testing/playwright.config.js",
    "tests/ui-testing/package.json",
    "tests/ui-testing/package-lock.json",
    "tests/ui-testing/env.sh",
    "web/src/plugins/index.ts",
    "tests/test-data/**"
  ],
  "ignore_paths": [
