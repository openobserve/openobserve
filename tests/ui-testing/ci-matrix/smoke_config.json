    "web/src/stores/**",
    "web/src/router/**",
    "web/src/layouts/**",
    "web/src/styles/**",
    "web/src/utils/**",
    "web/src/lib/**",
    "web/src/constants/**",
    "web/src/locales/languages/en-US.json",
    "web/src/locales/*",
    "web/src/services/http.*",
    "web/src/services/common.*",
    "web/src/services/config.*",
    "web/src/services/index.*",
    "web/src/services/search.*",
    "web/src/services/streaming_search.*",
    "web/src/App.vue",
    "web/src/main.ts",
    "web/package.json",
    "web/package-lock.json",
    "web/index.html",
    "web/vite.config.*",
    "web/postcss.config.*",
    "web/tsconfig*",
    ".github/workflows/playwright.yml",
    ".github/scripts/build-ci-matrix.js",
    "tests/ui-testing/ci-matrix/**",
    "tests/ui-testing/pages/page-manager.js",
