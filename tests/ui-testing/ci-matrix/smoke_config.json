{
  "_comment": "PR smoke selection config for build-ci-matrix.js --select-for-changes. global_paths force the FULL matrix on the PR (shared frontend code, deps, and the smoke machinery itself); ignore_paths are files that cannot affect the app; a changed file matching neither list nor any shard's paths pulls in core_shards — one representative shard per major surface — because merge_group always runs the full matrix before anything lands. always_run shards are appended to every smoke selection as a cheap canary. Selection never emits zero shards.",
  "always_ignore_paths": [
    "web/src/**/*.spec.ts",
    "web/src/**/*.spec.js",
    "web/src/**/*.test.ts",
    "web/src/**/__snapshots__/**",
    "web/src/test/**"
  ],
  "global_paths": [
    "web/src/components/*",
    "web/src/components/common/**",
    "web/src/components/shared/**",
    "web/src/composables/**",
    "web/src/stores/**",
    "web/src/router/**",
    "web/src/layouts/**",
    "web/src/boot/**",
    "web/src/styles/**",
    "web/src/utils/**",
    "web/src/lib/**",
    "web/src/constants/**",
    "web/src/locales/languages/en-US.json",
    "web/src/locales/*",
    "web/src/services/http.*",
    "web/src/services/common.*",
    "web/src/services/config.*",
    "web/src/services/index.*",
    "web/src/App.vue",
    "web/src/main.ts",
    "web/package.json",
    "web/package-lock.json",
    "web/index.html",
    "web/vite.config.*",
    "web/tailwind.config.*",
    "web/postcss.config.*",
    "web/tsconfig*",
    ".github/workflows/playwright.yml",
    ".github/scripts/build-ci-matrix.js",
    "tests/ui-testing/ci-matrix/**"
  ],
  "ignore_paths": [
    "**/*.md",
    "docs/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.svg",
    "**/*.webp",
    ".github/**",
    ".gitignore",
    "web/src/locales/languages/*.json",
    "tests/api-testing/**",
    "tests/mobile-testing/**",
    "scripts/translations/**"
  ],
  "core_shards": [
    "Alerts",
    "Dashboards-Core",
    "Logs-Core",
    "Metrics",
    "Traces",
    "Pipelines",
    "GeneralTests",
    "Streams"
  ],
  "always_run": ["Logs-SelectStar"]
}
